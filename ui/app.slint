    callback set-midi-folder(string);
    callback export-midi();

    // Expose only the controls the selected mode uses, labelled for that mode; `GenParams` still
    // carries every field.
    pure function shows-param(mode: int, key: int) -> bool {
        if (key == 5) { // osc phase: only modes that actually consume it
            if (mode >= 19 && mode <= 27) { return true; }
            return mode == 0 || mode == 1 || mode == 2 || mode == 4 || mode == 7 || mode == 9 || mode == 10 || mode == 11 || mode == 12 || mode == 17 || mode == 18;
        }
        if (key == 6) { return mode == 9 || mode == 8; }        // osc cycles: Oscillator, Markov
        if (key == 7) { return mode == 7 || mode == 11 || mode == 29; } // CA rule: Cellular, Sieve, Life
        // symmetry selects the Cellular/Life initial state and the L-system grammar family.
        if (key == 11) { return mode == 7 || mode == 10 || mode == 29; }
        return true;
    }
    pure function symmetry-label(mode: int) -> string {
        if (mode == 7) { return "Initial state"; }
        if (mode == 10) { return "Grammar"; }
        return "Symmetry";
    }
    pure function symmetry-text(mode: int, value: float) -> string {
        let v = Math.round(value);
        if (mode == 7) {
            if (v == 1) { return "Centre"; }
            if (v == 2) { return "Stripes"; }
            if (v == 3) { return "Solid + gap"; }
            return "Random";
        }
        if (mode == 10) {
            if (v == 1) { return "Family A"; }
            if (v == 2) { return "Family B"; }
            if (v == 3) { return "Family C"; }
            if (v == 5) { return "Family D"; }
            return "Auto";
        }
        return "\{v}";
    }
    pure function steps-max(mode: int) -> float {
        // Short, closed-form modes do not benefit from four-digit step counts.
        if (mode == 0 || mode == 6) { return 128; }
        if (mode >= 14 && mode <= 18) { return 64; }
        if (mode == 1 || mode == 3 || mode == 12 || mode == 19 || mode == 20 || mode == 27 || mode == 28) { return 256; }
        return root.max-steps;
    }
    pure function pulses-max(mode: int) -> float {
        if (mode == 5) { return 3; }     // Mozart dice per bar
        if (mode == 7) { return 15; }    // cellular generation
        if (mode == 11) { return 2; }    // sieve union terms
        if (mode == 17) { return 16; }   // acid motif length
        if (mode == 25 || mode == 26) { return 4; } // chord tones
        if (mode == 27) { return 5; }    // Hilbert order
        if (mode == 29) { return 64; }   // Life warm-up generations
        return root.cells;
    }
    pure function pulse-label(mode: int) -> string {
        if (mode == 1) { return "Ruler order"; }
        if (mode == 2) { return "Target hits"; }
        if (mode == 3) { return "Degree"; }
        if (mode == 4) { return "Requested hits"; }
        if (mode == 5) { return "Dice per bar"; }
        if (mode == 6) { return "Triad span"; }
        if (mode == 7) { return "Generation"; }
        if (mode == 8) { return "Walk activity"; }
        if (mode == 9) { return "Requested hits"; }
        if (mode == 10) { return "Grammar cutoff"; }
        if (mode == 11) { return "Sieve terms"; }
        if (mode == 12) { return "Slope"; }
        if (mode == 13) { return "Onset chance"; }
        if (mode == 14) { return "Notes"; }
        if (mode == 15) { return "Notes"; }
        if (mode == 16) { return "Notes"; }
        if (mode == 17) { return "Motif length"; }
        if (mode == 18) { return "Register bits"; }
        if (mode == 19 || mode == 20 || mode == 21 || mode == 22 || mode == 23 || mode == 24 || mode == 28) { return "Target hits"; }
        if (mode == 25 || mode == 26) { return "Chord tones"; }
        if (mode == 27) { return "Order"; }
        if (mode == 29) { return "Warm-up"; }
        return "Pulses";
    }
    pure function density-label(mode: int) -> string {
        if (mode == 2) { return "Growth (r)"; }
        if (mode == 8) { return "Leapiness"; }
        if (mode == 13) { return "Onset chance"; }
        if (mode == 14 || mode == 15) { return "Root bias"; }
        if (mode == 16) { return "Leapiness"; }
        if (mode == 21) { return "Step size"; }
        if (mode == 22) { return "Tail weight"; }
        if (mode == 23) { return "Map μ"; }
        if (mode == 24) { return "Chaos a"; }
        if (mode == 25 || mode == 27) { return "Gate"; }
        if (mode == 26) { return "Approach"; }
        if (mode == 29) { return "Cell density"; }
        return "Density";
    }
    pure function phase-label(mode: int) -> string {
        if (mode == 4) { return "Coupling"; }
        if (mode == 8) { return "Step/leap"; }
        if (mode == 17) { return "Mutation"; }
        if (mode == 18) { return "Register flip"; }
        if (mode == 19 || mode == 20) { return "Run offset"; }
        if (mode == 21 || mode == 22) { return "Drift"; }
        if (mode == 23 || mode == 24) { return "Initial x"; }
        if (mode == 25 || mode == 26) { return "Direction"; }
        if (mode == 27) { return "Rotation"; }
        return "Osc phase";
    }
    pure function osc-label(mode: int) -> string {
        if (mode == 8) { return "Leap bias"; }
        return "Osc cycles";
    }
    pure function ca-label(mode: int) -> string {
        if (mode == 11) { return "Sieve moduli"; }
        if (mode == 29) { return "Rule"; }
        return "CA rule";
    }
    pure function life-rule-name(value: float) -> string {
        let r = Math.mod(Math.round(value), 5);
        if (r == 1) { return "HighLife"; }
        if (r == 2) { return "Seeds"; }
        if (r == 3) { return "Day & Night"; }
        if (r == 4) { return "Dense"; }
        return "Life";
    }
    pure function regen-label(mode: int) -> string {
        return "Regenerate after (lengths, 0=off)";
    }
    property <[string]> mode-names: [
        "Euclidean", "Golomb Ruler", "Logistic Map", "Eulerian Walk", "Arnold Circle Map",
        "Mozart Dice", "Tonnetz Walk", "Cellular Automaton", "Markov Walk", "Oscillator / Phase",
        "L-System Grammar", "Xenakis Sieve", "Fibonacci / Sturmian", "Bernoulli",
        "Acid Random", "Acid Euclid", "Acid Markov", "Acid Motif", "Acid Shift Register",
        "Thue-Morse", "Rudin-Shapiro", "Brownian Walk", "Lévy Flight", "Tent Map",
        "Hénon Map", "Arpeggiator", "Walking Bass", "Hilbert Curve", "Ulam Spiral Primes",
        "Life-like CA"
    ];
    property <[string]> mode-help: [
        "Places pulses as evenly as possible around the step ring, then walks the pitch contour by 1/φ per onset. Density thins the onsets; Seed and Phase move the whole necklace.",
        "Maps the marks of an optimal Golomb ruler onto the bar, so no inter-onset interval repeats. Gap length sets the pitch step, which gives the phrase its wide, non-metrical leaps.",
        "Iterates x[n+1] = r·x[n]·(1−x[n]) with r set by density. The highest orbit samples become onsets, but the pitch reads a delayed orbit value so peaks do not all become high notes.",
        "Builds a balanced digraph over a rest plus seven scale degrees, then walks every edge once with Hierholzer's algorithm. The circuit becomes a melody line; unused vertices read as rests.",
        "Runs the Arnold circle map θ' = θ + Ω − K/2π·sin(2πθ). Pure rotation gives a steady pulse; increasing coupling locks it into a repeating figure. The pitch follows the phase.",
        "Rolls one to three dice per bar and indexes a bank of eleven one-bar cells, Mozart-style. Each cell carries both a rhythm and a melodic shape.",
        "Walks P/L/R neo-Riemannian transforms on a Tonnetz lattice and arpeggiates each triad. The panel draws the triangles, so the harmonic path is visible while it plays.",
        "Runs Wolfram's Rule 30 on a ring, one row per generation. The selected generation becomes the rhythm and the neighbourhood sum becomes the pitch contour.",
        "A first-order Markov walk over rest and seven scale degrees. Density sets note activity and the oscillator knob sets leapiness; the panel draws the degree graph.",
        "Samples one of eight waveforms at each step. The waveform supplies the pitch contour while the requested hits are placed as a Euclidean rhythm, so the drawn curve is the melody's shape without clustering every onset at a peak.",
        "Rewrites a two-symbol grammar for up to twelve generations and reads the resulting word as contour and rhythm. A favours rising steps, B favours falling ones.",
        "Builds a Xenakis sieve M = (m₁,r₁) ∪ (m₂,r₂) \\ (m₃,r₃). Members become onsets; the residue class decides the pitch degree. Density keeps a fraction of the members.",
        "Generates a Sturmian word from an irrational slope and fires where floor((i+1)α) changes. The result is maximally even and the contour steps by the golden ratio.",
        "Flips an independent Bernoulli coin per step. Density is the onset probability and each onset gets a seeded pitch class, so the line is unstable by design.",
        "Picks exactly Pulses notes with a downbeat bias, then rolls a root-heavy scale degree for each. Accent, Slide and Octave are independent per-note flags.",
        "Notes are a Euclidean rhythm; accents, slides and octave jumps are nested Euclidean rhythms over those notes. Knobs only add or remove flags, never reshuffle the line.",
        "A two-state note/rest chain with the requested stationary density, plus a first-order pitch chain. Slides are more likely between close degrees.",
        "Rolls one short motif and repeats it. Phase mutates later repeats by flipping notes, re-pitching them or shifting an octave.",
        "A Turing-machine shift register feeds rhythm, scale degree, accent, slide and octave from separate bit fields. Phase controls how often the feedback bit flips.",
        "Thue-Morse: t(n) is the parity of the bits in n. Ones are candidates for onsets, the current run length shapes the contour, and Phase shifts the word.",
        "Rudin-Shapiro: the parity of overlapping 11 pairs in the binary index. Ones become onsets; run lengths and the index shape the contour.",
        "A reflected random walk. Density sets the step size, Phase adds drift, and the largest moves become onsets while the walk itself is the pitch contour.",
        "A reflected Lévy flight: mostly small steps with heavy-tailed jumps. Density controls how heavy the tail is; jumps are the onsets.",
        "The tent map x' = μ·min(x,1−x). Density raises μ toward chaos, Phase sets the initial x, and the orbit is the contour; pitch reads a delayed orbit value so peaks and notes are independent.",
        "The Hénon map x' = 1 − a·x² + y, y' = b·x, clamped to a safe box. Density sets a, Phase and Seed set the initial point; move size picks onsets and y is the pitch, so the attractor drives two independent readings.",
        "A one-note arpeggiator over scale degrees 1-3-5-7, so it follows the selected scale and tuning. Pulses chooses the chord size, Phase picks up/down/up-down/random and Density gates the steps.",
        "A walking bass over a dominant-seven chord: chord tones on strong steps and chromatic approach notes between them. Pulses is the chord size, Density the approach chance.",
        "Samples a Hilbert space-filling curve of order Pulses. The curve is the contour and the left-hand panel draws the 2-D path; Phase rotates it by quarter turns.",
        "Walks the Ulam square spiral and marks cells whose 1-based index is prime; the centre always sounds. Density thins the prime hits and the panel draws the spiral.",
        "Runs a Life-like cellular automaton on a 16×8 torus. Warm-up gives the population time to develop, Rule selects Life/HighLife/Seeds/Day & Night/Dense, and Symmetry picks the seed shape. Each step reads one column, so live rows become a scale degree and population drives accent."
    ];
    // `text` is the strip label, `number` the display value, `scale` converts back to parameter units.
    property <[Opt]> opts: [
        { label: "Steps", min: 1, max: Math.min(root.max-steps, root.steps-max(root.mode)), value: Math.min(root.steps, Math.min(root.max-steps, root.steps-max(root.mode))), text: root.round-steps ? "\{Math.round(Math.min(root.steps, root.steps-max(root.mode)))}" : "\{Math.round(Math.min(root.steps, root.steps-max(root.mode)) * 1000) / 1000}", step: root.round-steps ? 1 : 0.01, number: root.round-steps ? "\{Math.round(Math.min(root.steps, root.steps-max(root.mode)))}" : "\{Math.round(Math.min(root.steps, root.steps-max(root.mode)) * 1000) / 1000}", scale: 1 },
        { label: root.pulse-label(root.mode), min: 0, max: root.pulses-max(root.mode), value: Math.min(root.pulses, root.pulses-max(root.mode)), text: "\{Math.round(Math.min(root.pulses, root.pulses-max(root.mode)))}", step: 1, number: "\{Math.round(Math.min(root.pulses, root.pulses-max(root.mode)))}", scale: 1 },
        { label: "Rotate", min: 0, max: Math.max(root.cells - 1, 0), value: Math.min(root.rotate, Math.max(root.cells - 1, 0)), text: "\{Math.round(Math.min(root.rotate, Math.max(root.cells - 1, 0)))}", step: 1, number: "\{Math.round(Math.min(root.rotate, Math.max(root.cells - 1, 0)))}", scale: 1 },
        { label: root.density-label(root.mode), min: 0, max: 1, value: root.density, text: "\{Math.round(root.density * 100)}%", step: 0.01, number: "\{Math.round(root.density * 100)}", scale: 0.01 },
        { label: "Seed", min: 0, max: 1, value: root.seed, text: "\{Math.round(root.seed * 1000) / 1000}", step: 0.001, number: "\{Math.round(root.seed * 1000) / 1000}", scale: 1 },
        { label: root.phase-label(root.mode), min: 0, max: 1, value: root.phase, text: "\{Math.round(root.phase * 360)}°", step: 0.01, number: "\{Math.round(root.phase * 360)}", scale: 1.0 / 360.0 },
        { label: root.osc-label(root.mode), min: root.mode == 16 ? 1 : 0.125, max: root.mode == 16 ? 16 : 8, value: root.mode == 16 ? Math.max(root.osc-rate, 1) : root.osc-rate, text: root.mode == 16 ? "\{Math.round(Math.max(root.osc-rate, 1))}" : "\{Math.round(root.osc-rate * 100) / 100}", step: root.mode == 16 ? 1 : 0.125, number: root.mode == 16 ? "\{Math.round(Math.max(root.osc-rate, 1))}" : "\{Math.round(root.osc-rate * 100) / 100}", scale: 1 },
        { label: root.ca-label(root.mode), min: 0, max: 255, value: root.ca-rule, text: root.mode == 29 ? root.life-rule-name(root.ca-rule) : (root.mode == 16 ? "\{Math.round(root.ca-rule / 255 * 100)}%" : "\{Math.round(root.ca-rule)}"), step: 1, number: root.mode == 16 ? "\{Math.round(root.ca-rule / 255 * 100)}" : "\{Math.round(root.ca-rule)}", scale: root.mode == 16 ? 2.55 : 1 },
        { label: "Probability", min: 0, max: 1, value: root.probability, text: "\{Math.round(root.probability * 100)}%", step: 0.01, number: "\{Math.round(root.probability * 100)}", scale: 0.01 },
        { label: "Velocity", min: 0.01, max: 1, value: root.velocity, text: "\{Math.round(root.velocity * 100)}%", step: 0.01, number: "\{Math.round(root.velocity * 100)}", scale: 0.01 },
        { label: root.regen-label(root.mode), min: 0, max: 256, value: root.regenerate-every, text: "\{Math.round(root.regenerate-every)}", step: 1, number: "\{Math.round(root.regenerate-every)}", scale: 1 },
        { label: root.symmetry-label(root.mode), min: 1, max: 8, value: root.symmetry, text: root.symmetry-text(root.mode, root.symmetry), step: 1, number: "\{Math.round(root.symmetry)}", scale: 1 },
        { label: "Randomize after lengths", min: 0, max: 256, value: root.randomize-after-lengths, text: "\{Math.round(root.randomize-after-lengths)}", step: 1, number: "\{Math.round(root.randomize-after-lengths)}", scale: 1 },
        { label: "Swing", min: 0, max: 0.5, value: root.swing, text: "\{Math.round(root.swing * 300)}%", step: 0.01, number: "\{Math.round(root.swing * 300)}", scale: 1.0 / 300.0 },
        // Index 14 is the max-steps box in Settings, not a slider.
        { label: "Max steps", min: 64, max: 1024, value: root.max-steps, text: "\{Math.round(root.max-steps)}", step: 1, number: "\{Math.round(root.max-steps)}", scale: 1 },
        { label: "Slide", min: 0, max: 1, value: root.slide, text: "\{Math.round(root.slide * 100)}%", step: 0.01, number: "\{Math.round(root.slide * 100)}", scale: 0.01 },
        { label: "Accent", min: 0, max: 1, value: root.accent, text: "\{Math.round(root.accent * 100)}%", step: 0.01, number: "\{Math.round(root.accent * 100)}", scale: 0.01 },
        { label: "Octave jump", min: 0, max: 1, value: root.octave, text: "\{Math.round(root.octave * 100)}%", step: 0.01, number: "\{Math.round(root.octave * 100)}", scale: 0.01 },
        { label: "Root pitch class", min: 0, max: 11, value: root.root-pc, text: "\{root.root-pc}", step: 1, number: "\{root.root-pc}", scale: 1 },
        { label: "Octaves", min: 1, max: 6, value: root.octaves, text: "\{root.octaves}", step: 1, number: "\{root.octaves}", scale: 1 },
        { label: "Root MIDI note", min: 0, max: 120, value: root.midi-root, text: "\{root.midi-root}", step: 1, number: "\{root.midi-root}", scale: 1 },
        { label: "EDO divisions", min: 1, max: 72, value: root.edo, text: "\{root.edo}", step: 1, number: "\{root.edo}", scale: 1 },
        { label: "Root cents", min: -50, max: 50, value: root.root-cents, text: "\{Math.round(root.root-cents)}c", step: 1, number: "\{Math.round(root.root-cents)}", scale: 1 },
        { label: "History bars", min: 1, max: root.history-max-bars, value: root.history-bars, text: "\{Math.round(root.history-bars)}", step: 1, number: "\{Math.round(root.history-bars)}", scale: 1 }
    ];

    // One fixed 860x697 coordinate space; the matrix scrolls fixed-width cells, so nothing reflows.
    Rectangle {
        width: root.base-width; height: root.base-height;

        // Faint graph paper for Sketch; it sits below the layout so only gaps between cards show it.
        Rectangle {
            visible: root.theme-index == 0;
            for i in 38: Rectangle { y: (i + 1) * 20px; height: 1px; background: Theme.border.with-alpha(0.16); }
            for i in 43: Rectangle { x: (i + 1) * 20px; width: 1px; height: parent.height; background: Theme.border.with-alpha(0.16); }
        }
        // Sits behind the controls, so the pulse washes the interface background only.
        Rectangle {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            opacity: 0;
            background: @linear-gradient(135deg, Theme.c1 0%, Theme.c2 50%, Theme.c3 100%);
            states [
                pulse when root.regen-pulse: {
                    opacity: 0.16;
                    in { animate opacity { duration: 70ms; easing: ease-out; } }
                    out { animate opacity { duration: 450ms; easing: ease-in-out; } }
                }
            ]
        }
        regen-off-timer := Timer {
            interval: 120ms;
            running: false;
            triggered => { root.regen-pulse = false; }
        }
        Timer {
            interval: 4s;
            running: root.mod-status != "";
            triggered => { root.mod-status = ""; }
        }

    VerticalLayout {
        padding: 14px; spacing: 2px;
        HorizontalLayout {
            height: 34px; spacing: 6px;
            Text { text: "nelody seq"; color: Theme.text; font-family: "Consolas"; font-size: 24px; font-weight: 700; letter-spacing: 0.5px; vertical-alignment: center; }
            Text { visible: root.track-name != ""; text: "· \{root.track-name}"; color: Theme.text-muted; font-size: 10px; vertical-alignment: center; overflow: elide; }
            // Hover descriptions live in the bottom status strip, clear of the pointer.
            Rectangle { horizontal-stretch: 1; }
            Text { text: "CLOCK RATE"; color: Theme.text-muted; font-size: 9px; vertical-alignment: center; }
            rate-field := RateField {
                width: 70px; height: 25px;
                label: "";
                hint: "Click to type a rate, scroll to step, arrow for the list";
                value: root.rate < root.rate-names.length ? root.rate-names[root.rate] : "";
                stepped(d) => { root.step-rate(d); }
                submitted(s) => { root.rate-submitted(s); }
                menu-requested => { root.rate-menu-open = true; root.mode-menu-open = false; root.tuning-open = false; root.settings-open = false; }
            }
            Rectangle { width: 74px; height: 24px; border-radius: 4px; background: root.free-run ? Theme.c1.with-alpha(0.22) : Theme.control; Text { text: "free-run"; color: Theme.text; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } free-touch := TipTouch { hint: "Run the internal clock while the host transport is stopped"; clicked => { root.toggle-free-run(); } } }
            Text { text: root.free-run ? "FREE-RUN CLOCK: ON" : "SYNC: HOST TRANSPORT"; color: root.free-run ? Theme.c1 : Theme.text-muted; font-size: 9px; vertical-alignment: center; }
            Rectangle { width: 112px; height: 30px; border-radius: 5px; background: generate-touch.has-hover ? Theme.hi : Theme.control; Text { text: root.generate-on ? "RE-GENERATE ↻" : "GENERATE ↻"; color: generate-touch.has-hover ? Theme.on-accent : Theme.text; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } generate-touch := TipTouch { hint: "Create a new deterministic variation of the current line"; clicked => { root.generate-pressed(); } } }
            Rectangle { width: 112px; height: 30px; border-radius: 5px; background: randomize-touch.has-hover ? Theme.c3 : Theme.control; Text { text: "RANDOMIZE ⚄"; color: randomize-touch.has-hover ? Theme.on-accent : Theme.text; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } randomize-touch := TipTouch { hint: "Randomize the parameter groups enabled in RANDOMIZE SCOPE"; clicked => { root.randomize-pressed(); } } }
            Rectangle { width: 40px; height: 30px; border-radius: 5px; background: settings-touch.has-hover ? Theme.c2.with-alpha(0.5) : Theme.control; Text { text: "⚙"; color: settings-touch.has-hover ? Theme.on-accent : Theme.text; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; } settings-touch := TipTouch { hint: "Open settings: theme, presets, limits, export and credits"; clicked => { root.tuning-open = false; root.rate-menu-open = false; root.settings-open = !root.settings-open; if (root.settings-open) { root.matrix-open = false; } } } }
        }
        HorizontalLayout {
            // 300px fits the description and live math line without squeezing the sliders.
            height: 300px; spacing: 10px;
            ModePanel { nodes: root.view-nodes; edges: root.view-edges; fills: root.view-fills; solid: root.view-solid; slid: root.view-slid; jumped: root.view-jumped; lines: root.view-lines; hand: root.view-hand; }
            VerticalLayout {
                vertical-stretch: 1;
                spacing: 3px; alignment: stretch;
                Rectangle {
                    height: 30px; border-radius: 4px;
                    background: mode-menu-touch.has-hover ? Theme.control-hover : Theme.control;
                    HorizontalLayout {
                        x: 8px; width: parent.width - 16px; height: parent.height; spacing: 6px;
                        Text { text: "MODE  ·  \{root.mode-names[root.mode]}"; color: Theme.c1; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: "▾"; color: Theme.c1; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                    }
                    mode-menu-touch := TipTouch {
                        hint: "Open the grouped generator list; scroll the header to step modes";
                        clicked => { root.tuning-open = false; root.rate-menu-open = false; root.settings-open = false; root.mode-menu-open = !root.mode-menu-open; }
                        // Hovering the mode header and scrolling steps the list; the open list scrolls.
                        scroll-event(e) => {
                            if (e.delta-y != 0px) {
                                root.step-mode(e.delta-y > 0px ? 1 : -1);
                                accept
                            } else {
                                reject
                            }
                        }
                    }
                }
                Text { text: root.mode-help[root.mode]; color: Theme.text; font-size: 13px; wrap: word-wrap; }
                // The live generator formula sits between the prose description and the controls.
                Text { height: 16px; text: root.mode-math; color: Theme.text-muted; font-size: 11px; font-italic: true; vertical-alignment: center; overflow: elide; }
                Rectangle { height: 4px; }
                HorizontalLayout { spacing: 5px;
                    OptSlider { opt: root.opts[0]; index: 0; mod-target: 0; changed(v) => { root.set-opt(0, v); } }
                    if root.shows-param(root.mode, 1): OptSlider { opt: root.opts[1]; index: 1; mod-target: 1; changed(v) => { root.set-opt(1, v); } }
                    OptSlider { opt: root.opts[2]; index: 2; mod-target: 2; changed(v) => { root.set-opt(2, v); } }
                    OptSlider { opt: root.opts[3]; index: 3; mod-target: 3; changed(v) => { root.set-opt(3, v); } }
                }
                HorizontalLayout {
                    spacing: 5px;
                    OptSlider { opt: root.opts[4]; index: 4; mod-target: 4; changed(v) => { root.set-opt(4, v); } }
                    if root.shows-param(root.mode, 5): OptSlider { opt: root.opts[5]; index: 5; mod-target: 5; changed(v) => { root.set-opt(5, v); } }
                    if root.shows-param(root.mode, 6): OptSlider { opt: root.opts[6]; index: 6; mod-target: 6; changed(v) => { root.set-opt(6, v); } }
                    if root.shows-param(root.mode, 7): OptSlider { opt: root.opts[7]; index: 7; mod-target: 7; changed(v) => { root.set-opt(7, v); } }
                }
                HorizontalLayout { spacing: 5px;
                    OptSlider { opt: root.opts[8]; index: 8; mod-target: 8; changed(v) => { root.set-opt(8, v); } }
                    // Feel row: velocity, gate and swing share the space beside probability.
                    OptSlider { width: 100px; opt: root.opts[9]; index: 9; mod-target: 11; changed(v) => { root.set-opt(9, v); } }
                    OptSlider {
                        width: 82px; index: 40; mod-target: 10;
                        opt: { label: "Gate", min: 0.02, max: 1, value: root.gate, text: "\{Math.round(root.gate * 100)}%", step: 0.01, number: "\{Math.round(root.gate * 100)}", scale: 0.01 };
                        changed(v) => { root.set-opt(24, v); }
                    }
                    OptSlider { width: 100px; opt: root.opts[13]; index: 13; mod-target: 9; changed(v) => { root.set-opt(13, v); } }
                }
                if root.mode == 9: HorizontalLayout {
                    WavePicker {
                        width: 126px;
                        paths: root.wave-paths; names: root.wave-names; current: root.osc-wave;
                        selected(i) => { root.set-osc-wave(i); }
                        opened(x, y) => { root.wave-menu-target = 0; root.wave-menu-x = x; root.wave-menu-y = y; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                // Markov transition bias packs four 2-bit fields: rest, repeat, role and novelty.
                if root.mode == 8: HorizontalLayout {
                    height: 25px; spacing: 5px;
                    OptSlider {
                        width: 170px; index: 41;
                        hint: "Markov bias: rest, repeat, role-compatible movement and novelty (2 bits each)";
                        opt: { label: "Transition bias", min: 0, max: 255, value: root.markov-bias, text: "\{Math.round(root.markov-bias)}", step: 1, number: "\{Math.round(root.markov-bias)}", scale: 1 };
                        changed(v) => { root.set-markov-bias(v); }
                    }
                    Text { horizontal-stretch: 1; text: "rest · repeat · role · novelty (2 bits each)"; color: Theme.text-muted; font-size: 8px; vertical-alignment: center; overflow: elide; }
                }
                // Acid controls stay in the generator column, below the shared option rows.
                if root.mode >= 14: Rectangle { height: 4px; }
                if root.mode >= 14: HorizontalLayout {
                    height: 28px; spacing: 5px;
                    Text { text: "ACID"; color: Theme.text-muted; font-size: 10px; vertical-alignment: center; }
                    OptSlider { horizontal-stretch: 1; opt: root.opts[15]; index: 15; mod-target: 14; changed(v) => { root.set-opt(15, v); } }
                    OptSlider { horizontal-stretch: 1; opt: root.opts[16]; index: 16; mod-target: 15; changed(v) => { root.set-opt(16, v); } }
                    OptSlider { horizontal-stretch: 1; opt: root.opts[17]; index: 17; mod-target: 16; changed(v) => { root.set-opt(17, v); } }
                }
                // Tuning follows the acid row inside the parameter column, above the MIDI history.
                // The stretch spacer keeps the tuning block against the history card.
                Rectangle { vertical-stretch: 1; }
                Text {
                    height: 12px; text: "TUNING"; color: Theme.text-muted;
                    font-size: 10px; vertical-alignment: center;
                }
                // Root, Scale, Octave and NTS share one equal-width row; EDO joins it only for
                // Equal (EDO), so a five-control tuning block still fits the fixed 300px column.
                HorizontalLayout {
                    height: 28px; spacing: 5px;
                    tuning-root := NumBox { horizontal-stretch: 1; height: 28px; label: "ROOT"; hint: "Root pitch class, 0 = C"; value: root.root-pc; minimum: 0; maximum: 11; step: 1; mod-target: 17; changed(v) => { root.set-opt(18, v); } }
                    // The chip shows the current scale and opens a dropdown under itself.
                    scale-chip := TuningChip { horizontal-stretch: 1; label: "SCALE"; hint: "Choose a scale or tuning table"; value: root.tuning-name + "  ▾"; centered: true; active: root.tuning-open; wheel-cycles: false; cycled => { root.tuning-open = !root.tuning-open; root.rate-menu-open = false; root.settings-open = false; root.mode-menu-open = false; } }
                    // EDO applies to Equal (EDO) only. It sits beside the scale chip and collapses
                    // to zero width when inactive, so `text-focused` can still see its editor.
                    edo-row := NumBox {
                        visible: root.edo-active;
                        horizontal-stretch: 1; min-width: 0px;
                        max-width: root.edo-active ? 1000px : 0px;
                        height: 28px; label: "EDO"; hint: "Equal divisions per octave, used by the Equal (EDO) table"; value: root.edo;
                        minimum: 1; maximum: 72; step: 1; mod-target: 20;
                        changed(v) => { root.set-opt(21, v); }
                    }
                    tuning-oct := NumBox { horizontal-stretch: 1; height: 28px; label: "OCT"; hint: "Octave span used by the generator"; value: root.octaves; minimum: 1; maximum: 6; step: 1; mod-target: 18; changed(v) => { root.set-opt(19, v); } }
                    TuningChip { horizontal-stretch: 1; label: "NTS"; hint: "Send non-12-TET pitch as MIDI pitch bend"; value: root.nts-on ? "BEND" : "OFF"; active: root.nts-on; cycled => { root.toggle-nts(); } }
                }
            }
        }
        Rectangle {
            height: 187px; vertical-stretch: 1; border-radius: 4px;
            background: Theme.surface; border-width: 1px; border-color: Theme.border;
            clip: true;
            Path { x: 58px; y: 0px; width: parent.width - 62px; height: parent.height; viewbox-x: root.history-vb-x; viewbox-y: root.history-vb-y; viewbox-width: root.history-vb-w; viewbox-height: root.history-vb-h; commands: root.history-bg; fill: Theme.cell-off.with-alpha(0.55); }
            Path { x: 58px; y: 0px; width: parent.width - 62px; height: parent.height; viewbox-x: root.history-vb-x; viewbox-y: root.history-vb-y; viewbox-width: root.history-vb-w; viewbox-height: root.history-vb-h; commands: root.history-bg-bars; fill: Theme.hi.with-alpha(0.055); }
            Path { x: 58px; y: 0px; width: parent.width - 62px; height: parent.height; viewbox-x: root.history-vb-x; viewbox-y: root.history-vb-y; viewbox-width: root.history-vb-w; viewbox-height: root.history-vb-h; commands: root.history-grid-steps; fill: transparent; stroke: Theme.text-muted.with-alpha(0.18); stroke-width: 0.5px / root.history-zoom-x; }
            Path { x: 58px; y: 0px; width: parent.width - 62px; height: parent.height; viewbox-x: root.history-vb-x; viewbox-y: root.history-vb-y; viewbox-width: root.history-vb-w; viewbox-height: root.history-vb-h; commands: root.history-grid-beats; fill: transparent; stroke: Theme.text-muted.with-alpha(0.34); stroke-width: 0.65px / root.history-zoom-x; }
            Path { x: 58px; y: 0px; width: parent.width - 62px; height: parent.height; viewbox-x: root.history-vb-x; viewbox-y: root.history-vb-y; viewbox-width: root.history-vb-w; viewbox-height: root.history-vb-h; commands: root.history-grid-bars; fill: transparent; stroke: Theme.text-muted.with-alpha(0.62); stroke-width: 0.95px / root.history-zoom-x; }
            Path { x: 58px; y: 0px; width: parent.width - 62px; height: parent.height; viewbox-x: root.history-vb-x; viewbox-y: root.history-vb-y; viewbox-width: root.history-vb-w; viewbox-height: root.history-vb-h; commands: root.history-grid; fill: transparent; stroke: Theme.text-muted.with-alpha(0.22); stroke-width: 0.6px / root.history-zoom-x; }
            // Velocity layers: width = gate/length, brightness = velocity/accent.
            Path { x: 58px; y: 0px; width: parent.width - 62px; height: parent.height; viewbox-x: root.history-vb-x; viewbox-y: root.history-vb-y; viewbox-width: root.history-vb-w; viewbox-height: root.history-vb-h; commands: root.history-notes; fill: Theme.c1.with-alpha(0.38); }
            Path { x: 58px; y: 0px; width: parent.width - 62px; height: parent.height; viewbox-x: root.history-vb-x; viewbox-y: root.history-vb-y; viewbox-width: root.history-vb-w; viewbox-height: root.history-vb-h; commands: root.history-notes-mid; fill: Theme.c1.with-alpha(0.68); }
            Path { x: 58px; y: 0px; width: parent.width - 62px; height: parent.height; viewbox-x: root.history-vb-x; viewbox-y: root.history-vb-y; viewbox-width: root.history-vb-w; viewbox-height: root.history-vb-h; commands: root.history-notes-hard; fill: Theme.c1; }
            // Outline-only so the recorded notes stay readable underneath.
            if root.history-overlay-on: Path { x: 58px; y: 0px; width: parent.width - 62px; height: parent.height; viewbox-x: root.history-vb-x; viewbox-y: root.history-vb-y; viewbox-width: root.history-vb-w; viewbox-height: root.history-vb-h; commands: root.history-pattern; fill: transparent; stroke: Theme.c3.with-alpha(0.9); stroke-width: 1px / root.history-zoom-x; }
            if root.history-overlay-on: Path { x: 58px; y: 0px; width: parent.width - 62px; height: parent.height; viewbox-x: root.history-vb-x; viewbox-y: root.history-vb-y; viewbox-width: root.history-vb-w; viewbox-height: root.history-vb-h; commands: root.history-pattern-slides; fill: transparent; stroke: Theme.c2.with-alpha(0.85); stroke-width: 1.2px / root.history-zoom-x; }
            history-touch := TipTouch {
                // Leave a 14px gutter for the vertical scrollbar: its drag must never compete
                // with the note editor, especially in NOTES/ADV edit mode.
                x: 58px; y: 0px; width: parent.width - 76px; height: parent.height;
                hint: root.edit-mode == 1
                    ? "Click a step to toggle hit; drag horizontally to set its gate"
                    : (root.edit-mode > 1
                        ? "Click a step column to apply the selected attribute"
                        : (root.history-running
                            ? "Live: the roll follows the clock automatically; press EDIT to freeze it"
                            : "Clock stopped: drag to inspect; press EDIT to change steps"));
                pointer-event(e) => {
                    let sx = history-touch.mouse-x / Math.max(history-touch.width, 1px);
                    let cx = (root.history-vb-x + sx * root.history-vb-w) / 800.0;
                    if (root.edit-mode == 1) {
                        // One mode: tap toggles the hit, a horizontal drag resizes the length.
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left && history-touch.mouse-y > 30px) {
                            root.notes-press = true;
                            root.notes-dragging = false;
                            root.notes-start-x = history-touch.mouse-x;
                            root.notes-cx = cx;
                        } else if (e.kind == PointerEventKind.move && root.notes-press) {
                            if (Math.abs(history-touch.mouse-x - root.notes-start-x) > 6px) {
                                if (!root.notes-dragging) {
                                    root.notes-dragging = true;
                                    root.history-gate-dragging = true;
                                    root.edit-gate(cx, root.gate-snap-unit(), 0);
                                } else {
                                    root.edit-gate(cx, root.gate-snap-unit(), 1);
                                }
                            }
                        } else if ((e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) && root.notes-press) {
                            if (root.notes-dragging) {
                                root.edit-gate(cx, root.gate-snap-unit(), 2);
                            } else {
                                root.edit-overlay(root.notes-cx, 1);
                            }
                            root.notes-press = false;
                            root.notes-dragging = false;
                            root.history-gate-dragging = false;
                        }
                    } else if (root.edit-mode > 1) {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left && history-touch.mouse-y > 30px) {
                            root.edit-overlay(cx, root.edit-mode);
                        }
                    } else {
                        // No edit mode: pan only while the clock is stopped. While running, the
                        // roll follows automatically and ignores horizontal drags.
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left && !root.history-running) {
                            root.history-pan-drag = true;
                            root.history-pan-axis = 1;
                            root.history-pan-start = root.history-pan-x;
                            root.history-pan-mouse = history-touch.mouse-x;
                        } else if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                            root.history-pan-drag = true;
                            root.history-pan-axis = 2;
                            root.history-pan-y-start = root.history-pan-y;
                            root.history-pan-mouse-y = history-touch.mouse-y;
                        } else if (e.kind == PointerEventKind.move && root.history-pan-drag) {
                            if (root.history-pan-axis == 1) {
                                let dx = (history-touch.mouse-x - root.history-pan-mouse) / Math.max(history-touch.width, 1px);
                                root.history-pan-x = Math.max(0.0, Math.min(1.0, root.history-pan-start + dx));
                            } else if (root.history-pan-axis == 2) {
                                let dy = (history-touch.mouse-y - root.history-pan-mouse-y) / Math.max(history-touch.height, 1px);
                                root.history-pan-y = Math.max(0.0, Math.min(1.0, root.history-pan-y-start + dy));
                            }
                        } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                            root.history-pan-drag = false;
                            root.history-pan-axis = 0;
                        }
                    }
                }
                scroll-event(e) => {
                    // Wheel scrolls vertically; Alt (or Shift) turns it into horizontal panning.
                    // Trackpads that already report delta-x pan horizontally without a modifier.
                    if ((e.modifiers.alt || e.modifiers.shift) && (e.delta-x != 0px || e.delta-y != 0px)) {
                        let d = e.delta-x != 0px ? e.delta-x : e.delta-y;
                        if (root.history-zoom-x > 1.0 && !root.history-running && root.edit-mode == 0) {
                            root.history-pan-x = Math.max(0.0, Math.min(1.0, root.history-pan-x + (d > 0px ? 0.04 : -0.04)));
                            accept
                        } else if (root.history-zoom-y > 1.0) {
                            // Horizontal panning is locked while editing; Alt+wheel should still
                            // be useful, so fall back to the vertical viewport.
                            root.history-pan-y = Math.max(0.0, Math.min(1.0, root.history-pan-y + (d < 0px ? 0.04 : -0.04)));
                            accept
                        } else {
                            reject
                        }
                    } else if (e.delta-x != 0px) {
                        if (root.history-zoom-x > 1.0 && !root.history-running && root.edit-mode == 0) {
                            root.history-pan-x = Math.max(0.0, Math.min(1.0, root.history-pan-x + (e.delta-x > 0px ? 0.04 : -0.04)));
                            accept
                        } else {
                            reject
                        }
                    } else if (e.delta-y != 0px) {
                        if (root.history-zoom-y > 1.0) {
                            root.history-pan-y = Math.max(0.0, Math.min(1.0, root.history-pan-y + (e.delta-y < 0px ? 0.04 : -0.04)));
                            accept
                        } else {
                            reject
                        }
                    } else {
                        reject
                    }
                }
            }
            // Edit toolbar sits above the roll, so it never consumes layout height.
            if root.edit-mode == 0: Rectangle {
                x: 8px; y: 8px; width: 46px; height: 20px; border-radius: 3px;
                background: edit-open-touch.has-hover ? Theme.c2.with-alpha(0.7) : Theme.control.with-alpha(0.92);
                border-width: 1px; border-color: Theme.border;
                Text { width: parent.width; height: parent.height; text: "EDIT"; color: edit-open-touch.has-hover ? Theme.on-accent : Theme.text; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
                edit-open-touch := TipTouch {
                    hint: "Tap a step to toggle a hit, drag to resize its gate; ADV shows probability, accent, ratchet and timing";
                    clicked => { root.edit-advanced = false; root.edit-mode = 1; }
                }
            }
            // Performance edits sit under the EDIT button with the same compact button design.
            Rectangle {
                x: 8px; y: 32px; width: 46px; height: 20px; border-radius: 3px;
                background: root.mirror-on ? Theme.c3.with-alpha(0.45) : (mirror-touch.has-hover ? Theme.c2.with-alpha(0.7) : Theme.control.with-alpha(0.92));
                border-width: 1px; border-color: Theme.border;
                Text { width: parent.width; height: parent.height; text: "MIRROR"; color: root.mirror-on ? Theme.on-accent : Theme.text; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
                mirror-touch := TipTouch { hint: "Mirror the finished line backwards"; clicked => { root.toggle-mirror(); } }
            }
            Rectangle {
                x: 8px; y: 56px; width: 46px; height: 20px; border-radius: 3px;
                background: root.invert-on ? Theme.c2.with-alpha(0.45) : (invert-touch.has-hover ? Theme.c2.with-alpha(0.7) : Theme.control.with-alpha(0.92));
                border-width: 1px; border-color: Theme.border;
                Text { width: parent.width; height: parent.height; text: "INVERT"; color: root.invert-on ? Theme.on-accent : Theme.text; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
                invert-touch := TipTouch { hint: "Invert every hit and rest in the finished line"; clicked => { root.toggle-invert(); } }
            }
            if root.edit-mode > 0: HorizontalLayout {
                x: 8px; y: 6px; height: 22px; spacing: 3px;
                Rectangle {
                    width: 44px; height: 20px; border-radius: 3px;
                    background: root.edit-mode == 1 ? Theme.c1.with-alpha(0.8) : Theme.control.with-alpha(0.92);
                    Text { width: parent.width; height: parent.height; text: "NOTES"; color: root.edit-mode == 1 ? Theme.on-accent : Theme.text; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
                    notes-edit := TipTouch { hint: "Tap to toggle a hit; drag to resize its gate"; clicked => { root.edit-mode = root.edit-mode == 1 ? 0 : 1; } }
                }
                Rectangle {
                    width: 30px; height: 20px; border-radius: 3px;
                    background: root.edit-advanced ? Theme.c2.with-alpha(0.75) : Theme.control.with-alpha(0.92);
                    Text { width: parent.width; height: parent.height; text: "ADV"; color: root.edit-advanced ? Theme.on-accent : Theme.text; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
                    adv-edit := TipTouch { hint: "Show probability, accent, ratchet, timing and clear modes"; clicked => { root.edit-advanced = !root.edit-advanced; } }
                }
                if root.edit-advanced: Rectangle {
                    width: 34px; height: 20px; border-radius: 3px;
                    background: root.edit-mode == 2 ? Theme.c2.with-alpha(0.8) : Theme.control.with-alpha(0.92);
                    Text { width: parent.width; height: parent.height; text: "PROB"; color: root.edit-mode == 2 ? Theme.on-accent : Theme.text; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
                    prob-edit := TipTouch { hint: "Cycle this step's hit probability"; clicked => { root.edit-mode = root.edit-mode == 2 ? 1 : 2; } }
                }
                if root.edit-advanced: Rectangle {
                    width: 34px; height: 20px; border-radius: 3px;
                    background: root.edit-mode == 3 ? Theme.c3.with-alpha(0.8) : Theme.control.with-alpha(0.92);
                    Text { width: parent.width; height: parent.height; text: "ACC"; color: root.edit-mode == 3 ? Theme.on-accent : Theme.text; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
                    acc-edit := TipTouch { hint: "Cycle this step's accent"; clicked => { root.edit-mode = root.edit-mode == 3 ? 1 : 3; } }
                }
                if root.edit-advanced: Rectangle {
                    width: 30px; height: 20px; border-radius: 3px;
                    background: root.edit-mode == 5 ? Theme.c1.with-alpha(0.8) : Theme.control.with-alpha(0.92);
                    Text { width: parent.width; height: parent.height; text: "RAT"; color: root.edit-mode == 5 ? Theme.on-accent : Theme.text; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
                    rat-edit := TipTouch { hint: "Cycle 1-4 ratchet substeps on this step"; clicked => { root.edit-mode = root.edit-mode == 5 ? 1 : 5; } }
                }
                if root.edit-advanced: Rectangle {
                    width: 34px; height: 20px; border-radius: 3px;
                    background: root.edit-mode == 6 ? Theme.c3.with-alpha(0.8) : Theme.control.with-alpha(0.92);
                    Text { width: parent.width; height: parent.height; text: "TIME"; color: root.edit-mode == 6 ? Theme.on-accent : Theme.text; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
                    time-edit := TipTouch { hint: "Delay this step by 0, 1/8, 1/4 or 1/2 step"; clicked => { root.edit-mode = root.edit-mode == 6 ? 1 : 6; } }
                }
                if root.edit-advanced: Rectangle {
                    width: 30px; height: 20px; border-radius: 3px;
                    background: root.edit-mode == 4 ? Theme.hi.with-alpha(0.8) : Theme.control.with-alpha(0.92);
                    Text { width: parent.width; height: parent.height; text: "CLR"; color: root.edit-mode == 4 ? Theme.on-accent : Theme.text; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
                    clr-edit := TipTouch { hint: "Clear every manual edit on this step"; clicked => { root.edit-mode = root.edit-mode == 4 ? 1 : 4; } }
                }
                Rectangle {
                    width: 40px; height: 20px; border-radius: 3px;
                    background: Theme.control.with-alpha(0.92);
                    Text { width: parent.width; height: parent.height; text: root.gate-snap-index == 0 ? "1/4" : (root.gate-snap-index == 1 ? "1/2" : (root.gate-snap-index == 2 ? "3/4" : "1")); color: Theme.text; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
                    gate-snap-edit := TipTouch { hint: "Gate snap: click to cycle 1/4, 1/2, 3/4 or 1 step"; clicked => { root.gate-snap-index = Math.mod(root.gate-snap-index + 1, 4); } }
                }
                Rectangle {
                    width: 34px; height: 20px; border-radius: 3px;
                    background: Theme.control.with-alpha(0.92);
                    Text { width: parent.width; height: parent.height; text: "UNDO"; color: Theme.text; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
                    undo-edit := TipTouch { hint: "Undo the last step edit"; clicked => { root.undo-edit(); } }
                }
                Rectangle {
                    width: 34px; height: 20px; border-radius: 3px;
                    background: Theme.control.with-alpha(0.92);
                    Text { width: parent.width; height: parent.height; text: "REDO"; color: Theme.text; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
                    redo-edit := TipTouch { hint: "Redo the last undone step edit"; clicked => { root.redo-edit(); } }
                }
                Rectangle {
                    width: 48px; height: 20px; border-radius: 3px;
                    background: Theme.control.with-alpha(0.92);
                    Text { width: parent.width; height: parent.height; text: "CLR ALL"; color: Theme.text; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
                    all-edit := TipTouch { hint: "Clear every manual step edit"; clicked => { root.clear-edits(); } }
                }
            }
            // Compact legend stays visible; hover text now lives in the bottom strip.
            if root.edit-mode == 0: Rectangle {
                x: 60px; y: 8px; width: parent.width - 190px; height: 22px;
                border-radius: 3px; background: Theme.surface.with-alpha(0.88);
                border-width: 1px; border-color: Theme.border;
                Text { x: 8px; width: parent.width - 16px; height: parent.height; text: "MIDI HISTORY  ·  right → left  ·  \{root.history-range}  ·  width = gate · bright = velocity/accent · outline = slide"; color: Theme.text-muted; font-size: 9px; vertical-alignment: center; overflow: elide; }
            }
            // Zoom / fit controls sit in the left gutter, below NOTE/MIRROR/INVERT.
            HorizontalLayout {
                x: 8px; y: parent.height - 30px; height: 20px; spacing: 3px;
                Rectangle {
                    width: 22px; height: 20px; border-radius: 3px;
                    background: zoom-out-history.has-hover ? Theme.control-hover : Theme.control.with-alpha(0.92);
                    Text { width: parent.width; height: parent.height; text: "−"; color: Theme.text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    zoom-out-history := TipTouch { hint: "Zoom the MIDI roll out"; clicked => { root.zoom-history(0.8); } }
                }
                Rectangle {
                    width: 22px; height: 20px; border-radius: 3px;
                    background: zoom-in-history.has-hover ? Theme.control-hover : Theme.control.with-alpha(0.92);
                    Text { width: parent.width; height: parent.height; text: "+"; color: Theme.text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    zoom-in-history := TipTouch { hint: "Zoom the MIDI roll in"; clicked => { root.zoom-history(1.25); } }
                }
                Rectangle {
                    width: 30px; height: 20px; border-radius: 3px;
                    background: fit-history.has-hover ? Theme.control-hover : Theme.control.with-alpha(0.92);
                    Text { width: parent.width; height: parent.height; text: "FIT"; color: Theme.text; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
                    fit-history := TipTouch { hint: "Fit the whole history window"; clicked => { root.fit-history(); } }
                }
            }
            // Slim scrollbars: horizontal at the bottom, vertical on the right. The tracks are
            // wider than the visible 3px bar so they are easy to grab; drag either thumb or click
            // a track position to pan the roll.
            Rectangle {
                visible: root.history-zoom-x > 1.0;
                x: 58px; y: parent.height - 5px; width: parent.width - 96px; height: 3px; border-radius: 2px;
                background: Theme.border.with-alpha(0.35);
                Rectangle {
                    property <length> thumb-w: Math.min(parent.width, parent.width / root.history-zoom-x);
                    property <length> travel: Math.max(0px, parent.width - self.thumb-w);
                    x: (root.history-running || root.history-editing) ? self.travel : self.travel * root.history-pan-x;
                    width: self.thumb-w; height: parent.height; border-radius: 2px;
                    background: Theme.c1.with-alpha(0.65);
                }
            }
            hscroll-touch := TouchArea {
                visible: root.history-zoom-x > 1.0;
                x: 58px; y: parent.height - 10px; width: parent.width - 96px; height: 12px;
                scroll-event(e) => {
                    let d = e.delta-x != 0px ? e.delta-x : e.delta-y;
                    if (d != 0px && !root.history-running && root.edit-mode == 0) {
                        root.history-pan-x = Math.max(0.0, Math.min(1.0, root.history-pan-x + (d > 0px ? 0.04 : -0.04)));
                        accept
                    } else {
                        reject
                    }
                }
                pointer-event(e) => {
                    let track-w = Math.max(1px, hscroll-touch.width);
                    let thumb-w = Math.min(track-w, track-w / Math.max(1.0, root.history-zoom-x));
                    let travel = Math.max(1px, track-w - thumb-w);
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                        if (!root.history-running && root.edit-mode == 0) {
                            // Click anywhere on the track to centre the thumb there, then drag.
                            let target = hscroll-touch.mouse-x - thumb-w * 0.5;
                            root.history-pan-x = Math.max(0.0, Math.min(1.0, target / travel));
                            root.history-scroll-drag-axis = 1;
                            root.history-scroll-drag-start = root.history-pan-x;
                            root.history-scroll-drag-x = hscroll-touch.mouse-x;
                        }
                    } else if (e.kind == PointerEventKind.move && root.history-scroll-drag-axis == 1) {
                        let dx = hscroll-touch.mouse-x - root.history-scroll-drag-x;
                        root.history-pan-x = Math.max(0.0, Math.min(1.0, root.history-scroll-drag-start + dx / travel));
                    } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                        if (root.history-scroll-drag-axis == 1) { root.history-scroll-drag-axis = 0; }
                    }
                }
            }
            Rectangle {
                visible: root.history-zoom-y > 1.0;
                x: parent.width - 8px; y: 30px; width: 3px; height: parent.height - 40px; border-radius: 2px;
                background: Theme.border.with-alpha(0.35);
                Rectangle {
                    property <length> thumb-h: Math.min(parent.height, parent.height / root.history-zoom-y);
                    property <length> travel: Math.max(0px, parent.height - self.thumb-h);
                    y: self.travel * root.history-pan-y;
                    height: self.thumb-h; width: parent.width; border-radius: 2px;
                    background: Theme.c1.with-alpha(0.65);
                }
            }
            vscroll-touch := TouchArea {
                visible: root.history-zoom-y > 1.0;
                x: parent.width - 14px; y: 30px; width: 14px; height: parent.height - 40px;
                scroll-event(e) => {
                    let d = e.delta-y != 0px ? e.delta-y : e.delta-x;
                    if (d != 0px) {
                        root.history-pan-y = Math.max(0.0, Math.min(1.0, root.history-pan-y + (d < 0px ? 0.04 : -0.04)));
                        accept
                    } else {
                        reject
                    }
                }
                pointer-event(e) => {
                    let track-h = Math.max(1px, vscroll-touch.height);
                    let thumb-h = Math.min(track-h, track-h / Math.max(1.0, root.history-zoom-y));
                    let travel = Math.max(1px, track-h - thumb-h);
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                        // Click anywhere on the track to centre the thumb there, then drag.
                        let target = vscroll-touch.mouse-y - thumb-h * 0.5;
                        root.history-pan-y = Math.max(0.0, Math.min(1.0, target / travel));
                        root.history-scroll-drag-axis = 2;
                        root.history-scroll-drag-start = root.history-pan-y;
                        root.history-scroll-drag-y = vscroll-touch.mouse-y;
                    } else if (e.kind == PointerEventKind.move && root.history-scroll-drag-axis == 2) {
                        let dy = vscroll-touch.mouse-y - root.history-scroll-drag-y;
                        root.history-pan-y = Math.max(0.0, Math.min(1.0, root.history-scroll-drag-start + dy / travel));
                    } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                        if (root.history-scroll-drag-axis == 2) { root.history-scroll-drag-axis = 0; }
                    }
                }
            }

        }
        // Four runtime LFOs in a 2x2 rack; drop a colored point on a numeric control to link it.
        Rectangle {
            height: 88px; border-radius: 4px;
            background: Theme.surface; border-width: 1px; border-color: Theme.border;
            VerticalLayout {
                padding: 5px; spacing: 3px;
                HorizontalLayout {
                    height: 16px; spacing: 5px;
                    Text { text: "LFO MODULATION"; color: Theme.text-muted; font-size: 9px; vertical-alignment: center; }
                    Text {
                        horizontal-stretch: 1;
                        text: root.mod-status != "" ? root.mod-status : "drag a colored point onto a parameter · drag again to unlink";
                        color: root.mod-status != "" ? Theme.c2 : Theme.text-muted;
                        font-size: 8px; horizontal-alignment: right; vertical-alignment: center; overflow: elide;
                    }
                    Rectangle {
                        width: 58px; height: 15px; border-radius: 3px;
                        background: root.matrix-open ? Theme.c2.with-alpha(0.55) : (matrix-touch.has-hover ? Theme.control-hover : Theme.control);
                        Text { text: "MATRIX ▤"; color: root.matrix-open ? Theme.on-accent : Theme.text; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
                        matrix-touch := TipTouch {
                            hint: "Show or hide the LFO modulation matrix";
                            clicked => {
                                root.matrix-open = !root.matrix-open;
                                root.mode-menu-open = false;
                                root.tuning-open = false;
                                root.rate-menu-open = false;
                                root.scope-menu-open = false;
                                root.wave-menu-target = -1;
                                root.settings-open = false;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    height: 28px; spacing: 5px;
                    LfoCell {
                        horizontal-stretch: 1;
                        index: 1; enabled: root.lfo1-enabled; wave: root.lfo1-wave; rate-mode: root.lfo1-rate-mode;
                        freq: root.lfo1-freq; beats: root.lfo1-rate; depth: root.lfo1-depth;
                        phase: root.lfo1-phase; polarity: root.lfo1-polarity;
                        anim-phase: root.lfo1-anim-phase; dot-y: root.lfo1-dot-y; running: root.lfo-running;
                        wave-paths: root.wave-paths; wave-names: root.wave-names;
                        wave-selected(i) => { root.set-lfo-wave(1, i); }
                        wave-opened(x, y) => { root.wave-menu-target = 1; root.wave-menu-x = x; root.wave-menu-y = y - (root.wave-paths.length * 26px + 36px); }
                        enabled-toggled => { root.set-lfo-enabled(1, !root.lfo1-enabled); }
                        rate-mode-toggled => { root.set-lfo-rate-mode(1, root.lfo1-rate-mode == 0 ? 1 : 0); }
                        speed-changed(v) => { root.set-lfo-speed(1, v); }
                        depth-changed(v) => { root.set-lfo-depth(1, v); }
                        phase-changed(v) => { root.set-lfo-phase(1, v); }
                        polarity-toggled => { root.set-lfo-polarity(1, Math.mod(root.lfo1-polarity + 1, 3)); }
                    }
                    LfoCell {
                        horizontal-stretch: 1;
                        index: 2; enabled: root.lfo2-enabled; wave: root.lfo2-wave; rate-mode: root.lfo2-rate-mode;
                        freq: root.lfo2-freq; beats: root.lfo2-rate; depth: root.lfo2-depth;
                        phase: root.lfo2-phase; polarity: root.lfo2-polarity;
                        anim-phase: root.lfo2-anim-phase; dot-y: root.lfo2-dot-y; running: root.lfo-running;
                        wave-paths: root.wave-paths; wave-names: root.wave-names;
                        wave-selected(i) => { root.set-lfo-wave(2, i); }
                        wave-opened(x, y) => { root.wave-menu-target = 2; root.wave-menu-x = x; root.wave-menu-y = y - (root.wave-paths.length * 26px + 36px); }
                        enabled-toggled => { root.set-lfo-enabled(2, !root.lfo2-enabled); }
                        rate-mode-toggled => { root.set-lfo-rate-mode(2, root.lfo2-rate-mode == 0 ? 1 : 0); }
                        speed-changed(v) => { root.set-lfo-speed(2, v); }
                        depth-changed(v) => { root.set-lfo-depth(2, v); }
                        phase-changed(v) => { root.set-lfo-phase(2, v); }
                        polarity-toggled => { root.set-lfo-polarity(2, Math.mod(root.lfo2-polarity + 1, 3)); }
                    }
                }
                HorizontalLayout {
                    height: 28px; spacing: 5px;
                    LfoCell {
                        horizontal-stretch: 1;
                        index: 3; enabled: root.lfo3-enabled; wave: root.lfo3-wave; rate-mode: root.lfo3-rate-mode;
                        freq: root.lfo3-freq; beats: root.lfo3-rate; depth: root.lfo3-depth;
                        phase: root.lfo3-phase; polarity: root.lfo3-polarity;
                        anim-phase: root.lfo3-anim-phase; dot-y: root.lfo3-dot-y; running: root.lfo-running;
                        wave-paths: root.wave-paths; wave-names: root.wave-names;
                        wave-selected(i) => { root.set-lfo-wave(3, i); }
                        wave-opened(x, y) => { root.wave-menu-target = 3; root.wave-menu-x = x; root.wave-menu-y = y - (root.wave-paths.length * 26px + 36px); }
                        enabled-toggled => { root.set-lfo-enabled(3, !root.lfo3-enabled); }
                        rate-mode-toggled => { root.set-lfo-rate-mode(3, root.lfo3-rate-mode == 0 ? 1 : 0); }
                        speed-changed(v) => { root.set-lfo-speed(3, v); }
                        depth-changed(v) => { root.set-lfo-depth(3, v); }
                        phase-changed(v) => { root.set-lfo-phase(3, v); }
                        polarity-toggled => { root.set-lfo-polarity(3, Math.mod(root.lfo3-polarity + 1, 3)); }
                    }
                    LfoCell {
                        horizontal-stretch: 1;
                        index: 4; enabled: root.lfo4-enabled; wave: root.lfo4-wave; rate-mode: root.lfo4-rate-mode;
                        freq: root.lfo4-freq; beats: root.lfo4-rate; depth: root.lfo4-depth;
                        phase: root.lfo4-phase; polarity: root.lfo4-polarity;
                        anim-phase: root.lfo4-anim-phase; dot-y: root.lfo4-dot-y; running: root.lfo-running;
                        wave-paths: root.wave-paths; wave-names: root.wave-names;
                        wave-selected(i) => { root.set-lfo-wave(4, i); }
                        wave-opened(x, y) => { root.wave-menu-target = 4; root.wave-menu-x = x; root.wave-menu-y = y - (root.wave-paths.length * 26px + 36px); }
                        enabled-toggled => { root.set-lfo-enabled(4, !root.lfo4-enabled); }
                        rate-mode-toggled => { root.set-lfo-rate-mode(4, root.lfo4-rate-mode == 0 ? 1 : 0); }
                        speed-changed(v) => { root.set-lfo-speed(4, v); }
                        depth-changed(v) => { root.set-lfo-depth(4, v); }
                        phase-changed(v) => { root.set-lfo-phase(4, v); }
                        polarity-toggled => { root.set-lfo-polarity(4, Math.mod(root.lfo4-polarity + 1, 3)); }
                    }
                }
            }
        }
        HorizontalLayout {
            height: 30px; padding-top: 5px; spacing: 5px;
            HorizontalLayout {
                spacing: 0px;
                OptSlider { width: 168px; opt: root.opts[12]; index: 12; mod-target: 13; changed(v) => { root.set-opt(12, v); } }
                scope-gear := Rectangle {
                    width: 25px; height: 25px; border-radius: 4px;
                    background: root.scope-menu-open ? Theme.c2.with-alpha(0.5) : (scope-touch.has-hover ? Theme.control-hover : Theme.control);
                    Text { text: "⚙"; color: Theme.text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    scope-touch := TipTouch {
                        hint: "Choose which groups RANDOMIZE may change";
                        clicked => {
                            root.scope-menu-open = !root.scope-menu-open;
                            root.scope-menu-x = scope-gear.absolute-position.x + scope-gear.width - 160px;
                            root.scope-menu-y = scope-gear.absolute-position.y - 118px;
                        }
                        scroll-event(e) => { reject }
                    }
                }
            }
            OptSlider { width: 240px; opt: root.opts[10]; index: 10; mod-target: 12; changed(v) => { root.set-opt(10, v); } }
            // Export lives with the history it exports; Settings keeps only the destination folder.
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: 100px; height: 24px; border-radius: 4px;
                background: export-touch.has-hover ? Theme.c2 : Theme.control;
                Text { text: "EXPORT MIDI"; color: export-touch.has-hover ? Theme.on-accent : Theme.text; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
                export-touch := TipTouch { hint: "Write the current loop to a MIDI file"; clicked => { root.export-midi(); } }
            }
        }
        // Thin status strip: hover descriptions and edit/export feedback live here.
        Rectangle {
            height: 20px; border-radius: 3px;
            background: Theme.surface.with-alpha(0.55);
            border-width: 1px; border-color: Theme.border.with-alpha(0.7);
            Text {
                x: 5px; width: parent.width - 10px; height: parent.height;
                text: HoverTip.text != ""
                    ? HoverTip.text
                    : (root.edit-status != ""
                        ? root.edit-status
                        : (root.export-status != ""
                            ? root.export-status
                            : "width = gate · brightness = velocity/accent · outline = slide · tap = hit, drag = gate"));
                color: HoverTip.text != "" ? Theme.text : Theme.text-muted;
                font-size: 9px; vertical-alignment: center; overflow: elide;
            }
        }
    }

    // Floating badge follows the pointer while an LFO point is being dragged onto a parameter.
    if ModDrag.lfo > 0: Rectangle {
        x: ModDrag.x - 11px; y: ModDrag.y - 11px; width: 22px; height: 22px;
        border-radius: 11px;
        background: ModDrag.lfo == 1 ? Theme.c1 : (ModDrag.lfo == 2 ? Theme.c2 : (ModDrag.lfo == 3 ? Theme.c3 : Theme.hi));
        border-width: 2px; border-color: Theme.on-accent;
        Text { text: "\{ModDrag.lfo}"; color: Theme.on-accent; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }

    // Mode and Scale dropdowns; a transparent catcher closes the open list on the next click.
    if root.mode-menu-open || root.tuning-open || root.rate-menu-open || root.wave-menu-target >= 0 || root.scope-menu-open: Rectangle {
        x: 0px; y: 0px; width: root.base-width; height: root.base-height;
        background: #00000010;
        TouchArea { clicked => { root.mode-menu-open = false; root.tuning-open = false; root.rate-menu-open = false; root.wave-menu-target = -1; root.scope-menu-open = false; } }
    }
    if root.mode-menu-open: ModeDropdown {
        x: root.mode-menu-x; y: root.mode-menu-y;
        width: 460px; height: 420px;
        rows: root.mode-rows; names: root.mode-names; current: root.mode;
        selected(i) => { root.set-mode(i); root.mode-menu-open = false; }
    }
    // The Scale list follows its chip, which lives in the parameter column now.
    if root.tuning-open: DropdownList {
        x: scale-chip.absolute-position.x; y: Math.min(scale-chip.absolute-position.y + scale-chip.height + 2px, root.base-height - 302px);
        width: scale-chip.width; height: 300px;
        options: root.scale-names; current: root.scale-index;
        selected(i) => { root.set-scale(i); root.tuning-open = false; }
    }
    if root.rate-menu-open: DropdownList {
        x: rate-field.absolute-position.x; y: rate-field.absolute-position.y + rate-field.height + 2px;
        width: 70px; height: 260px;
        options: root.rate-names; current: root.rate; centered: true;
        selected(i) => { root.set-rate(i); root.rate-menu-open = false; }
    }
    // Collapsed waveform picker popup, shared by the oscillator and all four LFO slots.
    if root.wave-menu-target >= 0: Rectangle {
        x: root.wave-menu-x; y: root.wave-menu-y;
        width: root.wave-menu-target == 0 ? 126px : 92px; height: root.wave-paths.length * 26px + 8px;
        border-radius: 4px; background: Theme.surface;
        border-width: 1px; border-color: Theme.border;
        drop-shadow-blur: 12px; drop-shadow-color: #00000055; drop-shadow-offset-y: 3px;
        VerticalLayout {
            padding: 4px; spacing: 2px;
            for i in root.wave-paths.length: Rectangle {
                height: 24px; border-radius: 3px;
                background: (root.wave-menu-target == 0 && i == root.osc-wave) || (root.wave-menu-target == 1 && i == root.lfo1-wave) || (root.wave-menu-target == 2 && i == root.lfo2-wave) || (root.wave-menu-target == 3 && i == root.lfo3-wave) || (root.wave-menu-target == 4 && i == root.lfo4-wave) ? Theme.c1.with-alpha(0.18) : (row-touch.has-hover ? Theme.control-hover : Theme.control);
                Path {
                    x: 6px; y: 4px;
                    width: root.wave-menu-target == 0 ? 54px : parent.width - 12px;
                    height: parent.height - 8px;
                    viewbox-x: 0; viewbox-y: 0; viewbox-width: 100; viewbox-height: 40;
                    commands: root.wave-paths[i];
                    fill: transparent; stroke: Theme.c1; stroke-width: 1.2px;
                }
                Text { visible: root.wave-menu-target == 0; x: 68px; width: parent.width - 74px; height: parent.height; text: i < root.wave-names.length ? root.wave-names[i] : ""; color: Theme.text; font-size: 10px; vertical-alignment: center; overflow: elide; }
                row-touch := TouchArea {
                    clicked => {
                        if (root.wave-menu-target == 0) { root.set-osc-wave(i); }
                        if (root.wave-menu-target == 1) { root.set-lfo-wave(1, i); }
                        if (root.wave-menu-target == 2) { root.set-lfo-wave(2, i); }
                        if (root.wave-menu-target == 3) { root.set-lfo-wave(3, i); }
                        if (root.wave-menu-target == 4) { root.set-lfo-wave(4, i); }
                        root.wave-menu-target = -1;
                    }
                }
            }
        }
    }
    // Randomize scope, anchored to the small gear beside the Randomize-after strip.
    if root.scope-menu-open: Rectangle {
        x: root.scope-menu-x; y: root.scope-menu-y;
        width: 160px; height: 112px;
        border-radius: 4px; background: Theme.surface;
        border-width: 1px; border-color: Theme.border;
        drop-shadow-blur: 12px; drop-shadow-color: #00000055; drop-shadow-offset-y: 3px;
        VerticalLayout {
            padding: 4px; spacing: 3px;
            HorizontalLayout {
                spacing: 3px;
                ScopeChip { width: 72px; label: "MODE"; active: root.scope-mode; toggled => { root.toggle-scope(0); } }
                ScopeChip { width: 72px; label: "LENGTH"; active: root.scope-length; toggled => { root.toggle-scope(1); } }
            }
            HorizontalLayout {
                spacing: 3px;
                ScopeChip { width: 72px; label: "HITS"; active: root.scope-hits; toggled => { root.toggle-scope(2); } }
                ScopeChip { width: 72px; label: "TUNING"; active: root.scope-tuning; toggled => { root.toggle-scope(3); } }
            }
            HorizontalLayout {
                spacing: 3px;
                ScopeChip { width: 72px; label: "CLOCK"; active: root.scope-clock; toggled => { root.toggle-scope(4); } }
                ScopeChip { width: 72px; label: "PHASE"; active: root.scope-phase; toggled => { root.toggle-scope(5); } }
            }
            HorizontalLayout {
                spacing: 3px;
                ScopeChip { width: 72px; label: "ACID"; active: root.scope-acid; toggled => { root.toggle-scope(6); } }
                ScopeChip { width: 72px; label: "FEEL"; active: root.scope-feel; toggled => { root.toggle-scope(7); } }
            }
        }
    }

    // Read-only modulation matrix; the scrim follows the animated position so parked means gone.
    if root.matrix-y < root.base-height: Rectangle {
        x: 0px; y: 0px; width: root.base-width; height: root.base-height;
        background: #00000055;
        TouchArea { clicked => { root.matrix-open = false; } }
    }
    Rectangle {
        x: 0px; y: root.matrix-y; width: root.base-width; height: 300px;
        background: Theme.surface; border-width: 1px; border-color: Theme.border;
        drop-shadow-blur: 16px; drop-shadow-color: #00000055; drop-shadow-offset-y: -4px;
        animate y { duration: 150ms; easing: ease-in-out; }
        VerticalLayout {
            padding: 10px; spacing: 6px;
            HorizontalLayout {
                height: 24px;
                Text { text: "MODULATION MATRIX"; color: Theme.c1; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                Text { horizontal-stretch: 1; text: "drag an LFO point onto a parameter to link · × removes a link"; color: Theme.text-muted; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                Rectangle {
                    width: 62px; height: 22px; border-radius: 4px;
                    background: matrix-close.has-hover ? Theme.hi : Theme.control;
                    Text { text: "CLOSE"; color: matrix-close.has-hover ? Theme.on-accent : Theme.text; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                    matrix-close := TipTouch { hint: "Close the modulation matrix"; clicked => { root.matrix-open = false; } }
                }
            }
            HorizontalLayout {
                height: 18px; spacing: 6px;
                Text { width: 38px; text: "LFO"; color: Theme.text-muted; font-size: 10px; }
                Text { width: 220px; text: "SOURCE"; color: Theme.text-muted; font-size: 10px; }
                Text { width: 150px; text: "TARGET"; color: Theme.text-muted; font-size: 10px; }
                Text { width: 70px; text: "BASE"; color: Theme.text-muted; font-size: 10px; horizontal-alignment: right; }
                Text { width: 70px; text: "VALUE"; color: Theme.text-muted; font-size: 10px; horizontal-alignment: right; }
                Text { width: 70px; text: "DELTA"; color: Theme.text-muted; font-size: 10px; horizontal-alignment: right; }
                Text { width: 24px; text: ""; }
            }
            if root.mod-rows.length == 0: Text {
                text: "No links yet. Drag a colored LFO point onto any numeric parameter.";
                color: Theme.text-muted; font-size: 13px; wrap: word-wrap;
            }
            ScrollView {
                vertical-stretch: 1;
                vertical-scrollbar-policy: as-needed;
                VerticalLayout {
                    spacing: 2px;
                    for row in root.mod-rows: Rectangle {
                        height: 28px; border-radius: 3px;
                        background: row.lfo == 1 ? Theme.c1.with-alpha(0.08) : (row.lfo == 2 ? Theme.c2.with-alpha(0.08) : (row.lfo == 3 ? Theme.c3.with-alpha(0.08) : Theme.hi.with-alpha(0.05)));
                        HorizontalLayout {
                            padding-left: 6px; padding-right: 6px; spacing: 6px;
                            Text { width: 38px; text: "\{row.lfo}"; color: row.lfo == 1 ? Theme.c1 : (row.lfo == 2 ? Theme.c2 : (row.lfo == 3 ? Theme.c3 : Theme.hi)); font-size: 11px; font-weight: 700; vertical-alignment: center; }
                            Text { width: 220px; text: row.source; color: Theme.text-muted; font-size: 11px; vertical-alignment: center; overflow: elide; }
                            Text { width: 150px; text: row.target; color: Theme.text; font-size: 11px; vertical-alignment: center; overflow: elide; }
                            Text { width: 70px; text: row.base; color: Theme.text-muted; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 70px; text: row.value; color: Theme.c2; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 70px; text: row.delta; color: Theme.text-muted; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                            Rectangle {
                                width: 24px; height: 28px; border-radius: 3px;
                                background: delete-touch.has-hover ? Theme.c3.with-alpha(0.65) : transparent;
                                Text { width: parent.width; height: parent.height; text: "×"; color: delete-touch.has-hover ? Theme.on-accent : Theme.text-muted; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                                delete-touch := TipTouch { hint: "Remove this LFO-to-parameter link"; clicked => { root.delete-mod(row.lfo, row.target-id); } }
                            }
                        }
                    }
                }
            }
        }
    }

    // Parked off-screen when closed so the closing animation can play. Tie the scrim to the
    // animated position, not the boolean, so it cannot swallow clicks while the panel travels out.
    // Keep the LFO rack outside the scrim so links can still be dragged onto Settings fields.
    if root.settings-x < root.base-width: Rectangle {
        x: 0px; y: 0px; width: root.base-width; height: root.base-height - 105px;
        background: #00000066;
        TouchArea { clicked => { root.settings-open = false; } }
    }
    Rectangle {
        x: root.settings-x; y: 0px; width: 300px; height: root.base-height;
        background: Theme.surface; border-width: 1px; border-color: Theme.border;
        drop-shadow-blur: 16px; drop-shadow-color: #00000055; drop-shadow-offset-y: 4px;
        animate x { duration: 140ms; easing: ease-in-out; }
        // The panel can exceed the trimmed window; scroll instead of clipping the support block.
        ScrollView {
            width: parent.width; height: parent.height;
            vertical-scrollbar-policy: as-needed;
            VerticalLayout {
            padding: 12px; spacing: 8px;
            HorizontalLayout {
                height: 24px;
                Text { text: "SETTINGS"; color: Theme.c1; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                Rectangle { width: 74px; height: 22px; border-radius: 4px; background: close-settings.has-hover ? Theme.hi : Theme.control; Text { text: "CLOSE"; color: close-settings.has-hover ? Theme.on-accent : Theme.text; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; } close-settings := TipTouch { hint: "Close settings"; clicked => { root.settings-open = false; } } }
            }
            Text { text: "Click a number and type; Enter commits, Esc reverts, the wheel nudges."; color: Theme.text-muted; font-size: 8px; wrap: word-wrap; }
            Text { text: "COLOUR THEME"; color: Theme.text-muted; font-size: 9px; }
            Selector { options: ["Sketch", "Neon", "Lava", "Forest"]; current: root.theme-index; text-size: 10px; selected(i) => { root.set-theme(i); } }
            Text { text: "STARTING POINTS"; color: Theme.text-muted; font-size: 9px; }
            HorizontalLayout {
                height: 26px; spacing: 4px;
                for i in root.preset-names.length: Rectangle {
                    horizontal-stretch: 1; border-radius: 4px;
                    background: preset-touch.has-hover ? Theme.c2.with-alpha(0.7) : Theme.control;
                    Text { width: parent.width; height: parent.height; text: root.preset-names[i]; color: preset-touch.has-hover ? Theme.on-accent : Theme.text; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                    preset-touch := TipTouch { hint: "Load this starting point into the host parameters"; clicked => { root.apply-preset(i); } }
                }
            }
            Text { text: "Presets write ordinary host parameters, so the result stays automatable."; color: Theme.text-muted; font-size: 8px; wrap: word-wrap; }
            Text { text: "CONFIG FILE"; color: Theme.text-muted; font-size: 9px; }
            Text { text: root.settings-path; color: Theme.text-muted; font-size: 8px; wrap: word-wrap; }
            Text { text: "STEP SPACING"; color: Theme.text-muted; font-size: 9px; }
            // Turning rounding off lets the loop wrap between grid cells and drift against the grid.
            Rectangle {
                height: 26px; border-radius: 4px;
                background: root.round-steps ? Theme.c1.with-alpha(0.8) : (round-touch.has-hover ? Theme.control-hover : Theme.control);
                Text {
                    x: 8px; width: parent.width - 16px;
                    text: root.round-steps ? "WHOLE STEPS" : "FRACTIONAL STEPS";
                    color: root.round-steps ? Theme.on-accent : Theme.text;
                    font-size: 9px; vertical-alignment: center;
                }
                round-touch := TipTouch { hint: "Snap the loop length to whole grid cells or let it drift"; clicked => { root.toggle-round-steps(); } }
            }
            Text {
                text: "Whole steps snap the loop to the step grid; fractional steps let it drift.";
                color: Theme.text-muted; font-size: 9px; wrap: word-wrap;
            }
            Text { text: "PATTERN LIMIT"; color: Theme.text-muted; font-size: 9px; }
            max-steps-box := NumBox { label: "Max steps"; value: root.max-steps; minimum: 64; maximum: 1024; step: 1; mod-target: 22; changed(v) => { root.set-opt(14, v); } }
            // Pattern arrays are allocated for 1024 steps up front, so ceiling changes need no restart.
            Text { text: "Max steps applies immediately; no restart is needed."; color: Theme.text-muted; font-size: 9px; }
            Text { text: "TUNING"; color: Theme.text-muted; font-size: 9px; }
            midi-root-box := NumBox { label: "Root MIDI note"; value: root.midi-root; minimum: 0; maximum: 120; step: 1; mod-target: 19; changed(v) => { root.set-opt(20, v); } }
            cents-box := NumBox { label: "Root cents"; value: root.root-cents; minimum: -50; maximum: 50; step: 1; mod-target: 21; changed(v) => { root.set-opt(22, v); } }
            // The synth's full bend range; the plugin also announces it over RPN 0.
            bend-box := NumBox { label: "Bend range (semitones)"; value: root.bend-range; minimum: 1; maximum: 24; step: 1; changed(v) => { root.set-opt(25, v); } }
            Text { text: "Sent as RPN 0 so the receiving synth matches; set the same range by hand if it ignores RPN."; color: Theme.text-muted; font-size: 9px; wrap: word-wrap; }
            hist-box := NumBox { label: "History Length (Bars)"; value: root.history-bars; minimum: 1; maximum: root.history-max-bars; step: 1; mod-target: 23; changed(v) => { root.set-opt(23, v); } }
            Rectangle {
                height: 26px; border-radius: 4px;
                background: root.history-overlay-on ? Theme.c1.with-alpha(0.8) : (overlay-touch.has-hover ? Theme.control-hover : Theme.control);
                Text { x: 8px; width: parent.width - 16px; text: root.history-overlay-on ? "PATTERN OVERLAY: ON" : "PATTERN OVERLAY: OFF"; color: root.history-overlay-on ? Theme.on-accent : Theme.text; font-size: 9px; vertical-alignment: center; }
                overlay-touch := TipTouch { hint: "Draw the current loop over the recorded history"; clicked => { root.toggle-history-overlay(); } }
            }
            Text { text: "Outlines the current loop over the recorded history, so a regeneration or a transport jump is visible."; color: Theme.text-muted; font-size: 9px; wrap: word-wrap; }
            Text { text: "TECHNICAL SUPPORT"; color: Theme.text-muted; font-size: 9px; }
            Rectangle {
                height: 26px; border-radius: 4px;
                background: root.logging-on ? Theme.c1.with-alpha(0.8) : (logging-touch.has-hover ? Theme.control-hover : Theme.control);
                Text { x: 8px; width: parent.width - 16px; text: root.logging-on ? "LOGGING: ON (nelody-seq.log)" : "LOGGING: OFF"; color: root.logging-on ? Theme.on-accent : Theme.text; font-size: 9px; vertical-alignment: center; }
                logging-touch := TipTouch { hint: "Write mode and parameter snapshots to nelody-seq.log"; clicked => { root.toggle-logging(); } }
            }
            Text { text: "Writes mode and parameter snapshots to nelody-seq.log in your home folder."; color: Theme.text-muted; font-size: 9px; wrap: word-wrap; }
            Text { text: "MIDI EXPORT FOLDER"; color: Theme.text-muted; font-size: 9px; }
            Rectangle {
                height: 26px; border-radius: 4px;
                background: Theme.control; border-width: 1px; border-color: Theme.border;
                midi-input := TextInput {
                    x: 6px; width: parent.width - 12px; height: parent.height;
                    text: root.midi-folder; color: Theme.text; font-size: 9px;
                    vertical-alignment: center;
                    edited => { root.set-midi-folder(self.text); }
                    accepted => { root.set-midi-folder(self.text); }
                }
            }
            // Push the contact block to the bottom of the panel; the controls stay top-aligned.
            Rectangle { vertical-stretch: 1; }
            // Credit rows are flush; this nested layout removes the inter-row spacing.
            VerticalLayout {
                spacing: 0px;
                Text { text: "CREDITS / CONTACT"; color: Theme.text-muted; font-size: 9px; }
                Text { text: "\{root.credit-author}  ·  nelody seq"; color: Theme.text; font-size: 10px; }
                TextInput { read-only: true; text: root.credit-github; color: Theme.text-muted; font-size: 9px; height: 20px; vertical-alignment: center; }
                Text { height: 14px; text: "v\{root.app-version}"; color: Theme.text-muted; font-size: 8px; horizontal-alignment: right; vertical-alignment: center; }
            }
            }
        }
    }
    }

    // Linked-LFO tooltip below the hovered parameter; no TouchArea, so it never steals the drag.
    if ModHover.target >= 0 && ModView.view(ModHover.target).linked && !root.matrix-open && ModDrag.lfo == 0: Rectangle {
        x: Math.max(6px, Math.min(ModHover.x, root.base-width - 326px));
        y: Math.min(ModHover.y + 2px, root.base-height - 26px);
        width: 320px; height: 22px;
        border-radius: 4px; background: Theme.surface;
        border-width: 1px; border-color: Theme.c3;
        drop-shadow-blur: 10px; drop-shadow-color: #00000055; drop-shadow-offset-y: 3px;
        Text {
            x: 8px; width: parent.width - 16px; height: parent.height;
            text: ModView.view(ModHover.target).lfo-text;
            color: Theme.text; font-size: 10px;
            vertical-alignment: center; overflow: elide;
        }
    }
}
