import { ScrollView } from "std-widgets.slint";
import { FocusRing, HoverTip, ModDrag, ModHover, ModRegistry, ModView, ModTargetView, ModRow, ModeRow, Opt, TipTouch } from "shared.slint";
export { FocusRing, HoverTip, ModDrag, ModHover, ModRegistry, ModView, ModTargetView, ModRow, ModeRow, Opt } from "shared.slint";
// nelody seq: algorithm-first MIDI melody sequencer. Rust pushes deterministic pattern and view data.
export global Theme {
    in-out property <color> c1: #bef264;
    in-out property <color> c2: #22c55e;
    in-out property <color> c3: #0d9488;
    in-out property <color> hi: #fb923c;
    in-out property <color> bg1: #0d1712;
    in-out property <color> bg2: #111b15;
    in-out property <color> bg3: #0e1b19;
    in-out property <color> surface: #101e17;
    in-out property <color> control: #1b2c23;
    in-out property <color> control-hover: #2b4033;
    in-out property <color> text: #e3ece5;
    in-out property <color> text-muted: #93a89b;
    in-out property <color> border: #354b3e;
    in-out property <color> cell-off: #16261d;
    in-out property <color> on-accent: #0b0f14;
}

// Typographic roles. Sizes name a job, not a number, so the same role stays identical on every
// panel and state. At this density the lower steps sit 1px apart, so weight, case and tone
// carry the rest of the distinction; the crowded chrome cannot spend more room on type.
// No family is named: the plugin ships no font, and a platform face (Consolas) exists only on
// Windows and silently falls back to the UI sans everywhere else.
export global Type {
    // Wordmark only.
    out property <length> display: 24px;
    // Panel headings and the active generator name.
    out property <length> title: 14px;
    // Runs of prose: generator description, empty states, settings explanations.
    out property <length> body: 12px;
    // Values, option labels, matrix rows, compact support copy and the primary actions.
    out property <length> value: 11px;
    // Controls, chips, status text and column headers.
    out property <length> caption: 10px;
    // Metadata that has to fit a tighter box than a caption: axis labels, four-digit badges.
    out property <length> dense: 9px;
    // Glyph sizes are optical, not text roles: a symbol needs its own cap height beside words.
    out property <length> glyph-small: 12px;
    out property <length> glyph: 13px;
    out property <length> glyph-large: 14px;
}

export struct ViewNode { x: length, y: length, r: length, on: bool, cur: bool, label: string, link-step: int }
// One numeric-entry session shared by every option strip, so only one inline editor is open.
export global OptEdit {
    in-out property <int> index: -1;
    in-out property <string> draft: "";
}

// Slint 1.16 has no public DragArea/DropArea, so modulation drags use pointer coordinates and a registry.
// Hovered control description. The tip is drawn once in the header, so it can never cover the
// pointer or steal hover from the control that just opened it.
// Hovered modulation target and the point where its tooltip should be drawn (below the control).
// Effective value + linked-LFO summary for every numeric target, indexed by ModTarget::index.
component Selector inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    in property <length> text-size: Type.caption;
    callback selected(int);
    height: 28px;
    HorizontalLayout {
        spacing: 4px;
        for i in root.options.length: Rectangle {
            border-radius: 1px;
            background: ta.has-hover ? Theme.control-hover : Theme.control;
            if i == root.current: Rectangle {
                border-radius: 4px;
                background: @linear-gradient(90deg, Theme.c1 0%, Theme.c2 52%, Theme.c3 100%);
            }
            Text {
                width: parent.width; height: parent.height;
                text: root.options[i];
                color: i == root.current ? Theme.on-accent : Theme.text;
                font-size: root.text-size;
                horizontal-alignment: center; vertical-alignment: center;
                overflow: elide;
            }
            ta := TipTouch {
                hint: "Choose " + root.options[i];
                clicked => { root.selected(i); }
                // Enum parameters (rate, waveform, theme) can be stepped with the wheel too.
                scroll-event(e) => {
                    if (e.delta-y != 0px) {
                        root.selected((root.current + (e.delta-y > 0px ? 1 : -1)) < 0 ? 0 : ((root.current + (e.delta-y > 0px ? 1 : -1)) >= root.options.length ? root.options.length - 1 : root.current + (e.delta-y > 0px ? 1 : -1)));
                        accept
                    } else {
                        reject
                    }
                }
            }
        }
    }
}

// Collapsed waveform picker: shows the current shape and opens the icon list owned by AppWindow.
component WavePicker inherits Rectangle {
    in property <[string]> paths;
    in property <[string]> names;
    in property <int> current;
    in property <string> hint: "Select this waveform";
    // Live LFO phase dot. Off by default so the oscillator picker stays static.
    in property <float> anim-phase: 0;
    in property <float> dot-y: 20;
    in property <bool> show-dot: false;
    in property <bool> running: false;
    callback selected(int);
    callback opened(length, length);
    height: 28px; border-radius: 4px;
    background: ta.has-hover ? Theme.control-hover : Theme.control;
    border-width: 1px; border-color: Theme.border;
    Text { x: 8px; width: Math.max(parent.width - 96px, 0px); height: parent.height; text: root.current < root.names.length ? root.names[root.current] : ""; color: Theme.text; font-size: Type.caption; vertical-alignment: center; overflow: elide; }
    Path {
        x: Math.max(parent.width - 76px, 6px); y: 4px;
        width: Math.min(50px, parent.width - 28px); height: parent.height - 8px;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 100; viewbox-height: 40;
        commands: root.current < root.paths.length ? root.paths[root.current] : "";
        fill: transparent; stroke: Theme.c1; stroke-width: 1.2px;
    }
    if root.show-dot: Rectangle {
        x: Math.max(parent.width - 76px, 6px) + (2.0 + root.anim-phase * 96.0) / 100.0 * Math.min(50px, parent.width - 28px) - 2px;
        y: 4px + (root.dot-y / 40.0) * (parent.height - 8px) - 2px;
        width: 4px; height: 4px; border-radius: 2px;
        background: Theme.hi;
        opacity: root.running ? 0.9 : 0.25;
    }
    if root.show-dot: Rectangle {
        x: Math.max(parent.width - 76px, 6px) + (2.0 + root.anim-phase * 96.0) / 100.0 * Math.min(50px, parent.width - 28px);
        y: 4px; width: 1px; height: parent.height - 8px;
        background: Theme.hi;
        opacity: root.running ? 0.10 : 0.03;
    }
    Text { x: parent.width - 22px; width: 16px; height: parent.height; text: "▾"; color: Theme.text-muted; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; }
    ta := TipTouch {
        hint: root.hint;
        clicked => { root.opened(root.absolute-position.x, root.absolute-position.y + root.height); }
        scroll-event(e) => {
            if (e.delta-y != 0px) {
                root.selected(Math.max(0, Math.min(root.current + (e.delta-y > 0px ? 1 : -1), root.paths.length - 1)));
                accept
            } else {
                reject
            }
        }
    }
}

// One RANDOMIZE scope group. The eight chips edit the bits of a single host parameter.
component ScopeChip inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <string> hint: "Toggle this RANDOMIZE group";
    callback toggled();
    height: 24px; border-radius: 4px;
    background: root.active ? Theme.c1 : (ta.has-hover ? Theme.control-hover : Theme.control);
    Text { text: root.label; color: root.active ? Theme.on-accent : Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    ta := TipTouch { hint: root.hint; clicked => { root.toggled(); } }
}

// One tuning-row chip: shows a value and advances it on click (and on wheel).
component TuningChip inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> active: false;
    // Center the label/value, used by the scale picker so it matches its dropdown entries.
    in property <bool> centered: false;
    // The scale chip opens a panel, so a wheel there must not toggle it once per notch.
    in property <bool> wheel-cycles: true;
    in property <length> text-size: Type.caption;
    in property <string> hint: "Click to change this value";
    callback cycled();
    height: 28px; border-radius: 4px;
    background: root.active ? @linear-gradient(90deg, Theme.c1 0%, Theme.c2 100%) : (ta.has-hover ? Theme.control-hover : Theme.control);
    Text { x: 6px; width: parent.width - 12px; height: parent.height; text: root.label == "" ? root.value : "\{root.label}  \{root.value}"; color: root.active ? Theme.on-accent : Theme.text; font-size: root.text-size; horizontal-alignment: root.centered ? center : left; vertical-alignment: center; overflow: elide; }
    ta := TipTouch {
        hint: root.hint;
        clicked => { root.cycled(); }
        scroll-event(e) => {
            if (e.delta-y != 0px && root.wheel-cycles) { root.cycled(); accept } else { reject }
        }
    }
}

component OptSlider inherits Rectangle {
    in property <Opt> opt;
    // Strip index used to address the shared editing session. The caller passes 0..25.
    in property <int> index: -1;
    // Non-negative values are registered as modulation drop targets.
    in property <int> mod-target: -1;
    in property <string> hint: "Drag or scroll to adjust";
    callback changed(float);
    property <bool> mod-registered: false;
    property <ModTargetView> modview: ModView.view(root.mod-target);
    property <bool> mod-hover: root.mod-target >= 0 && ModDrag.lfo > 0
        && ModDrag.x >= root.absolute-position.x && ModDrag.x <= root.absolute-position.x + root.width
        && ModDrag.y >= root.absolute-position.y && ModDrag.y <= root.absolute-position.y + root.height;
    property <bool> hovered: ta.has-hover;
    // Normalize on the control's own display range so the second bar lines up with the fill,
    // even when the host range is wider (Steps is 1–1024, the strip may show 1–128).
    property <float> mod-base01: Math.clamp((root.modview.base - root.opt.min) / Math.max(root.opt.max - root.opt.min, 0.0001), 0, 1);
    property <float> mod-value01: Math.clamp((root.modview.value - root.opt.min) / Math.max(root.opt.max - root.opt.min, 0.0001), 0, 1);
    property <float> mod-up01: Math.min(1, root.modview.depth-up * (root.modview.max - root.modview.min) / Math.max(root.opt.max - root.opt.min, 0.0001));
    property <float> mod-down01: Math.min(1, root.modview.depth-down * (root.modview.max - root.modview.min) / Math.max(root.opt.max - root.opt.min, 0.0001));
    property <float> mod-band-low: Math.max(0, root.mod-base01 - root.mod-down01);
    property <float> mod-band-high: Math.min(1, root.mod-base01 + root.mod-up01);
    function report-mod() {
        if (root.mod-target >= 0) {
            ModRegistry.register(root.mod-target, root.visible, root.absolute-position.x, root.absolute-position.y, root.width, root.height);
        }
    }
    height: 25px;
    border-radius: 4px; background: Theme.control; clip: true;
    property <bool> editing: root.index >= 0 && OptEdit.index == root.index;
    property <bool> focus-pending: false;
    // Backend-independent double-click detection. Some host backends do not deliver a usable
    // click count, so two presses inside this window are treated as a double-click.
    property <bool> click-armed: false;
    property <length> first-click-x: 0px;
    property <length> first-click-y: 0px;

    function begin-entry() {
        OptEdit.draft = root.opt.number;
        OptEdit.index = root.index;
        // The overlay becomes visible on the next layout pass; focusing it in this callback
        // can land on an element that is not visible yet.
        root.focus-pending = true;
    }
    // Typed values use the same units the strip displays: 65 means 65% for Density, 180 means
    // 180° for Phase, and scale maps that back to the parameter range before clamping.
    function commit-entry() {
        if (OptEdit.draft.is-float()) {
            root.changed(Math.clamp(OptEdit.draft.to-float() * root.opt.scale, root.opt.min, root.opt.max));
        }
        OptEdit.index = -1;
    }
    function cancel-entry() {
        OptEdit.index = -1;
    }

    Rectangle {
        x: 0px; y: 0px; height: parent.height;
        width: parent.width * Math.clamp((root.opt.value - root.opt.min) / (root.opt.max - root.opt.min), 0, 1);
        background: @linear-gradient(90deg, Theme.c1 0%, Theme.c2 52%, Theme.c3 100%);
        opacity: 0.3;
    }
    // Second, thinner bar: base → current modulated value, with a band for the linked LFO depth.
    if root.modview.linked: Rectangle {
        x: parent.width * root.mod-band-low;
        y: parent.height - 5px;
        width: parent.width * Math.max(0, root.mod-band-high - root.mod-band-low);
        height: 4px;
        background: Theme.c3;
        opacity: 0.20;
    }

    if root.modview.linked: Rectangle {
        x: parent.width * Math.min(root.mod-base01, root.mod-value01);
        y: parent.height - 4px;
        width: parent.width * Math.abs(root.mod-value01 - root.mod-base01);
        height: 3px;
        background: Theme.c3;
        opacity: 0.95;
    }
    if root.modview.linked: Rectangle {
        x: Math.max(0px, Math.min(parent.width - 2px, parent.width * root.mod-value01 - 1px));
        y: parent.height - 5px; width: 2px; height: 5px;
        background: Theme.hi;
    }
    Text { x: 8px; width: parent.width - 16px; height: parent.height; text: root.opt.label; color: Theme.text; font-size: Type.value; vertical-alignment: center; }
    Text { x: 8px; width: parent.width - 16px; height: parent.height; text: root.opt.text; color: Theme.text; font-size: Type.value; horizontal-alignment: right; vertical-alignment: center; }
    ta := TouchArea {
        pointer-event(e) => {
            if (root.hint != "") {
                HoverTip.text = root.hint;
                HoverTip.x = root.absolute-position.x + ta.mouse-x;
                HoverTip.y = root.absolute-position.y + ta.mouse-y;
                HoverTip.owner-x = root.absolute-position.x;
                HoverTip.owner-y = root.absolute-position.y;
            }
            if (!root.editing && e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                if (root.click-armed
                    && Math.abs(ta.mouse-x - root.first-click-x) < 12px
                    && Math.abs(ta.mouse-y - root.first-click-y) < 12px) {
                    root.click-armed = false;
                    root.begin-entry();
                } else {
                    root.click-armed = true;
                    root.first-click-x = ta.mouse-x;
                    root.first-click-y = ta.mouse-y;
                }
                root.changed(root.opt.min + Math.clamp(ta.mouse-x / ta.width, 0, 1) * (root.opt.max - root.opt.min));
            }
        }
        moved => {
            if (root.hint != "") {
                HoverTip.text = root.hint;
                HoverTip.x = root.absolute-position.x + ta.mouse-x;
                HoverTip.y = root.absolute-position.y + ta.mouse-y;
                HoverTip.owner-x = root.absolute-position.x;
                HoverTip.owner-y = root.absolute-position.y;
            }
            if (!root.editing && ta.pressed) { root.changed(root.opt.min + Math.clamp(ta.mouse-x / ta.width, 0, 1) * (root.opt.max - root.opt.min)); }
        }
        // Double-click turns the strip into a field. Wheel editing snaps to the step grid and moves
        // one step per notch; while the editor is open the strip leaves both alone.
        double-clicked => {
            if (!root.editing && root.index >= 0) { root.begin-entry(); }
        }
        scroll-event(e) => {
            if (!root.editing && e.delta-y != 0px) {
                root.changed(Math.clamp(root.opt.min + Math.round((root.opt.value - root.opt.min) / root.opt.step + (e.delta-y > 0px ? 1 : -1)) * root.opt.step, root.opt.min, root.opt.max));
                accept
            } else {
                reject
            }
        }
        changed has-hover => {
            if (ta.has-hover) {
                HoverTip.text = root.hint;
                HoverTip.x = root.absolute-position.x + ta.mouse-x;
                HoverTip.y = root.absolute-position.y + ta.mouse-y;
                HoverTip.owner-x = root.absolute-position.x;
                HoverTip.owner-y = root.absolute-position.y;
            } else if (HoverTip.owner-x == root.absolute-position.x && HoverTip.owner-y == root.absolute-position.y) {
                HoverTip.text = "";
            }
        }
    }
    // Always declared so focus() has a live element; Enter commits, Escape reverts, blur commits.
    editor := Rectangle {
        visible: root.editing;
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        border-radius: 3px; background: Theme.surface; border-width: 1px; border-color: Theme.c2;
        entry := TextInput {
            x: 6px; y: 0px; width: parent.width - 12px; height: parent.height;
            text: OptEdit.draft;
            color: Theme.text; font-size: Type.value;
            horizontal-alignment: right; vertical-alignment: center;
            edited => { OptEdit.draft = self.text; }
            accepted => { root.commit-entry(); }
            changed has-focus => {
                if (!self.has-focus && root.editing) { root.commit-entry(); }
            }
            key-pressed(event) => {
                if (event.text == Key.Escape) { root.cancel-entry(); return accept; }
                return reject;
            }
        }
    }
    Timer {
        interval: 1ms;
        running: root.focus-pending && root.editing;
        triggered => {
            root.focus-pending = false;
            entry.focus();
            // Typing should replace the old value, not insert somewhere inside it.
            entry.select-all();
        }
    }
    Timer {
        interval: 500ms;
        running: root.click-armed;
        triggered => { root.click-armed = false; }
    }
    if root.mod-hover: Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        border-radius: 4px; border-width: 2px; border-color: Theme.c2;
        background: transparent;
    }
    // Timer-driven registration avoids Slint 1.16 property recursion in the position handler.
    Timer {
        interval: 30ms;
        running: root.mod-target >= 0 && !root.mod-registered;
        triggered => { root.mod-registered = true; root.report-mod(); }
    }
    // Refresh periodically so hidden controls cannot outrank visible ones after a reflow.
    Timer {
        interval: 250ms;
        running: root.mod-target >= 0;
        triggered => { root.report-mod(); }
    }
    Timer {
        interval: 40ms;
        running: root.hovered && root.mod-target >= 0 && !root.editing;
        triggered => {
            ModHover.target = root.mod-target;
            ModHover.x = root.absolute-position.x;
            ModHover.y = root.absolute-position.y + root.height;
        }
    }
    Timer {
        interval: 40ms;
        running: !root.hovered && ModHover.target == root.mod-target;
        triggered => { ModHover.target = -1; }
    }
    // Keyboard entry for the slider: Tab lands here, arrows step the value, Enter types one.
    // It handles no pointer events, so `ta` still owns dragging.
    key-scope := FocusScope {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        accessible-role: slider;
        accessible-label: root.opt.label;
        accessible-value: root.opt.text;
        accessible-value-minimum: root.opt.min;
        accessible-value-maximum: root.opt.max;
        accessible-value-step: root.opt.step;
        accessible-action-increment => { root.changed(Math.clamp(root.opt.value + root.opt.step, root.opt.min, root.opt.max)); }
        accessible-action-decrement => { root.changed(Math.clamp(root.opt.value - root.opt.step, root.opt.min, root.opt.max)); }
        key-pressed(event) => {
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.changed(Math.clamp(root.opt.value - root.opt.step, root.opt.min, root.opt.max));
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.changed(Math.clamp(root.opt.value + root.opt.step, root.opt.min, root.opt.max));
                return accept;
            }
            if (event.text == Key.Return || event.text == Key.Space) {
                if (!root.editing && root.index >= 0) { root.begin-entry(); }
                return accept;
            }
            reject
        }
        Rectangle {
            visible: key-scope.has-focus;
            width: parent.width; height: parent.height;
            border-width: 1px; border-color: Theme.hi; border-radius: 3px;
            background: transparent;
        }
        changed has-focus => {
            if (key-scope.has-focus && root.hint != "") {
                HoverTip.text = root.hint;
                HoverTip.owner-x = root.absolute-position.x;
                HoverTip.owner-y = root.absolute-position.y;
            } else if (HoverTip.owner-x == root.absolute-position.x && HoverTip.owner-y == root.absolute-position.y) {
                HoverTip.text = "";
            }
        }
    }
}
// Click-to-edit numeric field. The TextInput exists only while editing, so the display always
// follows the host parameter rather than a stale binding.
component NumBox inherits Rectangle {
    in property <string> label;
    in property <float> value: 0;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <int> decimals: 0;
    in property <int> mod-target: -1;
    in property <string> hint: "Click to type, or use the arrows";
    callback changed(float);
    property <bool> mod-registered: false;
    property <ModTargetView> modview: ModView.view(root.mod-target);
    property <bool> mod-hover: root.mod-target >= 0 && ModDrag.lfo > 0
        && ModDrag.x >= root.absolute-position.x && ModDrag.x <= root.absolute-position.x + root.width
        && ModDrag.y >= root.absolute-position.y && ModDrag.y <= root.absolute-position.y + root.height;
    property <bool> hovered: tap.has-hover;
    property <float> mod-base01: Math.clamp((root.modview.base - root.minimum) / Math.max(root.maximum - root.minimum, 0.0001), 0, 1);
    property <float> mod-value01: Math.clamp((root.modview.value - root.minimum) / Math.max(root.maximum - root.minimum, 0.0001), 0, 1);
    property <float> mod-up01: Math.min(1, root.modview.depth-up * (root.modview.max - root.modview.min) / Math.max(root.maximum - root.minimum, 0.0001));
    property <float> mod-down01: Math.min(1, root.modview.depth-down * (root.modview.max - root.modview.min) / Math.max(root.maximum - root.minimum, 0.0001));
    property <float> mod-band-low: Math.max(0, root.mod-base01 - root.mod-down01);
    property <float> mod-band-high: Math.min(1, root.mod-base01 + root.mod-up01);
    function report-mod() {
        if (root.mod-target >= 0) {
            ModRegistry.register(root.mod-target, root.visible, root.absolute-position.x, root.absolute-position.y, root.width, root.height);
        }
    }

    height: 26px;
    border-radius: 4px;
    background: Theme.control; border-width: 1px; border-color: Theme.border;
    horizontal-stretch: 1;
    // True while the numeric editor is open, so Rust can keep host shortcuts out of typing.
    out property <bool> editing: root.edit-open;
    property <bool> edit-open: false;
    property <bool> focus-pending: false;
    in-out property <string> draft: "";

    function clamp-value(v: float) -> float {
        return Math.clamp(v, root.minimum, root.maximum);
    }
    function nudge(dir: float) {
        // Use the typed draft as the nudge base while the editor is open.
        let base = root.draft.is-float() ? root.draft.to-float() : root.value;
        root.edit-open = false;
        root.changed(root.clamp-value(base + dir * root.step));
    }
    function format-value(v: float) -> string {
        if (root.decimals <= 0) { return Math.round(v); }
        return Math.round(v * 100) / 100;
    }
    function begin-edit() {
        root.draft = root.format-value(root.value);
        root.edit-open = true;
        root.focus-pending = true;
    }
    function commit-edit() {
        if (root.edit-open) {
            if (root.draft.is-float()) { root.changed(root.clamp-value(root.draft.to-float())); }
            root.edit-open = false;
        }
    }
    changed value => {
        if (!root.edit-open) { root.draft = root.format-value(root.value); }
    }

    Text {
        x: 6px; width: parent.width - 12px;
        text: root.label;
        color: Theme.text-muted; font-size: Type.caption; vertical-alignment: center; overflow: elide;
    }
    Text {
        visible: !root.edit-open;
        x: 6px; width: parent.width - 54px; height: parent.height;
        text: root.format-value(root.value);
        color: Theme.text; font-size: Type.value;
        horizontal-alignment: right; vertical-alignment: center;
    }
    if root.modview.linked: Rectangle {
        x: 1px + (parent.width - 35px) * root.mod-band-low;
        y: parent.height - 4px;
        width: (parent.width - 35px) * Math.max(0, root.mod-band-high - root.mod-band-low);
        height: 3px;
        background: Theme.c3;
        opacity: 0.20;
    }
    if root.modview.linked: Rectangle {
        x: 1px + (parent.width - 35px) * Math.min(root.mod-base01, root.mod-value01);
        y: parent.height - 3px;
        width: (parent.width - 35px) * Math.abs(root.mod-value01 - root.mod-base01);
        height: 2px;
        background: Theme.c3;
    }
    down := Rectangle {
        x: parent.width - 48px; y: 1px; width: 24px; height: parent.height - 2px;
        border-radius: 3px; background: down-touch.has-hover ? Theme.control-hover : Theme.control;
        Text { text: "-"; color: Theme.text; font-size: Type.glyph-small; horizontal-alignment: center; vertical-alignment: center; }
        down-touch := TipTouch { hint: "Decrease this value"; clicked => { root.nudge(-1); } }
    }
    up := Rectangle {
        x: parent.width - 24px; y: 1px; width: 24px; height: parent.height - 2px;
        border-radius: 3px; background: up-touch.has-hover ? Theme.control-hover : Theme.control;
        Text { text: "+"; color: Theme.text; font-size: Type.glyph-small; horizontal-alignment: center; vertical-alignment: center; }
        up-touch := TipTouch { hint: "Increase this value"; clicked => { root.nudge(1); } }
    }
    // Click the value to type; wheel outside the buttons to nudge. +/- stay clickable.
    tap := TouchArea {
        x: 0px; y: 0px; width: parent.width - 48px; height: parent.height;
        clicked => { if (!root.edit-open) { root.begin-edit(); } }
        moved => {
            if (root.hint != "") {
                HoverTip.text = root.hint;
                HoverTip.x = root.absolute-position.x + tap.mouse-x;
                HoverTip.y = root.absolute-position.y + tap.mouse-y;
                HoverTip.owner-x = root.absolute-position.x;
                HoverTip.owner-y = root.absolute-position.y;
            }
        }
        changed has-hover => {
            if (tap.has-hover) {
                HoverTip.text = root.hint;
                HoverTip.x = root.absolute-position.x + tap.mouse-x;
                HoverTip.y = root.absolute-position.y + tap.mouse-y;
                HoverTip.owner-x = root.absolute-position.x;
                HoverTip.owner-y = root.absolute-position.y;
            } else if (HoverTip.owner-x == root.absolute-position.x && HoverTip.owner-y == root.absolute-position.y) {
                HoverTip.text = "";
            }
        }
        scroll-event(e) => {
            if (!root.edit-open && e.delta-y != 0px) {
                root.nudge(e.delta-y > 0px ? 1 : -1);
                return accept;
            }
            return reject;
        }
    }
    editor := Rectangle {
        visible: root.edit-open;
        x: 1px; y: 1px; width: parent.width - 49px; height: parent.height - 2px;
        border-radius: 3px; background: Theme.surface; border-width: 1px; border-color: Theme.c2;
        entry := TextInput {
            x: 5px; y: 0px; width: parent.width - 10px; height: parent.height;
            text: root.draft;
            color: Theme.text; font-size: Type.value;
            horizontal-alignment: right; vertical-alignment: center;
            edited => { root.draft = self.text; }
            accepted => { root.commit-edit(); }
            changed has-focus => {
                if (!self.has-focus && root.edit-open) { root.commit-edit(); }
            }
            key-pressed(event) => {
                if (event.text == Key.UpArrow) {
                    if (root.draft.is-float()) { root.draft = root.format-value(root.clamp-value(root.draft.to-float() + root.step)); }
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    if (root.draft.is-float()) { root.draft = root.format-value(root.clamp-value(root.draft.to-float() - root.step)); }
                    return accept;
                }
                if (event.text == Key.Escape) { root.edit-open = false; return accept; }
                return reject;
            }
        }
    }
    Timer {
        interval: 1ms;
        running: root.focus-pending && root.edit-open;
        triggered => {
            root.focus-pending = false;
            entry.focus();
            entry.select-all();
        }
    }
    if root.mod-hover: Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        border-radius: 4px; border-width: 2px; border-color: Theme.c2;
        background: transparent;
    }
    // Timer-driven registration avoids a Slint 1.16 property-recursion panic.
    Timer {
        interval: 30ms;
        running: root.mod-target >= 0 && !root.mod-registered;
        triggered => { root.mod-registered = true; root.report-mod(); }
    }
    Timer {
        interval: 250ms;
        running: root.mod-target >= 0;
        triggered => { root.report-mod(); }
    }
    Timer {
        interval: 40ms;
        running: root.hovered && root.mod-target >= 0 && !root.edit-open;
        triggered => {
            ModHover.target = root.mod-target;
            ModHover.x = root.absolute-position.x;
            ModHover.y = root.absolute-position.y + root.height;
        }
    }
    Timer {
        interval: 40ms;
        running: !root.hovered && ModHover.target == root.mod-target;
        triggered => { ModHover.target = -1; }
    }
    // Keyboard entry: Tab lands on the value, Enter opens the draft editor, arrows step it.
    num-scope := FocusScope {
        x: 0px; y: 0px; width: parent.width - 48px; height: parent.height;
        accessible-role: spinbox;
        accessible-label: root.label;
        accessible-value: root.format-value(root.value);
        accessible-value-minimum: root.minimum;
        accessible-value-maximum: root.maximum;
        accessible-value-step: root.step;
        accessible-action-increment => { root.nudge(1); }
        accessible-action-decrement => { root.nudge(-1); }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                if (!root.edit-open) { root.begin-edit(); }
                return accept;
            }
            if (event.text == Key.UpArrow || event.text == Key.RightArrow) { root.nudge(1); return accept; }
            if (event.text == Key.DownArrow || event.text == Key.LeftArrow) { root.nudge(-1); return accept; }
            reject
        }
        Rectangle {
            visible: num-scope.has-focus;
            width: parent.width; height: parent.height;
            border-width: 1px; border-color: Theme.hi; border-radius: 3px;
            background: transparent;
        }
        changed has-focus => {
            if (num-scope.has-focus && root.hint != "") {
                HoverTip.text = root.hint;
                HoverTip.owner-x = root.absolute-position.x;
                HoverTip.owner-y = root.absolute-position.y;
            } else if (HoverTip.owner-x == root.absolute-position.x && HoverTip.owner-y == root.absolute-position.y) {
                HoverTip.text = "";
            }
        }
    }
}

// Grouped two-column mode picker. Headers are full-width; host indices stay in ModeRow.left/right.
component ModeDropdown inherits Rectangle {
    in property <[ModeRow]> rows;
    in property <[string]> names;
    in property <int> current;
    callback selected(int);
    width: 460px; height: 420px;
    background: Theme.surface; border-width: 1px; border-color: Theme.border;
    drop-shadow-blur: 16px; drop-shadow-color: #00000055; drop-shadow-offset-y: 4px;
    clip: true;
    ScrollView {
        width: parent.width; height: parent.height;
        vertical-scrollbar-policy: as-needed;
        VerticalLayout {
            spacing: 4px; padding: 8px; alignment: start;
            for r in root.rows: Rectangle {
                width: 444px;
                height: r.header ? 18px : 24px;
                border-radius: 3px;
                background: transparent;
                if r.header: Text {
                    x: 6px; width: parent.width - 12px; height: parent.height;
                    text: r.group; color: Theme.text-muted; font-size: Type.caption; font-weight: 700;
                    vertical-alignment: center; overflow: elide;
                }
                if !r.header: HorizontalLayout {
                    spacing: 6px;
                    Rectangle {
                        horizontal-stretch: 1; height: parent.height; border-radius: 3px;
                        background: r.left == root.current ? @linear-gradient(90deg, Theme.c1 0%, Theme.c2 52%, Theme.c3 100%) : (left-touch.has-hover ? Theme.control-hover : Theme.control);
                        Text { x: 6px; width: parent.width - 12px; height: parent.height; text: root.names[r.left]; color: r.left == root.current ? Theme.on-accent : Theme.text; font-size: Type.value; vertical-alignment: center; overflow: elide; }
                        left-touch := TipTouch { hint: "Select this mode"; clicked => { root.selected(r.left); } }
                    }
                    if r.has-right: Rectangle {
                        horizontal-stretch: 1; height: parent.height; border-radius: 3px;
                        background: r.right == root.current ? @linear-gradient(90deg, Theme.c1 0%, Theme.c2 52%, Theme.c3 100%) : (right-touch.has-hover ? Theme.control-hover : Theme.control);
                        Text { x: 6px; width: parent.width - 12px; height: parent.height; text: root.names[r.right]; color: r.right == root.current ? Theme.on-accent : Theme.text; font-size: Type.value; vertical-alignment: center; overflow: elide; }
                        right-touch := TipTouch { hint: "Select this mode"; clicked => { root.selected(r.right); } }
                    }
                    if !r.has-right: Rectangle { horizontal-stretch: 1; }
                }
            }
        }
    }
}

// Compact dropdown list shared by the Scale picker, overlaid so the editor keeps its full width.
component DropdownList inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    in property <bool> centered: false;
    callback selected(int);
    width: 300px; height: 360px;
    background: Theme.surface; border-width: 1px; border-color: Theme.border;
    drop-shadow-blur: 16px; drop-shadow-color: #00000055; drop-shadow-offset-y: 4px;
    clip: true;
    ScrollView {
        width: parent.width; height: parent.height;
        vertical-scrollbar-policy: as-needed;
        VerticalLayout {
            spacing: 3px; padding: 8px; alignment: start;
            height: 13px + root.options.length * 29px;
            for i in root.options.length: Rectangle {
                height: 26px; border-radius: 3px;
                background: i == root.current ? @linear-gradient(90deg, Theme.c1 0%, Theme.c2 52%, Theme.c3 100%) : (item-touch.has-hover ? Theme.control-hover : Theme.control);
                Text { x: 8px; width: parent.width - 16px; height: parent.height; text: root.options[i]; color: i == root.current ? Theme.on-accent : Theme.text; font-size: Type.caption; horizontal-alignment: root.centered ? center : left; vertical-alignment: center; overflow: elide; }
                item-touch := TipTouch { hint: "Select this value"; clicked => { root.selected(i); } }
            }
        }
    }
}

component ModePanel inherits Rectangle {
    // Suppress the position tweens when the user asks for reduced motion.
    in property <bool> reduce-motion: false;
    in property <[ViewNode]> nodes;
    in property <string> edges: "M0 0";
    in property <string> fills: "M0 0";
    in property <string> solid: "M0 0";
    // Acid tone classes: slid notes and octave-jumped notes get their own colour.
    in property <string> slid: "M0 0";
    in property <string> jumped: "M0 0";
    in property <string> lines: "M0 0";
    in property <string> hand: "M0 0";
    // Piano-roll pointer position, for the signal x-ray: the marks that produced that step stay
    // legible while every other mark recedes. -1 means no link is being held.
    in property <int> xray-step: -1;
    in property <bool> xray-active: false;
    callback probe-at(length, length);
    // view.rs builds every panel in a 210-unit space; paths scale through the viewbox and node
    // rectangles are scaled by hand so dots and labels grow with the box.
    property <float> px-per-unit: 1.4285714;   // 300px square drawing / 210-unit geometry
    property <length> draw-offset-x: 30px;      // letterbox the square drawing in the wider card
    width: 360px; height: 300px;
    background: transparent; border-radius: 6px; clip: true;
    Path { x: root.draw-offset-x; y: 0px; width: 300px; height: 300px; viewbox-x: 0; viewbox-y: 0; viewbox-width: 210; viewbox-height: 210; commands: root.edges; fill: transparent; stroke: Theme.border; stroke-width: 1px; }
    Path { x: root.draw-offset-x; y: 0px; width: 300px; height: 300px; viewbox-x: 0; viewbox-y: 0; viewbox-width: 210; viewbox-height: 210; commands: root.fills; fill: Theme.c2.with-alpha(0.35); }
    Path { x: root.draw-offset-x; y: 0px; width: 300px; height: 300px; viewbox-x: 0; viewbox-y: 0; viewbox-width: 210; viewbox-height: 210; commands: root.solid; fill: Theme.c1.with-alpha(0.85); }
    Path { x: root.draw-offset-x; y: 0px; width: 300px; height: 300px; viewbox-x: 0; viewbox-y: 0; viewbox-width: 210; viewbox-height: 210; commands: root.slid; fill: Theme.c3.with-alpha(0.85); }
    Path { x: root.draw-offset-x; y: 0px; width: 300px; height: 300px; viewbox-x: 0; viewbox-y: 0; viewbox-width: 210; viewbox-height: 210; commands: root.jumped; fill: Theme.hi.with-alpha(0.85); }
    Path { x: root.draw-offset-x; y: 0px; width: 300px; height: 300px; viewbox-x: 0; viewbox-y: 0; viewbox-width: 210; viewbox-height: 210; commands: root.lines; fill: transparent; stroke: Theme.c3; stroke-width: 1.4px; }
    Path { x: root.draw-offset-x; y: 0px; width: 300px; height: 300px; viewbox-x: 0; viewbox-y: 0; viewbox-width: 210; viewbox-height: 210; commands: root.hand; fill: transparent; stroke: Theme.hi; stroke-width: 2px; }
    for n in root.nodes: Rectangle {
        // Pebble-box positions change every step; static panels never show the tween.
        animate x, y { duration: root.reduce-motion ? 0ms : 120ms; }
        x: root.draw-offset-x + (n.x - n.r) * root.px-per-unit; y: (n.y - n.r) * root.px-per-unit;
        width: n.r * 2 * root.px-per-unit; height: n.r * 2 * root.px-per-unit;
        border-radius: n.r * root.px-per-unit;
        property <bool> linked: root.xray-step >= 0 && n.link-step == root.xray-step;
        // A held state, never an animation: the linked marks keep their ink and a focus ring,
        // the rest step back only while a real mark exists for the held step.
        opacity: !root.xray-active || root.xray-step < 0 || linked ? 1.0 : 0.28;
        background: n.cur ? Theme.hi : (n.on ? Theme.c1 : Theme.cell-off);
        border-width: linked ? 2px : 1px;
        border-color: linked ? Theme.hi : Theme.border;
        // Canvas labels scale with the drawing, so they follow the node radius, not a text role.
        Text { width: parent.width; height: parent.height; text: n.label; font-size: 7px * root.px-per-unit; color: (n.cur || n.on) ? Theme.on-accent : Theme.text; horizontal-alignment: center; vertical-alignment: center; }
    }
    // Read the drawing under the pointer. The host finds the nearest step-linked mark, so the
    // same link works in the other direction: the roll marks the time that step occupies.
    probe := TouchArea {
        x: root.draw-offset-x; y: 0px; width: 300px; height: 300px;
        moved => { root.probe-at(probe.mouse-x / root.px-per-unit, probe.mouse-y / root.px-per-unit); }
        changed has-hover => {
            if (!probe.has-hover) { root.probe-at(-9999px, -9999px); }
        }
    }
}

export component AppWindow inherits Window {
    title: "nelody seq";
    // Fixed layout size: the window never resizes, so the host cannot fight over it.
    in property <length> base-width: 860px;
    in property <length> base-height: 697px;
    preferred-width: root.base-width; preferred-height: root.base-height;
    background: @linear-gradient(135deg, Theme.bg1 0%, Theme.bg2 50%, Theme.bg3 100%);
    in property <int> mode: 0;
    in property <float> steps: 16;
    in property <float> max-steps: 256;
    in property <bool> round-steps: true;
    in property <int> voices: 1;
    in property <float> voice-spread: 0.25;
    in property <int> voice-mode: 0;
    in property <int> voice-preview: 0;
    // Grid cells the generator will fill, mirroring `cell_count_for`: snap rounds, free length
    // takes the ceiling. Header and bounds read this so they cannot disagree with the matrix.
    property <int> cells: root.round-steps ? Math.round(root.steps) : Math.ceil(root.steps);
    in-out property <int> current-step: 0;
    // One-shot background pulse when Generate or regenerate-after-N swaps the pattern.
    in-out property <bool> regen-pulse: false;
    changed regen-pulse => {
        if (root.regen-pulse) { regen-off-timer.start(); }
    }
    in property <float> pulses: 5;
    in property <float> rotate: 0;
    in property <float> density: 0.65;
    in property <float> probability: 1.0;
    in property <float> velocity: 1.0;
    in property <float> gate: 0.12;
    in property <float> regenerate-every: 0;
    in property <float> randomize-after-lengths: 0;
    in property <float> swing: 0;
    in property <bool> lfo1-enabled: true;
    in property <int> lfo1-wave: 0;
    in property <int> lfo1-rate-mode: 0;
    in property <float> lfo1-freq: 0.5;
    in property <float> lfo1-rate: 4.0;
    in property <float> lfo1-depth: 0.0;
    in property <float> lfo1-phase: 0.0;
    in property <int> lfo1-polarity: 0;
    in property <float> lfo1-anim-phase: 0.0;
    in property <float> lfo1-dot-y: 20.0;
    in property <bool> lfo2-enabled: true;
    in property <int> lfo2-wave: 1;
    in property <int> lfo2-rate-mode: 0;
    in property <float> lfo2-freq: 0.25;
    in property <float> lfo2-rate: 8.0;
    in property <float> lfo2-depth: 0.0;
    in property <float> lfo2-phase: 0.0;
    in property <int> lfo2-polarity: 0;
    in property <float> lfo2-anim-phase: 0.0;
    in property <float> lfo2-dot-y: 20.0;
    in property <bool> lfo3-enabled: true;
    in property <int> lfo3-wave: 2;
    in property <int> lfo3-rate-mode: 0;
    in property <float> lfo3-freq: 1.0;
    in property <float> lfo3-rate: 2.0;
    in property <float> lfo3-depth: 0.0;
    in property <float> lfo3-phase: 0.0;
    in property <int> lfo3-polarity: 0;
    in property <float> lfo3-anim-phase: 0.0;
    in property <float> lfo3-dot-y: 20.0;
    in property <bool> lfo4-enabled: true;
    in property <int> lfo4-wave: 3;
    in property <int> lfo4-rate-mode: 0;
    in property <float> lfo4-freq: 2.0;
    in property <float> lfo4-rate: 1.0;
    in property <float> lfo4-depth: 0.0;
    in property <float> lfo4-phase: 0.0;
    in property <int> lfo4-polarity: 0;
    in property <float> lfo4-anim-phase: 0.0;
    in property <float> lfo4-dot-y: 20.0;
    in property <bool> lfo-running: false;
    in-out property <bool> matrix-open: false;
    in-out property <length> matrix-y: root.base-height;
    changed matrix-open => {
        root.matrix-y = root.matrix-open ? root.base-height - 300px : root.base-height;
    }
    in property <[ModRow]> mod-rows;
    in-out property <string> mod-status: "";
    in property <float> seed: 0.271;
    in property <float> phase: 0.0;
    in property <float> osc-rate: 2.0;
    in property <float> ca-rule: 30;
    in property <float> markov-bias: 0;
    in property <float> symmetry: 4;
    in property <int> osc-wave: 0;
    in property <[string]> wave-names;
    // SVG thumbnails aligned with `wave-names`; generated by `view::wave_icon_paths()`.
    in property <[string]> wave-paths;
    in property <[string]> scale-names;
    in property <int> scale-index: 0;
    in property <bool> scope-mode: true;
    in property <bool> scope-length: true;
    in property <bool> scope-hits: true;
    in property <bool> scope-tuning: true;
    in property <bool> scope-phase: true;
    in property <bool> scope-acid: true;
    in property <bool> scope-feel: true;
    in property <string> settings-path: "";
    in property <string> credit-author: "";
    in property <string> credit-github: "";
    in property <string> midi-folder: "";
    // DAW track hosting this instance; empty when the host does not report one.
    in property <string> track-name: "";
    // Any text field with keyboard focus. Rust reads this each frame (see `keys.rs`).
    out property <bool> text-focused: midi-input.has-focus || max-steps-box.editing || tuning-root.editing || tuning-oct.editing || edo-row.editing || midi-root-box.editing || cents-box.editing || bend-box.editing || hist-box.editing || OptEdit.index >= 0;
    in-out property <string> export-status: "";
    // -1 forces the first update tick to push the real palette (project or global setting)
    // instead of leaving the Slint defaults visible.
    in property <int> theme-index: -1;
    in property <[ModeRow]> mode-rows;
    in property <string> app-version: "";
    in-out property <bool> mode-menu-open: false;
    // Dropdown anchors; the fixed layout hangs both menus directly under their controls.
    in property <length> mode-menu-x: 384px;
    in property <length> mode-menu-y: 86px;
    // Waveform picker popup: -1 closed, 0 oscillator, 1–4 LFO slots.
    in-out property <int> wave-menu-target: -1;
    in-out property <length> wave-menu-x: 0px;
    in-out property <length> wave-menu-y: 0px;
    // Randomize-scope popup anchored to the gear in the Randomize-after strip.
    in-out property <bool> scope-menu-open: false;
    in-out property <length> scope-menu-x: 0px;
    in-out property <length> scope-menu-y: 0px;
    in-out property <bool> tuning-open: false;
    in-out property <bool> settings-open: false;
    // Settings still slide in from the right edge of the fixed 860px layout.
    in-out property <length> settings-x: root.base-width;
    changed settings-open => {
        root.settings-x = root.settings-open ? root.base-width - 300px : root.base-width;
    }
    in property <bool> free-run: false;
    in property <bool> invert-on: false;
    in property <bool> mirror-on: false;
    in property <bool> logging-on: false;
    // User-global preference: suppress tweens and one-shot flashes.
    in-out property <bool> reduce-motion: false;
    in property <bool> generate-on: false;
    // Melody / tuning row.
    in property <string> tuning-name: "Minor";
    in property <int> root-pc: 0;
    in property <int> octaves: 2;
    in property <int> midi-root: 48;
    in property <int> edo: 12;
    // EDO only changes a scale when the Equal (EDO) table is active.
    in property <bool> edo-active: false;
    in property <float> root-cents: 0;
    in property <float> bend-range: 2;
    in property <float> history-bars: 4;
    // Longest history window the current Max Steps ceiling can fill, in 4/4 bars.
    in property <float> history-max-bars: 1024;
    in property <bool> nts-on: true;
    in property <float> slide: 0.25;
    in property <float> accent: 0.3;
    in property <float> octave: 0.15;
    // MIDI history (bottom slot, flows right to left).
    // Pitch ruler: note names for the octave lines, plus the roll's snapped range.
    in property <[string]> history-ruler;
    in property <int> history-lo: 48;
    in property <int> history-hi: 72;
    in property <string> history-bg: "M0 0";
    in property <string> history-bg-bars: "M0 0";
    in property <string> history-grid: "M0 0";
    in property <string> history-grid-steps: "M0 0";
    in property <string> history-grid-beats: "M0 0";
    in property <string> history-grid-bars: "M0 0";
    in property <string> history-notes: "M0 0";
    in property <string> history-notes-mid: "M0 0";
    in property <string> history-notes-hard: "M0 0";
    // Ghost of the current loop, phase-locked to the transport.
    in property <string> history-pattern: "M0 0";
    in property <string> history-pattern-slides: "M0 0";
    in property <string> history-probe: "M0 0";
    in property <bool> history-overlay-on: true;
    in property <string> history-range: "";
    in property <string> history-timing: "";
    // Editor-only view state: zoom > 1 magnifies; pan 0 = newest/top.
    in-out property <float> history-zoom-x: 1.0;
    in-out property <float> history-zoom-y: 1.0;
    in-out property <float> history-pan-x: 0.0;
    in-out property <float> history-pan-y: 0.0;
    in property <bool> history-running: false;
    in-out property <bool> history-editing: root.edit-mode > 0 || root.history-gate-dragging;
    in-out property <bool> history-gate-dragging: false;
    in-out property <bool> history-pan-drag: false;
    in-out property <int> history-pan-axis: 0;
    in-out property <float> history-pan-start: 0.0;
    in-out property <float> history-pan-y-start: 0.0;
    in-out property <length> history-pan-mouse: 0px;
    in-out property <length> history-pan-mouse-y: 0px;
    // Scrollbar drag state: axis 1 = horizontal, 2 = vertical.
    in-out property <int> history-scroll-drag-axis: 0;
    in-out property <float> history-scroll-drag-start: 0.0;
    in-out property <length> history-scroll-drag-x: 0px;
    in-out property <length> history-scroll-drag-y: 0px;
    in-out property <bool> notes-press: false;
    in-out property <bool> notes-dragging: false;
    in-out property <length> notes-start-x: 0px;
    in-out property <float> notes-cx: 0.0;
    in-out property <bool> edit-advanced: false;
    in-out property <int> gate-snap-index: 1;
    // Signal x-ray. `hover-step` is the loop step under the roll pointer; `probe-step` is the
    // drawing mark under the drawing pointer. They never feed each other.
    in-out property <int> hover-step: -1;
    in-out property <int> probe-step: -1;
    in-out property <bool> xray-active: false;
    callback probe-at(length, length);
    callback xray-hover(int);
    // Grid spacing derived from the selected mode; no clock-rate or meter setting exists.
    in property <float> steps-per-bar: 16.0;
    in property <string> timing-summary: "4/4 · step 1/16";
    property <float> history-vb-w: 800.0 / Math.max(1.0, root.history-zoom-x);
    property <float> history-vb-h: 200.0 / Math.max(1.0, root.history-zoom-y);
    // Live clock follows the newest note. A stopped clock and edit mode allow inspection/pans.
    property <float> history-vb-x: (root.history-running || root.history-editing) ? (800.0 - root.history-vb-w) : (800.0 - root.history-vb-w) * root.history-pan-x;
    property <float> history-vb-y: (200.0 - root.history-vb-h) * root.history-pan-y;
    // 0 = newest edge of the window, 1 = the drawing's right edge; outside means panned away.
    property <float> playhead-x: (800.0 - root.history-vb-x) / Math.max(root.history-vb-w, 1.0);
    changed edit-mode => {
        root.notes-press = false;
        root.notes-dragging = false;
        root.history-gate-dragging = false;
        if (root.edit-mode > 0) {
            root.ensure-edit-zoom();
        } else {
            root.history-pan-x = 0.0;
            root.edit-advanced = false;
        }
    }
    changed edit-advanced => {
        if (!root.edit-advanced && root.edit-mode > 1) { root.edit-mode = 1; }
    }
    pure function gate-snap-unit() -> float {
        if (root.gate-snap-index == 0) { return 0.25; }
        if (root.gate-snap-index == 1) { return 0.5; }
        if (root.gate-snap-index == 2) { return 0.75; }
        return 1.0;
    }
    function zoom-history(factor: float) {
        let cx = (root.history-vb-x + root.history-vb-w * 0.5) / 800.0;
        let cy = (root.history-vb-y + root.history-vb-h * 0.5) / 200.0;
        root.history-zoom-x = Math.max(1.0, Math.min(8.0, root.history-zoom-x * factor));
        root.history-zoom-y = Math.max(1.0, Math.min(8.0, root.history-zoom-y * factor));
        let nx = Math.max(0.01, 800.0 - root.history-vb-w);
        let ny = Math.max(0.01, 200.0 - root.history-vb-h);
        root.history-pan-x = (root.history-running && !root.history-editing)
            ? 0.0
            : Math.max(0.0, Math.min(1.0, (cx * 800.0 - root.history-vb-w * 0.5) / nx));
        root.history-pan-y = Math.max(0.0, Math.min(1.0, (cy * 200.0 - root.history-vb-h * 0.5) / ny));
    }
    function fit-history() {
        root.history-zoom-x = 1.0;
        root.history-zoom-y = 1.0;
        root.history-pan-x = 0.0;
        root.history-pan-y = 0.0;
    }
    // Entering edit mode zooms in until one step is at least ~6.5 logical px wide, so dense
    // 1/32 and 1/64 lines are still reachable with the pointer.
    function ensure-edit-zoom() {
        let visible-steps = Math.max(1.0, root.history-bars * Math.max(root.steps-per-bar, 1.0));
        let natural-step = 800.0 / visible-steps;
        let target = Math.max(1.0, Math.min(8.0, 6.5 / Math.max(natural-step, 0.0001)));
        if (target > root.history-zoom-x) {
            root.history-zoom-x = target;
            root.history-pan-x = 0.0;
        }
    }
    in property <[ViewNode]> view-nodes;
    in property <string> view-edges: "M0 0";
    in property <string> view-fills: "M0 0";
    in property <string> view-solid: "M0 0";
    in property <string> view-slid: "M0 0";
    in property <string> view-jumped: "M0 0";
    in property <string> view-lines: "M0 0";
    in property <string> view-hand: "M0 0";
    in property <string> mode-math: "";
    in property <string> edit-status: "";
    in-out property <int> edit-mode: 0;
    /// Polymeter voice timing is exact; manual cell edits are disabled while it is active.
    in property <bool> timing-locked: false;
    in property <[string]> preset-names;
    callback set-mode(int);
    callback apply-preset(int);
    callback edit-overlay(float, int);
    /// content x (0..1), gate snap unit, phase (0 start, 1 move, 2 end)
    callback edit-gate(float, float, int);
    callback clear-edits();
    callback undo-edit();
    callback redo-edit();
    // One wheel notch over the current-mode header: -1 previous, +1 next.
    callback step-mode(int);
    callback set-osc-wave(int);
    callback set-markov-bias(float);
    callback set-lfo-enabled(int, bool);
    callback set-lfo-wave(int, int);
    callback set-lfo-rate-mode(int, int);
    callback set-lfo-speed(int, float);
    callback set-lfo-depth(int, float);
    callback set-lfo-phase(int, float);
    callback set-lfo-polarity(int, int);
    callback delete-mod(int, int);
    callback set-theme(int);
    callback set-opt(int, float);
    callback toggle-round-steps();
    callback set-scale(int);
    callback toggle-nts();
    callback toggle-free-run();
    callback toggle-invert();
    callback toggle-mirror();
    callback toggle-logging();
    callback toggle-history-overlay();
    callback generate-pressed();
    callback randomize-pressed();
    callback toggle-scope(int);
    callback set-midi-folder(string);
    callback export-midi();
    callback toggle-reduce-motion();

    // Window shortcuts, shared by every focus scope. Controls reject keys they do not use, so
    // the event bubbles up the item tree to the scope that encloses them.
    function handle-key(text: string) -> bool {
        if (text == "g" || text == "G") { root.regen-pulse = true; root.generate-pressed(); return true; }
        if (text == "r" || text == "R") { root.randomize-pressed(); return true; }
        if (text == "s" || text == "S") {
            root.tuning-open = false;
            root.mode-menu-open = false;
            root.settings-open = !root.settings-open;
            return true;
        }
        if (text == Key.Escape) {
            root.settings-open = false;
            root.mode-menu-open = false;
            root.tuning-open = false;
            root.scope-menu-open = false;
            root.wave-menu-target = -1;
            nav.focus();
            return true;
        }
        return false;
    }

    // Expose only the controls the selected mode uses, labelled for that mode; `GenParams` still
    // carries every field.
    pure function shows-param(mode: int, key: int) -> bool {
        if (key == 5) { // osc phase: only modes that actually consume it
            if (mode >= 19 && mode <= 27) { return true; }
            return mode == 0 || mode == 1 || mode == 2 || mode == 4 || mode == 7 || mode == 9 || mode == 10 || mode == 11 || mode == 12 || mode == 17 || mode == 18;
        }
        if (key == 6) { return mode == 9 || mode == 8; }        // osc cycles: Oscillator, Markov
        if (key == 7) { return mode == 7 || mode == 11 || mode == 29; } // CA rule: Cellular, Sieve, Life
        // symmetry selects the Cellular/Life initial state and the L-system grammar family.
        if (key == 11) { return mode == 7 || mode == 10 || mode == 29; }
        return true;
    }
    pure function symmetry-label(mode: int) -> string {
        if (mode == 7) { return "Initial state"; }
        if (mode == 10) { return "Grammar"; }
        return "Symmetry";
    }
    pure function symmetry-text(mode: int, value: float) -> string {
        let v = Math.round(value);
        if (mode == 7) {
            if (v == 1) { return "Centre"; }
            if (v == 2) { return "Stripes"; }
            if (v == 3) { return "Solid + gap"; }
            return "Random";
        }
        if (mode == 10) {
            if (v == 1) { return "Family A"; }
            if (v == 2) { return "Family B"; }
            if (v == 3) { return "Family C"; }
            if (v == 5) { return "Family D"; }
            return "Auto";
        }
        return "\{v}";
    }
    pure function steps-max(mode: int) -> float {
        // Short, closed-form modes do not benefit from four-digit step counts.
        if (mode == 0 || mode == 6) { return 128; }
        if (mode >= 14 && mode <= 18) { return 64; }
        if (mode == 1 || mode == 3 || mode == 12 || mode == 19 || mode == 20 || mode == 27 || mode == 28) { return 256; }
        return root.max-steps;
    }
    pure function pulses-max(mode: int) -> float {
        if (mode == 5) { return 3; }     // Mozart dice per bar
        if (mode == 7) { return 15; }    // cellular generation
        if (mode == 11) { return 2; }    // sieve union terms
        if (mode == 17) { return 16; }   // acid motif length
        if (mode == 25 || mode == 26) { return 4; } // chord tones
        if (mode == 27) { return 5; }    // Hilbert order
        if (mode == 29) { return 64; }   // Life warm-up generations
        return root.cells;
    }
    pure function pulse-label(mode: int) -> string {
        if (mode == 1) { return "Ruler order"; }
        if (mode == 2) { return "Target hits"; }
        if (mode == 3) { return "Degree"; }
        if (mode == 4) { return "Requested hits"; }
        if (mode == 5) { return "Dice per bar"; }
        if (mode == 6) { return "Triad span"; }
        if (mode == 7) { return "Generation"; }
        if (mode == 8) { return "Walk activity"; }
        if (mode == 9) { return "Requested hits"; }
        if (mode == 10) { return "Grammar cutoff"; }
        if (mode == 11) { return "Sieve terms"; }
        if (mode == 12) { return "Slope"; }
        if (mode == 13) { return "Onset chance"; }
        if (mode == 14) { return "Notes"; }
        if (mode == 15) { return "Notes"; }
        if (mode == 16) { return "Notes"; }
        if (mode == 17) { return "Motif length"; }
        if (mode == 18) { return "Register bits"; }
        if (mode == 19 || mode == 20 || mode == 21 || mode == 22 || mode == 23 || mode == 24 || mode == 28) { return "Target hits"; }
        if (mode == 25 || mode == 26) { return "Chord tones"; }
        if (mode == 27) { return "Order"; }
        if (mode == 29) { return "Warm-up"; }
        return "Pulses";
    }
    pure function density-label(mode: int) -> string {
        if (mode == 2) { return "Growth (r)"; }
        if (mode == 8) { return "Leapiness"; }
        if (mode == 13) { return "Onset chance"; }
        if (mode == 14 || mode == 15) { return "Root bias"; }
        if (mode == 16) { return "Leapiness"; }
        if (mode == 21) { return "Step size"; }
        if (mode == 22) { return "Tail weight"; }
        if (mode == 23) { return "Map μ"; }
        if (mode == 24) { return "Chaos a"; }
        if (mode == 25 || mode == 27) { return "Gate"; }
        if (mode == 26) { return "Approach"; }
        if (mode == 29) { return "Cell density"; }
        return "Density";
    }
    pure function phase-label(mode: int) -> string {
        if (mode == 4) { return "Coupling"; }
        if (mode == 8) { return "Step/leap"; }
        if (mode == 17) { return "Mutation"; }
        if (mode == 18) { return "Register flip"; }
        if (mode == 19 || mode == 20) { return "Run offset"; }
        if (mode == 21 || mode == 22) { return "Drift"; }
        if (mode == 23 || mode == 24) { return "Initial x"; }
        if (mode == 25 || mode == 26) { return "Direction"; }
        if (mode == 27) { return "Rotation"; }
        return "Osc phase";
    }
    pure function osc-label(mode: int) -> string {
        if (mode == 8) { return "Leap bias"; }
        return "Osc cycles";
    }
    pure function ca-label(mode: int) -> string {
        if (mode == 11) { return "Sieve moduli"; }
        if (mode == 29) { return "Rule"; }
        return "CA rule";
    }
    pure function life-rule-name(value: float) -> string {
        let r = Math.mod(Math.round(value), 5);
        if (r == 1) { return "HighLife"; }
        if (r == 2) { return "Seeds"; }
        if (r == 3) { return "Day & Night"; }
        if (r == 4) { return "Dense"; }
        return "Life";
    }
    pure function regen-label(mode: int) -> string {
        return "Regenerate after (lengths, 0=off)";
    }
    property <[string]> mode-names: [
        "Euclidean", "Golomb Ruler", "Logistic Map", "Eulerian Walk", "Arnold Circle Map",
        "Mozart Dice", "Tonnetz Walk", "Cellular Automaton", "Markov Walk", "Oscillator / Phase",
        "L-System Grammar", "Xenakis Sieve", "Fibonacci / Sturmian", "Bernoulli",
        "Acid Random", "Acid Euclid", "Acid Markov", "Acid Motif", "Acid Shift Register",
        "Thue-Morse", "Rudin-Shapiro", "Brownian Walk", "Lévy Flight", "Tent Map",
        "Hénon Map", "Arpeggiator", "Walking Bass", "Hilbert Curve", "Ulam Spiral Primes",
        "Life-like CA"
    ];
    property <[string]> mode-help: [
        "Places pulses as evenly as possible around the step ring, then walks the pitch contour by 1/φ per onset. Density thins the onsets; Seed and Phase move the whole necklace.",
        "Maps the marks of an optimal Golomb ruler onto the bar, so no inter-onset interval repeats. Gap length sets the pitch step, which gives the phrase its wide, non-metrical leaps.",
        "Iterates x[n+1] = r·x[n]·(1−x[n]) with r set by density. The highest orbit samples become onsets, but the pitch reads a delayed orbit value so peaks do not all become high notes.",
        "Builds a balanced digraph over a rest plus seven scale degrees, then walks every edge once with Hierholzer's algorithm. The circuit becomes a melody line; unused vertices read as rests.",
        "Runs the Arnold circle map θ' = θ + Ω − K/2π·sin(2πθ). Pure rotation gives a steady pulse; increasing coupling locks it into a repeating figure. The pitch follows the phase.",
        "Rolls one to three dice per bar and indexes a bank of eleven one-bar cells, Mozart-style. Each cell carries both a rhythm and a melodic shape.",
        "Walks P/L/R neo-Riemannian transforms on a Tonnetz lattice and arpeggiates each triad. The panel draws the triangles, so the harmonic path is visible while it plays.",
        "Runs Wolfram's Rule 30 on a ring, one row per generation. The selected generation becomes the rhythm and the neighbourhood sum becomes the pitch contour.",
        "A first-order Markov walk over rest and seven scale degrees. Density sets note activity and the oscillator knob sets leapiness; the panel draws the degree graph.",
        "Samples one of eight waveforms at each step. The waveform supplies the pitch contour while the requested hits are placed as a Euclidean rhythm, so the drawn curve is the melody's shape without clustering every onset at a peak.",
        "Rewrites a two-symbol grammar for up to twelve generations and reads the resulting word as contour and rhythm. A favours rising steps, B favours falling ones.",
        "Builds a Xenakis sieve M = (m₁,r₁) ∪ (m₂,r₂) \\ (m₃,r₃). Members become onsets; the residue class decides the pitch degree. Density keeps a fraction of the members.",
        "Generates a Sturmian word from an irrational slope and fires where floor((i+1)α) changes. The result is maximally even and the contour steps by the golden ratio.",
        "Flips an independent Bernoulli coin per step. Density is the onset probability and each onset gets a seeded pitch class, so the line is unstable by design.",
        "Picks exactly Pulses notes with a downbeat bias, then rolls a root-heavy scale degree for each. Accent, Slide and Octave are independent per-note flags.",
        "Notes are a Euclidean rhythm; accents, slides and octave jumps are nested Euclidean rhythms over those notes. Knobs only add or remove flags, never reshuffle the line.",
        "A two-state note/rest chain with the requested stationary density, plus a first-order pitch chain. Slides are more likely between close degrees.",
        "Rolls one short motif and repeats it. Phase mutates later repeats by flipping notes, re-pitching them or shifting an octave.",
        "A Turing-machine shift register feeds rhythm, scale degree, accent, slide and octave from separate bit fields. Phase controls how often the feedback bit flips.",
        "Thue-Morse: t(n) is the parity of the bits in n. Ones are candidates for onsets, the current run length shapes the contour, and Phase shifts the word.",
        "Rudin-Shapiro: the parity of overlapping 11 pairs in the binary index. Ones become onsets; run lengths and the index shape the contour.",
        "A reflected random walk. Density sets the step size, Phase adds drift, and the largest moves become onsets while the walk itself is the pitch contour.",
        "A reflected Lévy flight: mostly small steps with heavy-tailed jumps. Density controls how heavy the tail is; jumps are the onsets.",
        "The tent map x' = μ·min(x,1−x). Density raises μ toward chaos, Phase sets the initial x, and the orbit is the contour; pitch reads a delayed orbit value so peaks and notes are independent.",
        "The Hénon map x' = 1 − a·x² + y, y' = b·x, clamped to a safe box. Density sets a, Phase and Seed set the initial point; move size picks onsets and y is the pitch, so the attractor drives two independent readings.",
        "A one-note arpeggiator over scale degrees 1-3-5-7, so it follows the selected scale and tuning. Pulses chooses the chord size, Phase picks up/down/up-down/random and Density gates the steps.",
        "A walking bass over a dominant-seven chord: chord tones on strong steps and chromatic approach notes between them. Pulses is the chord size, Density the approach chance.",
        "Samples a Hilbert space-filling curve of order Pulses. The curve is the contour and the left-hand panel draws the 2-D path; Phase rotates it by quarter turns.",
        "Walks the Ulam square spiral and marks cells whose 1-based index is prime; the centre always sounds. Density thins the prime hits and the panel draws the spiral.",
        "Runs a Life-like cellular automaton on a 16×8 torus. Warm-up gives the population time to develop, Rule selects Life/HighLife/Seeds/Day & Night/Dense, and Symmetry picks the seed shape. Each step reads one column, so live rows become a scale degree and population drives accent."
    ];
    // `text` is the strip label, `number` the display value, `scale` converts back to parameter units.
    property <[Opt]> opts: [
        { label: "Steps", min: 1, max: Math.min(root.max-steps, root.steps-max(root.mode)), value: Math.min(root.steps, Math.min(root.max-steps, root.steps-max(root.mode))), text: root.round-steps ? "\{Math.round(Math.min(root.steps, root.steps-max(root.mode)))}" : "\{Math.round(Math.min(root.steps, root.steps-max(root.mode)) * 1000) / 1000}", step: root.round-steps ? 1 : 0.01, number: root.round-steps ? "\{Math.round(Math.min(root.steps, root.steps-max(root.mode)))}" : "\{Math.round(Math.min(root.steps, root.steps-max(root.mode)) * 1000) / 1000}", scale: 1 },
        { label: root.pulse-label(root.mode), min: 0, max: root.pulses-max(root.mode), value: Math.min(root.pulses, root.pulses-max(root.mode)), text: "\{Math.round(Math.min(root.pulses, root.pulses-max(root.mode)))}", step: 1, number: "\{Math.round(Math.min(root.pulses, root.pulses-max(root.mode)))}", scale: 1 },
        { label: "Rotate", min: 0, max: Math.max(root.cells - 1, 0), value: Math.min(root.rotate, Math.max(root.cells - 1, 0)), text: "\{Math.round(Math.min(root.rotate, Math.max(root.cells - 1, 0)))}", step: 1, number: "\{Math.round(Math.min(root.rotate, Math.max(root.cells - 1, 0)))}", scale: 1 },
        { label: root.density-label(root.mode), min: 0, max: 1, value: root.density, text: "\{Math.round(root.density * 100)}%", step: 0.01, number: "\{Math.round(root.density * 100)}", scale: 0.01 },
        { label: "Seed", min: 0, max: 1, value: root.seed, text: "\{Math.round(root.seed * 1000) / 1000}", step: 0.001, number: "\{Math.round(root.seed * 1000) / 1000}", scale: 1 },
        { label: root.phase-label(root.mode), min: 0, max: 1, value: root.phase, text: "\{Math.round(root.phase * 360)}°", step: 0.01, number: "\{Math.round(root.phase * 360)}", scale: 1.0 / 360.0 },
        { label: root.osc-label(root.mode), min: root.mode == 16 ? 1 : 0.125, max: root.mode == 16 ? 16 : 8, value: root.mode == 16 ? Math.max(root.osc-rate, 1) : root.osc-rate, text: root.mode == 16 ? "\{Math.round(Math.max(root.osc-rate, 1))}" : "\{Math.round(root.osc-rate * 100) / 100}", step: root.mode == 16 ? 1 : 0.125, number: root.mode == 16 ? "\{Math.round(Math.max(root.osc-rate, 1))}" : "\{Math.round(root.osc-rate * 100) / 100}", scale: 1 },
        { label: root.ca-label(root.mode), min: 0, max: 255, value: root.ca-rule, text: root.mode == 29 ? root.life-rule-name(root.ca-rule) : (root.mode == 16 ? "\{Math.round(root.ca-rule / 255 * 100)}%" : "\{Math.round(root.ca-rule)}"), step: 1, number: root.mode == 16 ? "\{Math.round(root.ca-rule / 255 * 100)}" : "\{Math.round(root.ca-rule)}", scale: root.mode == 16 ? 2.55 : 1 },
        { label: "Probability", min: 0, max: 1, value: root.probability, text: "\{Math.round(root.probability * 100)}%", step: 0.01, number: "\{Math.round(root.probability * 100)}", scale: 0.01 },
        { label: "Velocity", min: 0.01, max: 1, value: root.velocity, text: "\{Math.round(root.velocity * 100)}%", step: 0.01, number: "\{Math.round(root.velocity * 100)}", scale: 0.01 },
        { label: root.regen-label(root.mode), min: 0, max: 256, value: root.regenerate-every, text: "\{Math.round(root.regenerate-every)}", step: 1, number: "\{Math.round(root.regenerate-every)}", scale: 1 },
        { label: root.symmetry-label(root.mode), min: 1, max: 8, value: root.symmetry, text: root.symmetry-text(root.mode, root.symmetry), step: 1, number: "\{Math.round(root.symmetry)}", scale: 1 },
        { label: "Randomize after lengths", min: 0, max: 256, value: root.randomize-after-lengths, text: "\{Math.round(root.randomize-after-lengths)}", step: 1, number: "\{Math.round(root.randomize-after-lengths)}", scale: 1 },
        { label: "Swing", min: 0, max: 0.5, value: root.swing, text: "\{Math.round(root.swing * 300)}%", step: 0.01, number: "\{Math.round(root.swing * 300)}", scale: 1.0 / 300.0 },
        // Index 14 is the max-steps box in Settings, not a slider.
        { label: "Max steps", min: 64, max: 1024, value: root.max-steps, text: "\{Math.round(root.max-steps)}", step: 1, number: "\{Math.round(root.max-steps)}", scale: 1 },
        { label: "Slide", min: 0, max: 1, value: root.slide, text: "\{Math.round(root.slide * 100)}%", step: 0.01, number: "\{Math.round(root.slide * 100)}", scale: 0.01 },
        { label: "Accent", min: 0, max: 1, value: root.accent, text: "\{Math.round(root.accent * 100)}%", step: 0.01, number: "\{Math.round(root.accent * 100)}", scale: 0.01 },
        { label: "Octave jump", min: 0, max: 1, value: root.octave, text: "\{Math.round(root.octave * 100)}%", step: 0.01, number: "\{Math.round(root.octave * 100)}", scale: 0.01 }
    ];

    // One fixed 860x697 coordinate space; the matrix scrolls fixed-width cells, so nothing reflows.
    // Also the keyboard root: it owns focus at startup and maps window shortcuts.
    nav := FocusScope {
        width: root.base-width; height: root.base-height;
        init => { self.focus(); }
        key-pressed(event) => {
            if (root.handle-key(event.text)) { return accept; }
            reject
        }

        // Faint graph paper for Sketch; it sits below the layout so only gaps between cards show it.
        Rectangle {
            visible: root.theme-index == 0;
            for i in 38: Rectangle { y: (i + 1) * 20px; height: 1px; background: Theme.border.with-alpha(0.16); }
            for i in 43: Rectangle { x: (i + 1) * 20px; width: 1px; height: parent.height; background: Theme.border.with-alpha(0.16); }
        }
        // Sits behind the controls, so the pulse washes the interface background only.
        Rectangle {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            opacity: 0;
            background: @linear-gradient(135deg, Theme.c1 0%, Theme.c2 50%, Theme.c3 100%);
            states [
                pulse when root.regen-pulse: {
                    opacity: 0.16;
                    in { animate opacity { duration: root.reduce-motion ? 0ms : 70ms; easing: ease-out; } }
                    out { animate opacity { duration: root.reduce-motion ? 0ms : 450ms; easing: ease-in-out; } }
                }
            ]
        }
        regen-off-timer := Timer {
            interval: 120ms;
            running: false;
            triggered => { root.regen-pulse = false; }
        }
        Timer {
            interval: 4s;
            running: root.mod-status != "";
            triggered => { root.mod-status = ""; }
        }

    VerticalLayout {
        padding: 14px; spacing: 2px;
        HorizontalLayout {
            height: 34px; spacing: 6px;
            Text { text: "nelody seq"; color: Theme.text; font-size: Type.display; font-weight: 700; letter-spacing: 0.5px; vertical-alignment: center; }
            Text { visible: root.track-name != ""; text: "· \{root.track-name}"; color: Theme.text-muted; font-size: Type.caption; vertical-alignment: center; overflow: elide; }
            // Hover descriptions live in the bottom status strip, clear of the pointer.
            Rectangle { horizontal-stretch: 1; }
            Rectangle { width: 74px; height: 24px; border-radius: 4px; background: root.free-run ? Theme.c1.with-alpha(0.22) : Theme.control; Text { text: "free-run"; color: Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; } free-touch := TipTouch { hint: "Run the internal clock while the host transport is stopped"; clicked => { root.toggle-free-run(); } } }
            Text { text: root.free-run ? "FREE-RUN CLOCK: ON" : "SYNC: HOST TRANSPORT"; color: root.free-run ? Theme.c1 : Theme.text-muted; font-size: Type.caption; vertical-alignment: center; }
            Text { text: root.timing-summary; color: Theme.text-muted; font-size: Type.caption; vertical-alignment: center; overflow: elide; }
            Rectangle {
                width: 112px; height: 30px; border-radius: 5px; background: Theme.hi;
                border-width: generate-touch.has-hover ? 2px : 0px; border-color: Theme.c1;
                Text { text: root.generate-on ? "RE-GENERATE ↻" : "GENERATE ↻"; color: Theme.on-accent; font-size: Type.value; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                // The shared focus ring is the same hue as this fill, so the primary action carries
                // its own contrasting inset ring.
                if generate-touch.has-focus: Rectangle {
                    x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
                    border-radius: 3px; border-width: 1px; border-color: Theme.on-accent; background: transparent;
                }
                generate-touch := TipTouch { hint: "Create a new deterministic variation of the current line"; clicked => { root.generate-pressed(); } }
            }
            Rectangle { width: 112px; height: 30px; border-radius: 5px; background: randomize-touch.has-hover ? Theme.control-hover : Theme.control; Text { text: "RANDOMIZE ⚄"; color: Theme.text; font-size: Type.value; horizontal-alignment: center; vertical-alignment: center; } randomize-touch := TipTouch { hint: "Randomize the parameter groups enabled in RANDOMIZE SCOPE"; clicked => { root.randomize-pressed(); } } }
            Rectangle { width: 40px; height: 30px; border-radius: 5px; background: settings-touch.has-hover ? Theme.c2 : Theme.control; Text { text: "⚙"; color: settings-touch.has-hover ? Theme.on-accent : Theme.text; font-size: Type.glyph-large; horizontal-alignment: center; vertical-alignment: center; } settings-touch := TipTouch { hint: "Open settings: theme, presets, limits, export and credits"; clicked => { root.tuning-open = false; root.settings-open = !root.settings-open; if (root.settings-open) { root.matrix-open = false; } } } }
        }
        HorizontalLayout {
            // 300px fits the description and live math line without squeezing the sliders.
            height: 300px; spacing: 10px;
            ModePanel {
                nodes: root.view-nodes; edges: root.view-edges; fills: root.view-fills; solid: root.view-solid; slid: root.view-slid; jumped: root.view-jumped; lines: root.view-lines; hand: root.view-hand;
                reduce-motion: root.reduce-motion;
                xray-step: root.hover-step;
                xray-active: root.xray-active;
                probe-at(x, y) => { root.probe-at(x, y); }
            }
            VerticalLayout {
                vertical-stretch: 1;
                spacing: 3px; alignment: stretch;
                Rectangle {
                    height: 30px; border-radius: 4px;
                    background: mode-menu-touch.has-hover ? Theme.control-hover : Theme.control;
                    HorizontalLayout {
                        x: 8px; width: parent.width - 16px; height: parent.height; spacing: 6px;
                        Text { text: "MODE  ·  \{root.mode-names[root.mode]}"; color: Theme.c1; font-size: Type.title; font-weight: 700; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: "▾"; color: Theme.c1; font-size: Type.title; font-weight: 700; vertical-alignment: center; }
                    }
                    mode-menu-touch := TipTouch {
                        hint: "Open the grouped generator list; scroll the header to step modes";
                        clicked => { root.tuning-open = false; root.settings-open = false; root.mode-menu-open = !root.mode-menu-open; }
                        // Hovering the mode header and scrolling steps the list; the open list scrolls.
                        scroll-event(e) => {
                            if (e.delta-y != 0px) {
                                root.step-mode(e.delta-y > 0px ? 1 : -1);
                                accept
                            } else {
                                reject
                            }
                        }
                    }
                }
                Text { text: root.mode-help[root.mode]; color: Theme.text; font-size: Type.body; horizontal-alignment: left; wrap: word-wrap; }
                // The live generator formula sits between the prose description and the controls.
                Text { height: 16px; text: root.mode-math; color: Theme.text-muted; font-size: Type.value; font-italic: true; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                Rectangle { height: 4px; }
                HorizontalLayout { spacing: 5px;
                    OptSlider { opt: root.opts[0]; index: 0; mod-target: 0; changed(v) => { root.set-opt(0, v); } }
                    if root.shows-param(root.mode, 1): OptSlider { opt: root.opts[1]; index: 1; mod-target: 1; changed(v) => { root.set-opt(1, v); } }
                    OptSlider { opt: root.opts[2]; index: 2; mod-target: 2; changed(v) => { root.set-opt(2, v); } }
                    OptSlider { opt: root.opts[3]; index: 3; mod-target: 3; changed(v) => { root.set-opt(3, v); } }
                }
                HorizontalLayout {
                    spacing: 5px;
                    OptSlider { opt: root.opts[4]; index: 4; mod-target: 4; changed(v) => { root.set-opt(4, v); } }
                    if root.shows-param(root.mode, 5): OptSlider { opt: root.opts[5]; index: 5; mod-target: 5; changed(v) => { root.set-opt(5, v); } }
                    if root.shows-param(root.mode, 6): OptSlider { opt: root.opts[6]; index: 6; mod-target: 6; changed(v) => { root.set-opt(6, v); } }
                    if root.shows-param(root.mode, 7): OptSlider { opt: root.opts[7]; index: 7; mod-target: 7; changed(v) => { root.set-opt(7, v); } }
                }
                HorizontalLayout { spacing: 5px;
                    OptSlider { opt: root.opts[8]; index: 8; mod-target: 8; changed(v) => { root.set-opt(8, v); } }
                    // Feel row: velocity, gate and swing share the space beside probability.
                    OptSlider { width: 100px; opt: root.opts[9]; index: 9; mod-target: 11; changed(v) => { root.set-opt(9, v); } }
                    OptSlider {
                        width: 82px; index: 40; mod-target: 10;
                        opt: { label: "Gate", min: 0.02, max: 1, value: root.gate, text: "\{Math.round(root.gate * 100)}%", step: 0.01, number: "\{Math.round(root.gate * 100)}", scale: 0.01 };
                        changed(v) => { root.set-opt(24, v); }
                    }
                    OptSlider { width: 100px; opt: root.opts[13]; index: 13; mod-target: 9; changed(v) => { root.set-opt(13, v); } }
                }
                // Symmetry is not in nelody's ModTarget list, so it registers no modulation target.
                if root.shows-param(root.mode, 11): HorizontalLayout { spacing: 5px;
                    OptSlider { opt: root.opts[11]; index: 11; mod-target: -1; changed(v) => { root.set-opt(11, v); } }
                }
                if root.mode == 9: HorizontalLayout {
                    WavePicker {
                        width: 126px;
                        paths: root.wave-paths; names: root.wave-names; current: root.osc-wave;
                        selected(i) => { root.set-osc-wave(i); }
                        opened(x, y) => { root.wave-menu-target = 0; root.wave-menu-x = x; root.wave-menu-y = y; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                // Markov transition bias packs four 2-bit fields: rest, repeat, role and novelty.
                if root.mode == 8: HorizontalLayout {
                    height: 25px; spacing: 5px;
                    OptSlider {
                        width: 170px; index: 41;
                        hint: "Markov bias: rest, repeat, role-compatible movement and novelty (2 bits each)";
                        opt: { label: "Transition bias", min: 0, max: 255, value: root.markov-bias, text: "\{Math.round(root.markov-bias)}", step: 1, number: "\{Math.round(root.markov-bias)}", scale: 1 };
                        changed(v) => { root.set-markov-bias(v); }
                    }
                    Text { horizontal-stretch: 1; text: "rest · repeat · role · novelty (2 bits each)"; color: Theme.text-muted; font-size: Type.caption; vertical-alignment: center; overflow: elide; }
                }
                // Acid controls stay in the generator column, below the shared option rows.
                if root.mode >= 14: Rectangle { height: 4px; }
                if root.mode >= 14: HorizontalLayout {
                    height: 28px; spacing: 5px;
                    Text { text: "ACID"; color: Theme.text-muted; font-size: Type.caption; font-weight: 700; letter-spacing: 0.5px; vertical-alignment: center; }
                    OptSlider { horizontal-stretch: 1; opt: root.opts[15]; index: 15; mod-target: 14; changed(v) => { root.set-opt(15, v); } }
                    OptSlider { horizontal-stretch: 1; opt: root.opts[16]; index: 16; mod-target: 15; changed(v) => { root.set-opt(16, v); } }
                    OptSlider { horizontal-stretch: 1; opt: root.opts[17]; index: 17; mod-target: 16; changed(v) => { root.set-opt(17, v); } }
                }
                // Tuning follows the acid row inside the parameter column, above the MIDI history.
                // The stretch spacer keeps the tuning block against the history card.
                Rectangle { vertical-stretch: 1; }
                Text {
                    height: 12px; text: "TUNING"; color: Theme.text-muted;
                    font-size: Type.caption; vertical-alignment: center;
                }
                // Root, Scale, Octave and NTS share one equal-width row; EDO joins it only for
                // Equal (EDO), so a five-control tuning block still fits the fixed 300px column.
                HorizontalLayout {
                    height: 28px; spacing: 5px;
                    tuning-root := NumBox { horizontal-stretch: 1; height: 28px; label: "ROOT"; hint: "Root pitch class, 0 = C"; value: root.root-pc; minimum: 0; maximum: 11; step: 1; mod-target: 17; changed(v) => { root.set-opt(18, v); } }
                    // The chip shows the current scale and opens a dropdown under itself.
                    scale-chip := TuningChip { horizontal-stretch: 1; label: root.edo-active ? "" : "SCALE"; hint: "Choose a scale or tuning table"; value: root.tuning-name + "  ▾"; centered: true; active: root.tuning-open; wheel-cycles: false; cycled => { root.tuning-open = !root.tuning-open; root.settings-open = false; root.mode-menu-open = false; } }
                    // EDO applies to Equal (EDO) only. It sits beside the scale chip and collapses
                    // to zero width when inactive, so `text-focused` can still see its editor.
                    edo-row := NumBox {
                        visible: root.edo-active;
                        horizontal-stretch: 1; min-width: 0px;
                        max-width: root.edo-active ? 1000px : 0px;
                        height: 28px; label: "EDO"; hint: "Equal divisions per octave, used by the Equal (EDO) table"; value: root.edo;
                        minimum: 1; maximum: 72; step: 1; mod-target: 20;
                        changed(v) => { root.set-opt(21, v); }
                    }
                    tuning-oct := NumBox { horizontal-stretch: 1; height: 28px; label: "OCT"; hint: "Octave span used by the generator"; value: root.octaves; minimum: 1; maximum: 6; step: 1; mod-target: 18; changed(v) => { root.set-opt(19, v); } }
                    TuningChip { horizontal-stretch: 1; label: "NTS"; hint: "Send non-12-TET pitch as MIDI pitch bend"; value: root.nts-on ? "BEND" : "OFF"; active: root.nts-on; cycled => { root.toggle-nts(); } }
                }
            }
        }
        Rectangle {
            min-height: 187px; max-height: 460px; vertical-stretch: 1; border-radius: 4px;
            background: Theme.surface; border-width: 1px; border-color: Theme.border;
            clip: true;
            property <bool> roll-hover: history-touch.has-hover;
            changed roll-hover => {
                if (!roll-hover) {
                    root.hover-step = -1;
                    root.xray-hover(-1);
                }
            }
            Path { x: 58px; y: 0px; width: parent.width - 62px; height: parent.height; viewbox-x: root.history-vb-x; viewbox-y: root.history-vb-y; viewbox-width: root.history-vb-w; viewbox-height: root.history-vb-h; commands: root.history-bg; fill: Theme.cell-off.with-alpha(0.55); }
            Path { x: 58px; y: 0px; width: parent.width - 62px; height: parent.height; viewbox-x: root.history-vb-x; viewbox-y: root.history-vb-y; viewbox-width: root.history-vb-w; viewbox-height: root.history-vb-h; commands: root.history-bg-bars; fill: Theme.hi.with-alpha(0.055); }
            Path { x: 58px; y: 0px; width: parent.width - 62px; height: parent.height; viewbox-x: root.history-vb-x; viewbox-y: root.history-vb-y; viewbox-width: root.history-vb-w; viewbox-height: root.history-vb-h; commands: root.history-grid-steps; fill: transparent; stroke: Theme.text-muted.with-alpha(0.18); stroke-width: 0.5px / root.history-zoom-x; }
            Path { x: 58px; y: 0px; width: parent.width - 62px; height: parent.height; viewbox-x: root.history-vb-x; viewbox-y: root.history-vb-y; viewbox-width: root.history-vb-w; viewbox-height: root.history-vb-h; commands: root.history-grid-beats; fill: transparent; stroke: Theme.text-muted.with-alpha(0.34); stroke-width: 0.65px / root.history-zoom-x; }
            Path { x: 58px; y: 0px; width: parent.width - 62px; height: parent.height; viewbox-x: root.history-vb-x; viewbox-y: root.history-vb-y; viewbox-width: root.history-vb-w; viewbox-height: root.history-vb-h; commands: root.history-grid-bars; fill: transparent; stroke: Theme.text-muted.with-alpha(0.62); stroke-width: 0.95px / root.history-zoom-x; }
            Path { x: 58px; y: 0px; width: parent.width - 62px; height: parent.height; viewbox-x: root.history-vb-x; viewbox-y: root.history-vb-y; viewbox-width: root.history-vb-w; viewbox-height: root.history-vb-h; commands: root.history-grid; fill: transparent; stroke: Theme.text-muted.with-alpha(0.22); stroke-width: 0.6px / root.history-zoom-x; }
            // Velocity layers: width = gate/length, brightness = velocity/accent.
            Path { x: 58px; y: 0px; width: parent.width - 62px; height: parent.height; viewbox-x: root.history-vb-x; viewbox-y: root.history-vb-y; viewbox-width: root.history-vb-w; viewbox-height: root.history-vb-h; commands: root.history-notes; fill: Theme.c1.with-alpha(0.80); }
            Path { x: 58px; y: 0px; width: parent.width - 62px; height: parent.height; viewbox-x: root.history-vb-x; viewbox-y: root.history-vb-y; viewbox-width: root.history-vb-w; viewbox-height: root.history-vb-h; commands: root.history-notes-mid; fill: Theme.c1.with-alpha(0.90); }
            Path { x: 58px; y: 0px; width: parent.width - 62px; height: parent.height; viewbox-x: root.history-vb-x; viewbox-y: root.history-vb-y; viewbox-width: root.history-vb-w; viewbox-height: root.history-vb-h; commands: root.history-notes-hard; fill: Theme.c1; }
            // Outline-only so the recorded notes stay readable underneath.
            if root.history-overlay-on: Path { x: 58px; y: 0px; width: parent.width - 62px; height: parent.height; viewbox-x: root.history-vb-x; viewbox-y: root.history-vb-y; viewbox-width: root.history-vb-w; viewbox-height: root.history-vb-h; commands: root.history-pattern; fill: transparent; stroke: Theme.c3.with-alpha(0.9); stroke-width: 1px / root.history-zoom-x; }
            if root.history-overlay-on: Path { x: 58px; y: 0px; width: parent.width - 62px; height: parent.height; viewbox-x: root.history-vb-x; viewbox-y: root.history-vb-y; viewbox-width: root.history-vb-w; viewbox-height: root.history-vb-h; commands: root.history-pattern-slides; fill: transparent; stroke: Theme.c2.with-alpha(0.85); stroke-width: 1.2px / root.history-zoom-x; }
            Path { x: 58px; y: 0px; width: parent.width - 62px; height: parent.height; viewbox-x: root.history-vb-x; viewbox-y: root.history-vb-y; viewbox-width: root.history-vb-w; viewbox-height: root.history-vb-h; commands: root.history-probe; fill: Theme.hi.with-alpha(0.22); stroke: Theme.hi; stroke-width: 1.5px / root.history-zoom-x; }
            // Pitch ruler in the gutter below the edit buttons. Labels follow the viewbox so they
            // stay attached to their octave line while the roll is zoomed or panned.
            for i in root.history-ruler.length: Text {
                x: 4px; width: 50px; height: 10px;
                y: ((root.history-hi - 1 - (root.history-lo + i * 12) + 0.5)
                    * (200.0 / Math.max(root.history-hi - root.history-lo, 1))
                    - root.history-vb-y) / Math.max(root.history-vb-h, 1.0) * parent.height - 10px;
                visible: self.y >= 82px && self.y <= parent.height - 10px;
                text: root.history-ruler[i];
                color: Theme.text-muted; font-size: Type.dense;
                horizontal-alignment: right; vertical-alignment: center;
            }
            // Playhead at the newest edge ("now"). It leaves the frame once the view is panned
            // back through the history.
            Rectangle {
                visible: root.playhead-x >= 0.0 && root.playhead-x <= 1.0;
                x: 58px + root.playhead-x * (parent.width - 62px) - 1px;
                y: 0px; width: 2px; height: parent.height;
                background: Theme.hi.with-alpha(0.85);
            }
            Path {
                visible: root.playhead-x >= 0.0 && root.playhead-x <= 1.0;
                x: 58px + root.playhead-x * (parent.width - 62px) - 3px;
                y: 0px; width: 6px; height: 5px;
                commands: "M0 0 L6 0 L3 5 Z";
                fill: Theme.hi;
            }
            history-touch := TipTouch {
                // Leave a 14px gutter for the vertical scrollbar: its drag must never compete
                // with the note editor, especially in NOTES/ADV edit mode.
                x: 58px; y: 0px; width: parent.width - 76px; height: parent.height;
                hint: root.edit-mode == 1
                    ? "Click a step to toggle hit; drag horizontally to set its gate"
                    : (root.edit-mode > 1
                        ? "Click a step column to apply the selected attribute"
                        : (root.history-running
                            ? "Live: the roll follows the clock automatically; press EDIT to freeze it"
                            : "Clock stopped: drag to inspect; press EDIT to change steps"));
                pointer-event(e) => {
                    let sx = history-touch.mouse-x / Math.max(history-touch.width, 1px);
                    let cx = (root.history-vb-x + sx * root.history-vb-w) / 800.0;
                    if (e.kind == PointerEventKind.move) {
                        let phase = Math.max(0.0, Math.min(1.0, cx));
                        let step = Math.max(0, Math.min(Math.floor(root.steps) - 1,
                            Math.floor(phase * root.steps)));
                        root.hover-step = step;
                        root.xray-hover(step);
                    }
                    if (root.edit-mode == 1) {
                        // One mode: tap toggles the hit, a horizontal drag resizes the length.
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left && history-touch.mouse-y > 30px) {
                            root.notes-press = true;
                            root.notes-dragging = false;
                            root.notes-start-x = history-touch.mouse-x;
                            root.notes-cx = cx;
                        } else if (e.kind == PointerEventKind.move && root.notes-press) {
                            if (Math.abs(history-touch.mouse-x - root.notes-start-x) > 6px) {
                                if (!root.notes-dragging) {
                                    root.notes-dragging = true;
                                    root.history-gate-dragging = true;
                                    root.edit-gate(cx, root.gate-snap-unit(), 0);
                                } else {
                                    root.edit-gate(cx, root.gate-snap-unit(), 1);
                                }
                            }
                        } else if ((e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) && root.notes-press) {
                            if (root.notes-dragging) {
                                root.edit-gate(cx, root.gate-snap-unit(), 2);
                            } else {
                                root.edit-overlay(root.notes-cx, 1);
                            }
                            root.notes-press = false;
                            root.notes-dragging = false;
                            root.history-gate-dragging = false;
                        }
                    } else if (root.edit-mode > 1) {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left && history-touch.mouse-y > 30px) {
                            root.edit-overlay(cx, root.edit-mode);
                        }
                    } else {
                        // No edit mode: pan only while the clock is stopped. While running, the
                        // roll follows automatically and ignores horizontal drags.
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left && !root.history-running) {
                            root.history-pan-drag = true;
                            root.history-pan-axis = 1;
                            root.history-pan-start = root.history-pan-x;
                            root.history-pan-mouse = history-touch.mouse-x;
                        } else if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                            root.history-pan-drag = true;
                            root.history-pan-axis = 2;
                            root.history-pan-y-start = root.history-pan-y;
                            root.history-pan-mouse-y = history-touch.mouse-y;
                        } else if (e.kind == PointerEventKind.move && root.history-pan-drag) {
                            if (root.history-pan-axis == 1) {
                                let dx = (history-touch.mouse-x - root.history-pan-mouse) / Math.max(history-touch.width, 1px);
                                root.history-pan-x = Math.max(0.0, Math.min(1.0, root.history-pan-start + dx));
                            } else if (root.history-pan-axis == 2) {
                                let dy = (history-touch.mouse-y - root.history-pan-mouse-y) / Math.max(history-touch.height, 1px);
                                root.history-pan-y = Math.max(0.0, Math.min(1.0, root.history-pan-y-start + dy));
                            }
                        } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                            root.history-pan-drag = false;
                            root.history-pan-axis = 0;
                        }
                    }
                }
                scroll-event(e) => {
                    // Wheel scrolls vertically; Alt (or Shift) turns it into horizontal panning.
                    // Trackpads that already report delta-x pan horizontally without a modifier.
                    if ((e.modifiers.alt || e.modifiers.shift) && (e.delta-x != 0px || e.delta-y != 0px)) {
                        let d = e.delta-x != 0px ? e.delta-x : e.delta-y;
                        if (root.history-zoom-x > 1.0 && !root.history-running && root.edit-mode == 0) {
                            root.history-pan-x = Math.max(0.0, Math.min(1.0, root.history-pan-x + (d > 0px ? 0.04 : -0.04)));
                            accept
                        } else if (root.history-zoom-y > 1.0) {
                            // Horizontal panning is locked while editing; Alt+wheel should still
                            // be useful, so fall back to the vertical viewport.
                            root.history-pan-y = Math.max(0.0, Math.min(1.0, root.history-pan-y + (d < 0px ? 0.04 : -0.04)));
                            accept
                        } else {
                            reject
                        }
                    } else if (e.delta-x != 0px) {
                        if (root.history-zoom-x > 1.0 && !root.history-running && root.edit-mode == 0) {
                            root.history-pan-x = Math.max(0.0, Math.min(1.0, root.history-pan-x + (e.delta-x > 0px ? 0.04 : -0.04)));
                            accept
                        } else {
                            reject
                        }
                    } else if (e.delta-y != 0px) {
                        if (root.history-zoom-y > 1.0) {
                            root.history-pan-y = Math.max(0.0, Math.min(1.0, root.history-pan-y + (e.delta-y < 0px ? 0.04 : -0.04)));
                            accept
                        } else {
                            reject
                        }
                    } else {
                        reject
                    }
                }
            }
            // Edit toolbar sits above the roll, so it never consumes layout height.
            if !root.timing-locked && root.edit-mode == 0: Rectangle {
                x: 8px; y: 8px; width: 50px; height: 24px; border-radius: 3px;
                background: edit-open-touch.has-hover ? Theme.c2 : Theme.control.with-alpha(0.92);
                border-width: 1px; border-color: Theme.border;
                Text { width: parent.width; height: parent.height; text: "EDIT"; color: edit-open-touch.has-hover ? Theme.on-accent : Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; }
                edit-open-touch := TipTouch {
                    hint: "Tap a step to toggle a hit, drag to resize its gate; ADV shows probability, accent, ratchet and timing";
                    clicked => { root.edit-advanced = false; root.edit-mode = 1; }
                }
            }
            // Performance edits sit under the EDIT button with the same compact button design.
            Rectangle {
                x: 8px; y: 36px; width: 50px; height: 24px; border-radius: 3px;
                background: root.mirror-on ? Theme.c3 : (mirror-touch.has-hover ? Theme.control-hover : Theme.control.with-alpha(0.92));
                border-width: 1px; border-color: Theme.border;
                Text { width: parent.width; height: parent.height; text: "MIRROR"; color: root.mirror-on ? Theme.on-accent : Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; }
                mirror-touch := TipTouch { hint: "Mirror the finished line backwards"; clicked => { root.toggle-mirror(); } }
            }
            Rectangle {
                x: 8px; y: 64px; width: 50px; height: 24px; border-radius: 3px;
                background: root.invert-on ? Theme.c2 : (invert-touch.has-hover ? Theme.control-hover : Theme.control.with-alpha(0.92));
                border-width: 1px; border-color: Theme.border;
                Text { width: parent.width; height: parent.height; text: "INVERT"; color: root.invert-on ? Theme.on-accent : Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; }
                invert-touch := TipTouch { hint: "Invert every hit and rest in the finished line"; clicked => { root.toggle-invert(); } }
            }
            if !root.timing-locked && root.edit-mode > 0: HorizontalLayout {
                x: 8px; y: 6px; height: 22px; spacing: 3px;
                Rectangle {
                    width: 44px; height: 24px; border-radius: 3px;
                    background: root.edit-mode == 1 ? Theme.c1 : Theme.control.with-alpha(0.92);
                    Text { width: parent.width; height: parent.height; text: "NOTES"; color: root.edit-mode == 1 ? Theme.on-accent : Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; }
                    notes-edit := TipTouch { hint: "Tap to toggle a hit; drag to resize its gate"; clicked => { root.edit-mode = root.edit-mode == 1 ? 0 : 1; } }
                }
                Rectangle {
                    width: 30px; height: 24px; border-radius: 3px;
                    background: root.edit-advanced ? Theme.c2 : Theme.control.with-alpha(0.92);
                    Text { width: parent.width; height: parent.height; text: "ADV"; color: root.edit-advanced ? Theme.on-accent : Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; }
                    adv-edit := TipTouch { hint: "Show probability, accent, ratchet, timing and clear modes"; clicked => { root.edit-advanced = !root.edit-advanced; } }
                }
                if root.edit-advanced: Rectangle {
                    width: 34px; height: 24px; border-radius: 3px;
                    background: root.edit-mode == 2 ? Theme.c2 : Theme.control.with-alpha(0.92);
                    Text { width: parent.width; height: parent.height; text: "PROB"; color: root.edit-mode == 2 ? Theme.on-accent : Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; }
                    prob-edit := TipTouch { hint: "Cycle this step's hit probability"; clicked => { root.edit-mode = root.edit-mode == 2 ? 1 : 2; } }
                }
                if root.edit-advanced: Rectangle {
                    width: 34px; height: 24px; border-radius: 3px;
                    background: root.edit-mode == 3 ? Theme.c3 : Theme.control.with-alpha(0.92);
                    Text { width: parent.width; height: parent.height; text: "ACC"; color: root.edit-mode == 3 ? Theme.on-accent : Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; }
                    acc-edit := TipTouch { hint: "Cycle this step's accent"; clicked => { root.edit-mode = root.edit-mode == 3 ? 1 : 3; } }
                }
                if root.edit-advanced: Rectangle {
                    width: 30px; height: 24px; border-radius: 3px;
                    background: root.edit-mode == 5 ? Theme.c1 : Theme.control.with-alpha(0.92);
                    Text { width: parent.width; height: parent.height; text: "RAT"; color: root.edit-mode == 5 ? Theme.on-accent : Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; }
                    rat-edit := TipTouch { hint: "Cycle 1-4 ratchet substeps on this step"; clicked => { root.edit-mode = root.edit-mode == 5 ? 1 : 5; } }
                }
                if root.edit-advanced: Rectangle {
                    width: 34px; height: 24px; border-radius: 3px;
                    background: root.edit-mode == 6 ? Theme.c3 : Theme.control.with-alpha(0.92);
                    Text { width: parent.width; height: parent.height; text: "TIME"; color: root.edit-mode == 6 ? Theme.on-accent : Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; }
                    time-edit := TipTouch { hint: "Delay this step by 0, 1/8, 1/4 or 1/2 step"; clicked => { root.edit-mode = root.edit-mode == 6 ? 1 : 6; } }
                }
                if root.edit-advanced: Rectangle {
                    width: 30px; height: 24px; border-radius: 3px;
                    background: root.edit-mode == 4 ? Theme.hi : Theme.control.with-alpha(0.92);
                    Text { width: parent.width; height: parent.height; text: "CLR"; color: root.edit-mode == 4 ? Theme.on-accent : Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; }
                    clr-edit := TipTouch { hint: "Clear every manual edit on this step"; clicked => { root.edit-mode = root.edit-mode == 4 ? 1 : 4; } }
                }
                Rectangle {
                    width: 40px; height: 24px; border-radius: 3px;
                    background: Theme.control.with-alpha(0.92);
                    Text { width: parent.width; height: parent.height; text: root.gate-snap-index == 0 ? "1/4" : (root.gate-snap-index == 1 ? "1/2" : (root.gate-snap-index == 2 ? "3/4" : "1")); color: Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; }
                    gate-snap-edit := TipTouch { hint: "Gate snap: click to cycle 1/4, 1/2, 3/4 or 1 step"; clicked => { root.gate-snap-index = Math.mod(root.gate-snap-index + 1, 4); } }
                }
                Rectangle {
                    width: 34px; height: 24px; border-radius: 3px;
                    background: Theme.control.with-alpha(0.92);
                    Text { width: parent.width; height: parent.height; text: "UNDO"; color: Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; }
                    undo-edit := TipTouch { hint: "Undo the last step edit"; clicked => { root.undo-edit(); } }
                }
                Rectangle {
                    width: 34px; height: 24px; border-radius: 3px;
                    background: Theme.control.with-alpha(0.92);
                    Text { width: parent.width; height: parent.height; text: "REDO"; color: Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; }
                    redo-edit := TipTouch { hint: "Redo the last undone step edit"; clicked => { root.redo-edit(); } }
                }
                Rectangle {
                    width: 48px; height: 24px; border-radius: 3px;
                    background: Theme.control.with-alpha(0.92);
                    Text { width: parent.width; height: parent.height; text: "CLR ALL"; color: Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; }
                    all-edit := TipTouch { hint: "Clear every manual step edit"; clicked => { root.clear-edits(); } }
                }
            }
            // Compact legend stays visible; hover text now lives in the bottom strip.
            if root.edit-mode == 0: Rectangle {
                x: 60px; y: 8px; width: parent.width - 190px; height: 22px;
                border-radius: 3px; background: Theme.surface.with-alpha(0.88);
                border-width: 1px; border-color: Theme.border;
                Text { x: 8px; width: parent.width - 16px; height: parent.height; text: "MIDI HISTORY  ·  right → left  ·  \{root.history-range}  ·  \{root.history-timing}"; color: Theme.text-muted; font-size: Type.caption; vertical-alignment: center; overflow: elide; }
            }
            // Zoom / fit controls sit in the left gutter, below NOTE/MIRROR/INVERT.
            HorizontalLayout {
                x: 8px; y: parent.height - 34px; height: 24px; spacing: 3px;
                Rectangle {
                    width: 24px; height: 24px; border-radius: 3px;
                    background: zoom-out-history.has-hover ? Theme.control-hover : Theme.control.with-alpha(0.92);
                    Text { width: parent.width; height: parent.height; text: "−"; color: Theme.text; font-size: Type.glyph; horizontal-alignment: center; vertical-alignment: center; }
                    zoom-out-history := TipTouch { hint: "Zoom the MIDI roll out"; clicked => { root.zoom-history(0.8); } }
                }
                Rectangle {
                    width: 24px; height: 24px; border-radius: 3px;
                    background: zoom-in-history.has-hover ? Theme.control-hover : Theme.control.with-alpha(0.92);
                    Text { width: parent.width; height: parent.height; text: "+"; color: Theme.text; font-size: Type.glyph; horizontal-alignment: center; vertical-alignment: center; }
                    zoom-in-history := TipTouch { hint: "Zoom the MIDI roll in"; clicked => { root.zoom-history(1.25); } }
                }
                Rectangle {
                    width: 30px; height: 24px; border-radius: 3px;
                    background: fit-history.has-hover ? Theme.control-hover : Theme.control.with-alpha(0.92);
                    Text { width: parent.width; height: parent.height; text: "FIT"; color: Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; }
                    fit-history := TipTouch { hint: "Fit the whole history window"; clicked => { root.fit-history(); } }
                }
            }
            // Slim scrollbars: horizontal at the bottom, vertical on the right. The tracks are
            // wider than the visible 3px bar so they are easy to grab; drag either thumb or click
            // a track position to pan the roll.
            Rectangle {
                visible: root.history-zoom-x > 1.0;
                x: 58px; y: parent.height - 5px; width: parent.width - 96px; height: 3px; border-radius: 2px;
                background: Theme.border.with-alpha(0.35);
                Rectangle {
                    property <length> thumb-w: Math.min(parent.width, parent.width / root.history-zoom-x);
                    property <length> travel: Math.max(0px, parent.width - self.thumb-w);
                    x: (root.history-running || root.history-editing) ? self.travel : self.travel * root.history-pan-x;
                    width: self.thumb-w; height: parent.height; border-radius: 2px;
                    background: Theme.c1.with-alpha(0.65);
                }
            }
            hscroll-touch := TouchArea {
                visible: root.history-zoom-x > 1.0;
                x: 58px; y: parent.height - 10px; width: parent.width - 96px; height: 12px;
                scroll-event(e) => {
                    let d = e.delta-x != 0px ? e.delta-x : e.delta-y;
                    if (d != 0px && !root.history-running && root.edit-mode == 0) {
                        root.history-pan-x = Math.max(0.0, Math.min(1.0, root.history-pan-x + (d > 0px ? 0.04 : -0.04)));
                        accept
                    } else {
                        reject
                    }
                }
                pointer-event(e) => {
                    let track-w = Math.max(1px, hscroll-touch.width);
                    let thumb-w = Math.min(track-w, track-w / Math.max(1.0, root.history-zoom-x));
                    let travel = Math.max(1px, track-w - thumb-w);
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                        if (!root.history-running && root.edit-mode == 0) {
                            // Click anywhere on the track to centre the thumb there, then drag.
                            let target = hscroll-touch.mouse-x - thumb-w * 0.5;
                            root.history-pan-x = Math.max(0.0, Math.min(1.0, target / travel));
                            root.history-scroll-drag-axis = 1;
                            root.history-scroll-drag-start = root.history-pan-x;
                            root.history-scroll-drag-x = hscroll-touch.mouse-x;
                        }
                    } else if (e.kind == PointerEventKind.move && root.history-scroll-drag-axis == 1) {
                        let dx = hscroll-touch.mouse-x - root.history-scroll-drag-x;
                        root.history-pan-x = Math.max(0.0, Math.min(1.0, root.history-scroll-drag-start + dx / travel));
                    } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                        if (root.history-scroll-drag-axis == 1) { root.history-scroll-drag-axis = 0; }
                    }
                }
            }
            Rectangle {
                visible: root.history-zoom-y > 1.0;
                x: parent.width - 8px; y: 30px; width: 3px; height: parent.height - 40px; border-radius: 2px;
                background: Theme.border.with-alpha(0.35);
                Rectangle {
                    property <length> thumb-h: Math.min(parent.height, parent.height / root.history-zoom-y);
                    property <length> travel: Math.max(0px, parent.height - self.thumb-h);
                    y: self.travel * root.history-pan-y;
                    height: self.thumb-h; width: parent.width; border-radius: 2px;
                    background: Theme.c1.with-alpha(0.65);
                }
            }
            vscroll-touch := TouchArea {
                visible: root.history-zoom-y > 1.0;
                x: parent.width - 14px; y: 30px; width: 14px; height: parent.height - 40px;
                scroll-event(e) => {
                    let d = e.delta-y != 0px ? e.delta-y : e.delta-x;
                    if (d != 0px) {
                        root.history-pan-y = Math.max(0.0, Math.min(1.0, root.history-pan-y + (d < 0px ? 0.04 : -0.04)));
                        accept
                    } else {
                        reject
                    }
                }
                pointer-event(e) => {
                    let track-h = Math.max(1px, vscroll-touch.height);
                    let thumb-h = Math.min(track-h, track-h / Math.max(1.0, root.history-zoom-y));
                    let travel = Math.max(1px, track-h - thumb-h);
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                        // Click anywhere on the track to centre the thumb there, then drag.
                        let target = vscroll-touch.mouse-y - thumb-h * 0.5;
                        root.history-pan-y = Math.max(0.0, Math.min(1.0, target / travel));
                        root.history-scroll-drag-axis = 2;
                        root.history-scroll-drag-start = root.history-pan-y;
                        root.history-scroll-drag-y = vscroll-touch.mouse-y;
                    } else if (e.kind == PointerEventKind.move && root.history-scroll-drag-axis == 2) {
                        let dy = vscroll-touch.mouse-y - root.history-scroll-drag-y;
                        root.history-pan-y = Math.max(0.0, Math.min(1.0, root.history-scroll-drag-start + dy / travel));
                    } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                        if (root.history-scroll-drag-axis == 2) { root.history-scroll-drag-axis = 0; }
                    }
                }
            }

        }
        HorizontalLayout {
            height: 30px; padding-top: 5px; spacing: 5px;
            HorizontalLayout {
                spacing: 0px;
                OptSlider { width: 168px; opt: root.opts[12]; index: 12; mod-target: 13; changed(v) => { root.set-opt(12, v); } }
                scope-gear := Rectangle {
                    width: 25px; height: 25px; border-radius: 4px;
                    background: root.scope-menu-open ? Theme.c2 : (scope-touch.has-hover ? Theme.control-hover : Theme.control);
                    Text { text: "⚙"; color: root.scope-menu-open ? Theme.on-accent : Theme.text; font-size: Type.glyph-small; horizontal-alignment: center; vertical-alignment: center; }
                    scope-touch := TipTouch {
                        hint: "Choose which groups RANDOMIZE may change";
                        clicked => {
                            root.scope-menu-open = !root.scope-menu-open;
                            root.scope-menu-x = scope-gear.absolute-position.x + scope-gear.width - 160px;
                            root.scope-menu-y = scope-gear.absolute-position.y - 118px;
                        }
                        scroll-event(e) => { reject }
                    }
                }
            }
            OptSlider { width: 240px; opt: root.opts[10]; index: 10; mod-target: 12; changed(v) => { root.set-opt(10, v); } }
            // Export lives with the history it exports; Settings keeps only the destination folder.
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: 100px; height: 24px; border-radius: 4px;
                background: export-touch.has-hover ? Theme.c2 : Theme.control;
                Text { text: "EXPORT MIDI"; color: export-touch.has-hover ? Theme.on-accent : Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; }
                export-touch := TipTouch { hint: "Write the current loop to a MIDI file"; clicked => { root.export-midi(); } }
            }
        }
        // Thin status strip: hover descriptions and edit/export feedback live here. Keep the
        // inset and alignment identical to nrum seq so both editors read the same.
        Rectangle {
            height: 20px; border-radius: 3px;
            background: Theme.surface.with-alpha(0.55);
            border-width: 1px; border-color: Theme.border.with-alpha(0.7);
            Text {
                x: 8px; width: parent.width - 16px; height: parent.height;
                text: HoverTip.text != ""
                    ? HoverTip.text
                    : (root.edit-status != ""
                        ? root.edit-status
                        : (root.export-status != ""
                            ? root.export-status
                            : "width = gate · brightness = velocity/accent · outline = slide · tap = hit, drag = gate"));
                color: HoverTip.text != "" ? Theme.text : Theme.text-muted;
                font-size: Type.caption; horizontal-alignment: left; vertical-alignment: center; overflow: elide;
            }
        }
    }

    // Floating badge follows the pointer while an LFO point is being dragged onto a parameter.
    if ModDrag.lfo > 0: Rectangle {
        x: ModDrag.x - 11px; y: ModDrag.y - 11px; width: 22px; height: 22px;
        border-radius: 11px;
        background: ModDrag.lfo == 1 ? Theme.c1 : (ModDrag.lfo == 2 ? Theme.c2 : (ModDrag.lfo == 3 ? Theme.c3 : Theme.hi));
        border-width: 2px; border-color: Theme.on-accent;
        Text { text: "\{ModDrag.lfo}"; color: Theme.on-accent; font-size: Type.caption; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }

    // Mode and Scale dropdowns; a transparent catcher closes the open list on the next click.
    if root.mode-menu-open || root.tuning-open || root.wave-menu-target >= 0 || root.scope-menu-open: Rectangle {
        x: 0px; y: 0px; width: root.base-width; height: root.base-height;
        background: #00000010;
        TouchArea { clicked => { root.mode-menu-open = false; root.tuning-open = false; root.wave-menu-target = -1; root.scope-menu-open = false; } }
    }
    if root.mode-menu-open: ModeDropdown {
        x: root.mode-menu-x; y: root.mode-menu-y;
        width: 460px; height: 420px;
        rows: root.mode-rows; names: root.mode-names; current: root.mode;
        selected(i) => { root.set-mode(i); root.mode-menu-open = false; }
    }
    // The Scale list follows its chip, which lives in the parameter column now.
    if root.tuning-open: DropdownList {
        x: scale-chip.absolute-position.x; y: Math.min(scale-chip.absolute-position.y + scale-chip.height + 2px, root.base-height - 302px);
        width: scale-chip.width; height: 300px;
        options: root.scale-names; current: root.scale-index;
        selected(i) => { root.set-scale(i); root.tuning-open = false; }
    }
    // Collapsed waveform picker popup, shared by the oscillator and all four LFO slots.
    if root.wave-menu-target >= 0: Rectangle {
        x: root.wave-menu-x; y: root.wave-menu-y;
        width: root.wave-menu-target == 0 ? 126px : 92px; height: root.wave-paths.length * 26px + 8px;
        border-radius: 4px; background: Theme.surface;
        border-width: 1px; border-color: Theme.border;
        drop-shadow-blur: 12px; drop-shadow-color: #00000055; drop-shadow-offset-y: 3px;
        VerticalLayout {
            padding: 4px; spacing: 2px;
            for i in root.wave-paths.length: Rectangle {
                height: 24px; border-radius: 3px;
                background: (root.wave-menu-target == 0 && i == root.osc-wave) || (root.wave-menu-target == 1 && i == root.lfo1-wave) || (root.wave-menu-target == 2 && i == root.lfo2-wave) || (root.wave-menu-target == 3 && i == root.lfo3-wave) || (root.wave-menu-target == 4 && i == root.lfo4-wave) ? Theme.c1.with-alpha(0.18) : (row-touch.has-hover ? Theme.control-hover : Theme.control);
                Path {
                    x: 6px; y: 4px;
                    width: root.wave-menu-target == 0 ? 54px : parent.width - 12px;
                    height: parent.height - 8px;
                    viewbox-x: 0; viewbox-y: 0; viewbox-width: 100; viewbox-height: 40;
                    commands: root.wave-paths[i];
                    fill: transparent; stroke: Theme.c1; stroke-width: 1.2px;
                }
                Text { visible: root.wave-menu-target == 0; x: 68px; width: parent.width - 74px; height: parent.height; text: i < root.wave-names.length ? root.wave-names[i] : ""; color: Theme.text; font-size: Type.caption; vertical-alignment: center; overflow: elide; }
                row-touch := TouchArea {
                    clicked => {
                        if (root.wave-menu-target == 0) { root.set-osc-wave(i); }
                        if (root.wave-menu-target == 1) { root.set-lfo-wave(1, i); }
                        if (root.wave-menu-target == 2) { root.set-lfo-wave(2, i); }
                        if (root.wave-menu-target == 3) { root.set-lfo-wave(3, i); }
                        if (root.wave-menu-target == 4) { root.set-lfo-wave(4, i); }
                        root.wave-menu-target = -1;
                    }
                }
            }
        }
    }
    // Randomize scope, anchored to the small gear beside the Randomize-after strip.
    if root.scope-menu-open: Rectangle {
        x: root.scope-menu-x; y: root.scope-menu-y;
        width: 160px; height: 112px;
        border-radius: 4px; background: Theme.surface;
        border-width: 1px; border-color: Theme.border;
        drop-shadow-blur: 12px; drop-shadow-color: #00000055; drop-shadow-offset-y: 3px;
        VerticalLayout {
            padding: 4px; spacing: 3px;
            HorizontalLayout {
                spacing: 3px;
                ScopeChip { width: 72px; label: "MODE"; active: root.scope-mode; toggled => { root.toggle-scope(0); } }
                ScopeChip { width: 72px; label: "LENGTH"; active: root.scope-length; toggled => { root.toggle-scope(1); } }
            }
            HorizontalLayout {
                spacing: 3px;
                ScopeChip { width: 72px; label: "HITS"; active: root.scope-hits; toggled => { root.toggle-scope(2); } }
                ScopeChip { width: 72px; label: "TUNING"; active: root.scope-tuning; toggled => { root.toggle-scope(3); } }
            }
            HorizontalLayout {
                spacing: 3px;
                ScopeChip { width: 72px; label: "PHASE"; active: root.scope-phase; toggled => { root.toggle-scope(5); } }
            }
            HorizontalLayout {
                spacing: 3px;
                ScopeChip { width: 72px; label: "ACID"; active: root.scope-acid; toggled => { root.toggle-scope(6); } }
                ScopeChip { width: 72px; label: "FEEL"; active: root.scope-feel; toggled => { root.toggle-scope(7); } }
            }
        }
    }


    // Parked off-screen when closed so the closing animation can play. Tie the scrim to the
    // animated position, not the boolean, so it cannot swallow clicks while the panel travels out.
    if root.settings-x < root.base-width: Rectangle {
        x: 0px; y: 0px; width: root.base-width; height: root.base-height;
        background: #00000066;
        TouchArea { clicked => { root.settings-open = false; } }
    }
    Rectangle {
        // Parked off-window, so it must leave the tab order and the AT tree entirely; tying
        // visibility to the animated position keeps the slide-out playable.
        visible: root.settings-x < root.base-width;
        x: root.settings-x; y: 0px; width: 300px; height: root.base-height;
        background: Theme.surface; border-width: 1px; border-color: Theme.border;
        drop-shadow-blur: 16px; drop-shadow-color: #00000055; drop-shadow-offset-y: 4px;
        animate x { duration: root.reduce-motion ? 0ms : 140ms; easing: ease-in-out; }
        // The panel can exceed the trimmed window; scroll instead of clipping the support block.
        ScrollView {
            width: parent.width; height: parent.height;
            vertical-scrollbar-policy: as-needed;
            VerticalLayout {
            padding: 12px; spacing: 8px;
            HorizontalLayout {
                height: 24px;
                Text { text: "SETTINGS"; color: Theme.c1; font-size: Type.title; font-weight: 700; vertical-alignment: center; }
                Rectangle { width: 74px; height: 24px; border-radius: 4px; background: close-settings.has-hover ? Theme.hi : Theme.control; Text { text: "CLOSE"; color: close-settings.has-hover ? Theme.on-accent : Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; } close-settings := TipTouch { hint: "Close settings"; clicked => { root.settings-open = false; } } }
            }
            Text { text: "Click a number and type; Enter commits, Esc reverts, the wheel nudges."; color: Theme.text-muted; font-size: Type.value; wrap: word-wrap; }
            Text { text: "COLOUR THEME"; color: Theme.text-muted; font-size: Type.caption; font-weight: 700; letter-spacing: 0.5px; }
            Selector { options: ["Sketch", "Neon", "Lava", "Forest"]; current: root.theme-index; text-size: Type.caption; selected(i) => { root.set-theme(i); } }
            Text { text: "STARTING POINTS"; color: Theme.text-muted; font-size: Type.caption; font-weight: 700; letter-spacing: 0.5px; }
            HorizontalLayout {
                height: 26px; spacing: 4px;
                for i in root.preset-names.length: Rectangle {
                    horizontal-stretch: 1; border-radius: 4px;
                    background: preset-touch.has-hover ? Theme.c2 : Theme.control;
                    Text { width: parent.width; height: parent.height; text: root.preset-names[i]; color: preset-touch.has-hover ? Theme.on-accent : Theme.text; font-size: Type.caption; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                    preset-touch := TipTouch { hint: "Load this starting point into the host parameters"; clicked => { root.apply-preset(i); } }
                }
            }
            Text { text: "Presets write ordinary host parameters, so the result stays automatable."; color: Theme.text-muted; font-size: Type.value; wrap: word-wrap; }
            Text { text: "CONFIG FILE"; color: Theme.text-muted; font-size: Type.caption; font-weight: 700; letter-spacing: 0.5px; }
            Text { text: root.settings-path; color: Theme.text-muted; font-size: Type.value; wrap: word-wrap; }
            Text { text: "VOICES"; color: Theme.text-muted; font-size: Type.caption; font-weight: 700; letter-spacing: 0.5px; }
            NumBox { label: "Voices"; value: root.voices; minimum: 1; maximum: 6; step: 1; changed(v) => { root.set-opt(26, v); } }
            NumBox { label: "Voice spread"; value: root.voice-spread; minimum: 0; maximum: 1; step: 0.01; changed(v) => { root.set-opt(27, v); } }
            Selector { options: ["Shared Loop", "Polymeter"]; current: root.voice-mode; selected(i) => { root.set-opt(28, i); } }
            Selector { options: ["Voice 1", "Voice 2", "Voice 3", "Voice 4", "Voice 5", "Voice 6"]; current: root.voice-preview; selected(i) => { root.set-opt(29, i); } }
            Text {
                text: "Six voices share the loop. Voice 0 is the historic single line; spread separates seed and phase. With NTS on, each voice uses its own MIDI channel for independent pitch bend.";
                color: Theme.text-muted; font-size: Type.value; wrap: word-wrap;
            }
            Text { text: "PATTERN LIMIT"; color: Theme.text-muted; font-size: Type.caption; font-weight: 700; letter-spacing: 0.5px; }
            max-steps-box := NumBox { label: "Max steps"; value: root.max-steps; minimum: 64; maximum: 512; step: 1; mod-target: 22; changed(v) => { root.set-opt(14, v); } }
            // Pattern arrays are allocated for 512 steps up front, so ceiling changes need no restart.
            Text { text: "Max steps applies immediately; no restart is needed."; color: Theme.text-muted; font-size: Type.value; }
            Text { text: "TUNING"; color: Theme.text-muted; font-size: Type.caption; font-weight: 700; letter-spacing: 0.5px; }
            midi-root-box := NumBox { label: "Root MIDI note"; value: root.midi-root; minimum: 0; maximum: 120; step: 1; mod-target: 19; changed(v) => { root.set-opt(20, v); } }
            cents-box := NumBox { label: "Root cents"; value: root.root-cents; minimum: -50; maximum: 50; step: 1; mod-target: 21; changed(v) => { root.set-opt(22, v); } }
            // The synth's full bend range; the plugin also announces it over RPN 0.
            bend-box := NumBox { label: "Bend range (semitones)"; value: root.bend-range; minimum: 1; maximum: 24; step: 1; changed(v) => { root.set-opt(25, v); } }
            Text { text: "Sent as RPN 0 so the receiving synth matches; set the same range by hand if it ignores RPN."; color: Theme.text-muted; font-size: Type.value; wrap: word-wrap; }
            hist-box := NumBox { label: "History Length (Bars)"; value: root.history-bars; minimum: 1; maximum: root.history-max-bars; step: 1; mod-target: 23; changed(v) => { root.set-opt(23, v); } }
            Rectangle {
                height: 26px; border-radius: 4px;
                background: root.history-overlay-on ? Theme.c1 : (overlay-touch.has-hover ? Theme.control-hover : Theme.control);
                Text { x: 8px; width: parent.width - 16px; text: root.history-overlay-on ? "PATTERN OVERLAY: ON" : "PATTERN OVERLAY: OFF"; color: root.history-overlay-on ? Theme.on-accent : Theme.text; font-size: Type.caption; vertical-alignment: center; }
                overlay-touch := TipTouch { hint: "Draw the current loop over the recorded history"; clicked => { root.toggle-history-overlay(); } }
            }
            Text { text: "Outlines the current loop over the recorded history, so a regeneration or a transport jump is visible."; color: Theme.text-muted; font-size: Type.value; wrap: word-wrap; }
            Text { text: "INTERFACE"; color: Theme.text-muted; font-size: Type.caption; font-weight: 700; letter-spacing: 0.5px; }
            Rectangle {
                height: 26px; border-radius: 4px;
                background: root.reduce-motion ? Theme.c1 : (motion-touch.has-hover ? Theme.control-hover : Theme.control);
                Text { x: 8px; width: parent.width - 16px; text: root.reduce-motion ? "REDUCE MOTION: ON" : "REDUCE MOTION: OFF"; color: root.reduce-motion ? Theme.on-accent : Theme.text; font-size: Type.caption; vertical-alignment: center; }
                motion-touch := TipTouch { hint: "Skip panel slides and note tweens"; clicked => { root.toggle-reduce-motion(); } }
            }
            Text { text: "Stops the drawing-panel tweens, the register flash and the panel slides."; color: Theme.text-muted; font-size: Type.value; wrap: word-wrap; }
            Text { text: "TECHNICAL SUPPORT"; color: Theme.text-muted; font-size: Type.caption; font-weight: 700; letter-spacing: 0.5px; }
            Rectangle {
                height: 26px; border-radius: 4px;
                background: root.logging-on ? Theme.c1 : (logging-touch.has-hover ? Theme.control-hover : Theme.control);
                Text { x: 8px; width: parent.width - 16px; text: root.logging-on ? "LOGGING: ON (nelody-seq.log)" : "LOGGING: OFF"; color: root.logging-on ? Theme.on-accent : Theme.text; font-size: Type.caption; vertical-alignment: center; }
                logging-touch := TipTouch { hint: "Write mode and parameter snapshots to nelody-seq.log"; clicked => { root.toggle-logging(); } }
            }
            Text { text: "Writes mode and parameter snapshots to nelody-seq.log in your home folder."; color: Theme.text-muted; font-size: Type.value; wrap: word-wrap; }
            Text { text: "MIDI EXPORT FOLDER"; color: Theme.text-muted; font-size: Type.caption; font-weight: 700; letter-spacing: 0.5px; }
            Rectangle {
                height: 26px; border-radius: 4px;
                background: Theme.control; border-width: 1px; border-color: Theme.border;
                midi-input := TextInput {
                    x: 6px; width: parent.width - 12px; height: parent.height;
                    text: root.midi-folder; color: Theme.text; font-size: Type.caption;
                    vertical-alignment: center;
                    edited => { root.set-midi-folder(self.text); }
                    accepted => { root.set-midi-folder(self.text); }
                }
            }
            // Push the contact block to the bottom of the panel; the controls stay top-aligned.
            Rectangle { vertical-stretch: 1; }
            // Credit rows are flush; this nested layout removes the inter-row spacing.
            VerticalLayout {
                spacing: 0px;
                Text { text: "CREDITS / CONTACT"; color: Theme.text-muted; font-size: Type.caption; font-weight: 700; letter-spacing: 0.5px; }
                Text { text: "\{root.credit-author}  ·  nelody seq"; color: Theme.text; font-size: Type.caption; }
                TextInput { read-only: true; text: root.credit-github; color: Theme.text-muted; font-size: Type.caption; height: 20px; vertical-alignment: center; }
                Text { height: 14px; text: "v\{root.app-version}"; color: Theme.text-muted; font-size: Type.caption; horizontal-alignment: right; vertical-alignment: center; }
            }
            }
        }
    }
    }

    // Linked-LFO tooltip below the hovered parameter; no TouchArea, so it never steals the drag.
    if ModHover.target >= 0 && ModView.view(ModHover.target).linked && !root.matrix-open && ModDrag.lfo == 0: Rectangle {
        x: Math.max(6px, Math.min(ModHover.x, root.base-width - 326px));
        y: Math.min(ModHover.y + 2px, root.base-height - 26px);
        width: 320px; height: 22px;
        border-radius: 4px; background: Theme.surface;
        border-width: 1px; border-color: Theme.c3;
        drop-shadow-blur: 10px; drop-shadow-color: #00000055; drop-shadow-offset-y: 3px;
        Text {
            x: 8px; width: parent.width - 16px; height: parent.height;
            text: ModView.view(ModHover.target).lfo-text;
            color: Theme.text; font-size: Type.caption;
            horizontal-alignment: left; vertical-alignment: center; overflow: elide;
        }
    }
}
